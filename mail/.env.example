# Copy to mail/.env.local for `vercel dev`. NEVER commit .env.local.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Resend API key, "Full access" (contact.ts sends; status.ts reads emails.get; unsubscribe/block
# write the suppression list). Created in the Resend dashboard, shown once.
RESEND_API_KEY=re_xxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO=carlton@carlton.dev

# Sender identity. Must be on a domain verified in Resend.
# Before carlton.dev is verified, use the sandbox: "Carlton.dev <onboarding@resend.dev>"
# (sandbox can only deliver to the Resend account's own address).
CONTACT_FROM="Carlton.dev <contact@carlton.dev>"

# "1" = send the visitor a receipt (needs a verified domain; sandbox can't send to strangers).
AUTOREPLY_ENABLED=1

# Secret for the "This wasn't me" / List-Unsubscribe tokens (HMAC). Any long random string:
#   openssl rand -hex 32
UNSUB_SECRET=

# Public base URL of this deployment; unsubscribe/block links are built on it.
# Custom domain, so the links in the emails share the sender's domain (deliverability).
PUBLIC_BASE_URL=https://api.carlton.dev

# Signing secret shown when you create the webhook endpoint in Resend → Webhooks (whsec_...).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Comma-separated origins allowed to call /api/contact and /api/status (CORS).
ALLOWED_ORIGINS=https://carlton.dev,http://localhost:4321
