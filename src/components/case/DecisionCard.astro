---
/**
 * DecisionCard: one numbered design decision. The ghost numeral sits top right; the heading is
 * the decision in a few words; the slot holds the paragraph(s), styled by the page.
 *
 *   <DecisionCard id="dcD1" area="d1" num={1} slug="ask_the_source" title="Ask the source">
 *     {cs['Ask the source'].map((p) => <p class="cs-p">{p}</p>)}
 *   </DecisionCard>
 */
import Operator from '../Operator.astro';

interface Props {
  id: string;
  area: string;
  num: number;
  /** Operator name after "decision_0N · ". */
  slug: string;
  title: string;
  nudge?: string;
  maxw?: number;
  /** Optional trust-triangle tag: the corner this decision serves. */
  corner?: 'observability' | 'traceability' | 'steerability';
}
const { id, area, num, slug, title, nudge, maxw, corner } = Astro.props;
const n = String(num).padStart(2, '0');
// Triangle points: observability top, traceability bottom left, steerability bottom right.
const dots = [
  ['observability', 6.5, 1.5],
  ['traceability', 1.5, 10.5],
  ['steerability', 11.5, 10.5],
] as const;
---

<Operator id={id} name={`decision_${n} · ${slug}`} type="txt" area={area} nudge={nudge} maxw={maxw}>
  <div class="cs-dec">
    <span class="cs-dnum" aria-hidden="true">{n}</span>
    {corner && (
      <span class="cs-tri">
        <svg viewBox="0 0 13 12" aria-hidden="true">
          <path d="M6.5 1.5 L1.5 10.5 L11.5 10.5 Z" />
          {dots.map(([k, cx, cy]) => <circle cx={cx} cy={cy} r="1.6" class={k === corner ? 'on' : undefined} />)}
        </svg>
        {corner.toUpperCase()}
      </span>
    )}
    <h3 class="cs-dh">{title}</h3>
    <slot />
  </div>
</Operator>
