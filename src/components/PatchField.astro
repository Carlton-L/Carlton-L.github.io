---
/**
 * PatchField — the shared network canvas.
 *
 * Wraps a set of Operators in a spatial patch: dot-grid background,
 * generative dither canvas, bezier cables with signal pulses, and
 * draggable operators. One inline runtime initializes every field
 * on the page (guarded, view-transition safe).
 *
 * DITHER ENGINE v2 (the bg_generator chain, for real):
 *   NOISE   — two-octave value noise drifting over time
 *   FEEDBK  — persistent field buffer; new = noise*(1-fb) + field*fb,
 *             which turns the mouse's heat into phosphor trails
 *   DITHER  — 4×4 Bayer, two-tone: quiet base pixels + bright signal
 *             pixels where the field runs hot (e.g. under the cursor)
 *   OUT     — palette select (green / amber / cyan / mono)
 *
 * TD-style params: any <input data-param="density|speed|scale|feedback">
 * inside the field cooks instantly; a <button data-cycle="palette">
 * cycles palettes; readouts go to [data-out="..."]; inputs may carry
 * data-stage="noise|feedbk|dither|out" to flash the matching
 * [data-chip="..."] chain chip when touched.
 *
 * READ mode (body.perform): operators stack in DOM order; wires hide;
 * the dither keeps cooking as a fixed, quieter backdrop so the
 * bg_generator controls still mean something.
 *
 * DUO dock: two elements marked data-duo="<pairId>" (+ data-duo-name for
 * the chip label) are a pair of surfaces that want co-visibility (e.g.
 * GRID's controller + 3D studio). IO-driven, no breakpoints: whenever one
 * surface's home region is on screen and the other's isn't, the other is
 * re-parented into a fixed corner dock (scaled live preview, tap/Enter to
 * swap — smooth-scrolls its home back into view and the IO settles the
 * rest). Home parents keep a min-height reservation so nothing jumps.
 * Emits `patch:duo` CustomEvents ({el, docked}) so demos can adapt
 * (e.g. drop pixel ratio while docked). One dock per field; first pair
 * wins if several fight over it.
 *
 * LAYOUT RESOLVER (opt-in via the `layout` prop): places ops that carry an
 * `area` prop from an ASCII grid-areas string, snapped to the dot grid.
 *   layout = {
 *     mode: 'fill' | 'content',  // fill: rows share the field height (hero pages)
 *                                // content: rows measure their tallest op, field
 *                                //          height is computed (long pages)
 *     padTop: 0,                 // extra px above row 0
 *     jitter: false,             // seeded half-grid scatter per op (opt-in)
 *     tiers: [                   // ascending `min` (field width px); last match wins
 *       { min: 0, cols: 12, areas: `
 *           hero hero .    view view
 *           .    .    .    view view
 *       ` },
 *     ],
 *   }
 * Rules: resolver only touches `.op[data-area]`; `pos` ops are never touched;
 * dragged ops (data-manual) and DUO-docked ops are left alone; overlaps get
 * relaxed down-column; every tier should name every area op (missing ones keep
 * their previous position). Re-resolves on resize / patchmode / (content mode)
 * op size changes — late-hydrating islands are safe.
 *
 * PATCH RUNTIME (P1): PatchField inlines `src/lib/patch-runtime.js` and
 * registers each field as a runtime scope (`Patch.field(id)`), feeding it the
 * links array. Links may carry ports — ['opIndex:selection', 'opFx'] — which
 * makes the cable a real subscription: node registrations (page scripts)
 * emit/receive along them, and every routed delivery pushes a one-shot pulse
 * that cookWires renders as a traveling dot on the correct cable. Old
 * two-string links stay valid and purely visual. `?nopatch=1` skips the
 * runtime (visual-only cables). Field-level timers/listeners/observers ride
 * a housekeeping node so `astro:before-swap` tears everything down.
 *
 * Props:
 *  - id:      DOM id (required, unique per field)
 *  - links:   [[fromOpId, toOpId], ...] — cables, drawn out-port → in-port;
 *             ends may carry ports ('opId:channel') for runtime routing
 *  - density: initial dither density 0–1 (0 disables the dither canvas)
 *  - height:  'viewport' (fill viewport minus chrome) | CSS min-height value
 *             (content-mode layouts recompute this at runtime; the prop is the
 *             pre-JS fallback)
 *  - label:   aria-label for the region
 *  - layout:  optional layout-resolver config (see above)
 */
interface Props {
  id: string;
  links?: [string, string][];
  density?: number;
  height?: string;
  label?: string;
  layout?: {
    mode?: 'fill' | 'content';
    padTop?: number;
    jitter?: boolean;
    tiers: { min?: number; cols?: number; areas: string }[];
  };
}
import patchRuntime from '../lib/patch-runtime.js?raw';
const { id, links = [], density = 0.5, height = 'viewport', label = 'Interactive patch — press P for read view', layout } = Astro.props;
// The runtime is inlined verbatim (is:inline skips the bundler), so prod
// strips comments, indentation, and //<dev …//>dev blocks (the runtime's
// dev-only warnings/cycle-check — zero cost in prod). ⚠️ Keep
// patch-runtime.js free of `//` and `/*` inside string/regex literals or
// this strip will corrupt it. DEV keeps everything + flips the DEV const.
const stripJs = (s) =>
  s
    .replace(/\/\/<dev[\s\S]*?\/\/>dev/g, '')
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/(^|[^:'"\\])\/\/[^\n]*/g, '$1')
    .split('\n').map((l) => l.trim()).filter(Boolean).join('\n');
const runtimeJs = import.meta.env.DEV
  ? patchRuntime.replace('var DEV = false; // @dev', 'var DEV = true; // @dev')
  : stripJs(patchRuntime);
// Fill the content area (viewport minus the fixed nav + footer/playbar). For
// fixed-height fields (case studies, contact) still grow to at least fill, so
// short pages don't leave a bare strip below the dither.
const fillH = 'calc(100vh - var(--nav-height) - var(--playbar-height))';
const heightStyle =
  height === 'viewport'
    ? `height: ${fillH}; min-height: 640px;`
    : `min-height: max(${height}, ${fillH});`;
---

<section
  class="patchfield"
  id={id}
  aria-label={label}
  data-links={JSON.stringify(links)}
  data-density={String(density)}
  data-layout={layout ? JSON.stringify(layout) : undefined}
  style={heightStyle}
>
  {density > 0 && <canvas class="bgdither" aria-hidden="true"></canvas>}
  <svg class="wires" aria-hidden="true"></svg>
  <slot />
</section>

<style>
  .patchfield {
    position: relative;
    overflow: hidden;
    cursor: crosshair;
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  /* One viewport-fixed dither field (both modes). Cell size then depends only
     on the viewport, not on how tall a page's patch is — so the dither looks
     the same on a short page and a long case study — and it always fills. */
  /* width/height:100% of the fixed viewport (NOT 100vw/100vh) so the canvas
     never overhangs the scrollbar and forces a horizontal scroll — that
     overflow was clipping the navbar/footer right edge. */
  .bgdither { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0.75; pointer-events: none; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }

  /* READ mode: the network becomes a document; the dither drops behind
     everything as a fixed, quieter backdrop (params still live) */
  :global(body.perform) .patchfield {
    height: auto !important;
    min-height: 0 !important;
    cursor: default;
    background-image: none;
    padding: calc(var(--nav-height) + 40px) 20px 64px;
    /* centers the inline-block SYS control strip; ops reset to left */
    text-align: center;
  }
  :global(body.perform) .patchfield :global(.op) { text-align: left; transition: opacity 0.35s; }
  :global(body.perform) .bgdither {
    z-index: -1;
    opacity: 0.28;
    transition: opacity 0.35s;
  }
  /* audition: a bg control is being touched — the field comes forward so the
     change is legible under the finger; content steps back for a beat
     (body class set by the engine, auto-clears ~1.2s after last input) */
  :global(body.perform.bg-audition) .bgdither { opacity: 0.65; }
  :global(body.perform.bg-audition) .patchfield :global(.op:not(.op-sys)) { opacity: 0.25; }
</style>

<!-- resolver-managed ops stay invisible until first placement (no flash at 0,0);
     scoped to JS-on patch mode: READ mode and noscript never hide anything -->
<noscript>
  <style>
    /* no JS = no resolver, no drag, no wires: fall back to READ-style stacking */
    .patchfield { height: auto !important; min-height: 0 !important; padding: 80px 20px 64px; }
    .patchfield .op { position: static !important; width: 100% !important; max-width: 680px; margin: 0 auto 40px; visibility: visible !important; }
  </style>
</noscript>

<!-- DUO dock — JS-created, so it can't take Astro's scoped attributes -->
<style is:global>
  body:not(.perform) .patchfield .op[data-area]:not([data-placed]) { visibility: hidden; }

  .pfdock {
    position: fixed;
    right: 14px;
    bottom: calc(var(--playbar-height) + 14px);
    z-index: 80; /* above ops (≤25), under the nav (90) */
    background: var(--bg-elevated);
    border: 1px solid rgba(61, 255, 136, 0.45); /* clickable = signal border (.chipbtn grammar) */
    border-radius: var(--radius-md);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
    padding: 6px;
    cursor: pointer;
    text-align: left;
    touch-action: none; /* drag-to-corner: the dock owns its touch gestures */
    transition: box-shadow var(--duration-fast), background var(--duration-fast);
  }
  .pfdock:hover,
  .pfdock:focus-visible { background: rgba(61, 255, 136, 0.06); box-shadow: 0 0 12px rgba(61, 255, 136, 0.18), 0 18px 50px rgba(0, 0, 0, 0.6); }
  .pfdock:focus-visible { outline: 1px solid var(--signal); outline-offset: 2px; }
  .pfdock-body { overflow: hidden; pointer-events: none; border-radius: 4px; }
  /* docked surfaces may carry home-layout margins (e.g. flush-bleed wrappers) */
  .pfdock-body > * { margin: 0 !important; }
  .pfdock-chip {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--signal);
    text-align: center;
  }
</style>

<!-- the patch runtime: singleton guard inside; must precede every field/node
     registration script in DOM order (it does — PatchField renders before
     page scripts; data-astro-rerun keeps that true after ClientRouter swaps) -->
<script is:inline data-astro-rerun set:html={runtimeJs}></script>

<script is:inline data-astro-rerun>
(function () {
  document.querySelectorAll('.patchfield').forEach((host) => {
    if (host.dataset.pfInit) return;
    host.dataset.pfInit = '1';

    const cv = host.querySelector('canvas.bgdither');
    const svg = host.querySelector('svg.wires');
    const RAWLINKS = JSON.parse(host.dataset.links || '[]');
    // drawn ends = ports stripped; routing keeps the ported form
    const LINKS = RAWLINKS.map((l) => [String(l[0]).split(':')[0], String(l[1]).split(':')[0]]);
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    const isRead = () => document.body.classList.contains('perform');

    /* ---------- patch runtime: field scope + lifecycle ----------
       `net` is this field's runtime scope (stub under ?nopatch=1 → LIVE
       false, everything below falls back to today's direct paths). The
       housekeeping node carries every field-level timer/listener/observer,
       so astro:before-swap tears them all down — no leaks across swaps. */
    const net = window.Patch ? window.Patch.field(host.id) : null;
    const LIVE = !!(net && !net.stub);
    if (LIVE) net.links(RAWLINKS);
    const sys = LIVE ? net.node('__' + host.id, {}) : null;
    const on = (el, ev, fn, opts) => (sys ? sys.listen(el, ev, fn, opts) : el.addEventListener(ev, fn, opts));

    /* ---------- TD-style parameters ---------- */
    const PALETTES = [
      { n: 'GRN', base: '#233b2c', hot: '#3dff88' },
      { n: 'AMB', base: '#3a2c14', hot: '#e8a317' },
      { n: 'CYN', base: '#15303d', hot: '#56b4e9' },
      { n: 'MONO', base: '#26262a', hot: '#9f9f98' },
    ];
    /* defaults (Carlton's picks, 2026-07-02) — overridden by any values
       the visitor tweaked earlier (persisted across pages/visits) */
    const P = {
      density: parseFloat(host.dataset.density || '0.77'),
      speed: 1,
      scale: 3,
      feedback: 0.78,
      pal: 0,
      noiseT: 1,   // RIDGE
      ditherT: 1,  // BAYER2
      wander: 1,   // ghost painter — only consulted on coarse pointers (AUTO chip)
    };
    const STORE = 'patch-bg';
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(STORE) || '{}') || {}; } catch (e) {}
    Object.keys(P).forEach((k) => { if (typeof saved[k] === 'number' && isFinite(saved[k])) P[k] = saved[k]; });
    function persist() {
      try { localStorage.setItem(STORE, JSON.stringify(P)); } catch (e) {}
    }

    /* param intake rides the bus: inputs emit on `param:<k>` channels, the
       engine's P is a subscriber. NOTE: persistence stays the full-P persist()
       write (NOT per-key channel persist) so the visitor-facing `patch-bg`
       format is byte-identical to before. Delivery is synchronous — behavior
       is unchanged; under ?nopatch=1 the direct fallback assigns P[k]. */
    host.querySelectorAll('[data-param]').forEach((inp) => {
      const k = inp.dataset.param;
      const div = parseFloat(inp.dataset.div || '1');
      const out = host.querySelector(`[data-out="${k}"]`);
      const ch = LIVE ? net.channel('param:' + k) : null;
      if (ch) ch.on((v) => { P[k] = v; });
      // reflect current (possibly persisted) value in the control
      inp.value = String(P[k] * div);
      const upd = (save) => {
        const v = parseFloat(inp.value) / div;
        if (ch) ch.emit(v); else P[k] = v;
        if (out) out.textContent = div === 1 ? String(P[k]) : P[k].toFixed(2);
        // track fill up to the thumb (consumed by .prange CSS)
        const mn = parseFloat(inp.min || '0'), mx = parseFloat(inp.max || '100');
        inp.style.setProperty('--p', (((parseFloat(inp.value) - mn) / (mx - mn)) * 100).toFixed(1) + '%');
        if (save) persist();
      };
      inp.addEventListener('input', () => upd(true));
      upd(false);
    });
    /* type cyclers — <button data-cycle="palette|noise|dither" data-prefix="..."> */
    const CYC = {
      palette: { key: 'pal', opts: PALETTES.map((p) => p.n) },
      noise: { key: 'noiseT', opts: ['FBM', 'RIDGE', 'PLASMA'] },
      dither: { key: 'ditherT', opts: ['BAYER4', 'BAYER2', 'SCAN', 'STATIC'] },
      wander: { key: 'wander', opts: ['OFF', 'ON'] },
    };
    // Re-theme the whole UI accent (--signal) to the active OUT palette, so the
    // color chooser recolors links, cables, nav highlights, etc. site-wide.
    function applySignal() {
      const p = PALETTES[((P.pal % PALETTES.length) + PALETTES.length) % PALETTES.length];
      const r = document.documentElement.style;
      r.setProperty('--signal', p.hot);
      r.setProperty('--signal-dim', p.hot + '47');
      r.setProperty('--border-hover', p.hot + '66');
    }
    host.querySelectorAll('[data-cycle]').forEach((btn) => {
      const c = CYC[btn.dataset.cycle];
      if (!c) return;
      const ch = LIVE ? net.channel('param:' + c.key) : null;
      if (ch) ch.on((v) => { P[c.key] = v; });
      const pre = btn.dataset.prefix || btn.dataset.cycle.toUpperCase();
      const label = () => {
        P[c.key] = ((P[c.key] | 0) % c.opts.length + c.opts.length) % c.opts.length;
        btn.textContent = `${pre} ▸ ${c.opts[P[c.key]]}`;
      };
      btn.addEventListener('click', () => {
        const v = (P[c.key] + 1) % c.opts.length;
        if (ch) ch.emit(v); else P[c.key] = v;
        label(); persist();
        if (btn.dataset.cycle === 'palette') applySignal();
      });
      label();
    });
    applySignal();

    /* audition (READ mode): while a bg control is being touched the field
       comes forward for a beat so the change is visible under the finger.
       CSS does the fade (body.bg-audition rules in this component). */
    let audT = null;
    const audition = () => {
      if (!isRead()) return;
      document.body.classList.add('bg-audition');
      clearTimeout(audT);
      audT = setTimeout(() => document.body.classList.remove('bg-audition'), 1200);
    };
    host.querySelectorAll('[data-param], [data-cycle]').forEach((el) => {
      ['pointerdown', 'input', 'click'].forEach((ev) => el.addEventListener(ev, audition));
    });
    if (sys) sys.cleanup(() => { clearTimeout(audT); document.body.classList.remove('bg-audition'); });

    /* ---------- layout resolver (opt-in: host carries data-layout) ----------
       ASCII grid-areas → absolute positions snapped to the dot grid.
       See the component doc comment for the config shape and rules. */
    (function () {
      let LAYOUT = null;
      try { LAYOUT = JSON.parse(host.dataset.layout || 'null'); } catch (e) {}
      if (!LAYOUT || !Array.isArray(LAYOUT.tiers) || !LAYOUT.tiers.length) return;

      const guRaw = parseFloat(getComputedStyle(host).getPropertyValue('--grid-size'));
      const GU = isFinite(guRaw) && guRaw > 0 ? guRaw : 24;
      const snap = (v) => Math.round(v / GU) * GU;
      const jitterFor = (id) => {
        let h = 2166136261;
        for (let i = 0; i < id.length; i++) { h ^= id.charCodeAt(i); h = Math.imul(h, 16777619); }
        const u = (b) => Math.round((((h >>> b) & 255) / 255 - 0.5) * 2) * (GU / 2);
        return [u(8), u(16)];
      };
      const parseAreas = (str) => {
        const rows = String(str).trim().split('\n')
          .map((l) => l.trim().split(/\s+/))
          .filter((r) => r.length && r[0]);
        const cells = {};
        rows.forEach((row, r) => row.forEach((n, c) => {
          if (n === '.') return;
          const a = cells[n] || (cells[n] = { c0: c, c1: c, r0: r, r1: r });
          if (c < a.c0) a.c0 = c; if (c > a.c1) a.c1 = c;
          if (r < a.r0) a.r0 = r; if (r > a.r1) a.r1 = r;
        }));
        return { nrows: rows.length, cells };
      };

      let lastSig = '';
      function relayout() {
        if (isRead()) return;
        const W = host.clientWidth;
        if (W < 2) return;
        let tier = LAYOUT.tiers[0];
        for (const t of LAYOUT.tiers) if (W >= (t.min || 0)) tier = t;
        const { nrows, cells } = parseAreas(tier.areas);
        const cols = tier.cols || 12;
        const PAD = GU, padTop = LAYOUT.padTop || 0;
        const colW = (W - 2 * PAD) / cols;

        // ops this pass may move: skip dragged (data-manual), display:none, and
        // anything re-parented out of the field (e.g. into the DUO dock)
        const areaEls = {};
        host.querySelectorAll('.op[data-area]').forEach((el) => {
          el.setAttribute('data-placed', '1'); // never leave an op invisible
          if (el.hasAttribute('data-manual') || el.offsetParent !== host) return;
          areaEls[el.dataset.area] = el;
        });

        // 1. widths first (content mode measures heights against final widths)
        Object.keys(areaEls).forEach((name) => {
          const a = cells[name], el = areaEls[name];
          if (!a || el.dataset.fit === 'auto') { if (el) el.__cx = 0; return; }
          let w = (a.c1 - a.c0 + 1) * colW - GU / 2, cx = 0;
          const mw = parseFloat(el.dataset.maxw);
          if (isFinite(mw) && mw < w) { cx = (w - mw) / 2; w = mw; }
          el.style.width = Math.max(GU, snap(w)) + 'px';
          el.__cx = cx;
        });

        // 2. row tops
        const rowTops = [];
        if (LAYOUT.mode === 'content') {
          const rh = new Array(nrows).fill(GU);
          Object.keys(areaEls).forEach((name) => {
            const a = cells[name]; if (!a) return;
            const per = areaEls[name].offsetHeight / (a.r1 - a.r0 + 1);
            for (let r = a.r0; r <= a.r1; r++) if (per > rh[r]) rh[r] = per;
          });
          let acc = PAD + padTop;
          for (let r = 0; r < nrows; r++) { rowTops[r] = acc; acc += rh[r] + GU; }
        } else {
          const H = Math.max(host.clientHeight, 640);
          const rowH = (H - 2 * PAD - padTop) / nrows;
          for (let r = 0; r < nrows; r++) rowTops[r] = PAD + padTop + r * rowH;
        }

        // 3. place (ops missing from this tier keep their previous position)
        Object.keys(areaEls).forEach((name) => {
          const a = cells[name]; if (!a) return;
          const el = areaEls[name];
          const nd = (el.dataset.nudge || '').trim().split(/\s+/).map(parseFloat);
          const jit = LAYOUT.jitter ? jitterFor(name) : [0, 0];
          const x = PAD + a.c0 * colW + (el.__cx || 0) + (nd[0] || 0) + jit[0];
          const y = rowTops[a.r0] + (nd[1] || 0) + jit[1];
          el.style.left = snap(Math.max(0, x)) + 'px';
          el.style.top = snap(Math.max(0, y)) + 'px';
          el.style.right = 'auto'; el.style.bottom = 'auto'; el.style.transform = 'none';
        });

        // 4. relax: push real overlaps down their column (bounded passes)
        const els = Object.keys(areaEls).filter((n) => cells[n]).map((n) => areaEls[n]);
        for (let pass = 0; pass < 3; pass++) {
          let moved = false;
          const sorted = els.slice().sort((a, b) => a.offsetTop - b.offsetTop);
          for (let i = 0; i < sorted.length; i++) {
            for (let j = i + 1; j < sorted.length; j++) {
              const A = sorted[i], B = sorted[j];
              const ox = Math.min(A.offsetLeft + A.offsetWidth, B.offsetLeft + B.offsetWidth) - Math.max(A.offsetLeft, B.offsetLeft);
              const oy = Math.min(A.offsetTop + A.offsetHeight, B.offsetTop + B.offsetHeight) - Math.max(A.offsetTop, B.offsetTop);
              if (ox > GU / 2 && oy > 0) {
                B.style.top = snap(A.offsetTop + A.offsetHeight + GU) + 'px';
                moved = true;
              }
            }
          }
          if (!moved) break;
        }

        // 5. field height: content mode computes it; fill mode only grows if relax overflowed
        let maxY = 0;
        els.forEach((el) => { const b = el.offsetTop + el.offsetHeight; if (b > maxY) maxY = b; });
        if (LAYOUT.mode === 'content') {
          host.style.height = 'auto';
          host.style.minHeight = Math.max(640, maxY + 2 * GU) + 'px';
        } else if (maxY + GU > host.clientHeight) {
          host.style.minHeight = (maxY + 2 * GU) + 'px';
        }
        lastSig = Array.from(host.querySelectorAll('.op[data-area]')).map((el) => el.offsetHeight).join(',');
      }

      let rlT = null;
      const debRelayout = (ms) => { clearTimeout(rlT); rlT = setTimeout(relayout, ms); };
      on(window, 'resize', () => debRelayout(80));
      on(document, 'patchmode', () => debRelayout(60));
      if (sys) sys.cleanup(() => clearTimeout(rlT));
      if (LAYOUT.mode === 'content' && typeof ResizeObserver !== 'undefined') {
        // late-hydrating islands change op heights → re-relax (signature-guarded, no loops)
        const ro = new ResizeObserver(() => {
          const sig = Array.from(host.querySelectorAll('.op[data-area]')).map((el) => el.offsetHeight).join(',');
          if (sig !== lastSig) debRelayout(120);
        });
        host.querySelectorAll('.op[data-area]').forEach((el) => ro.observe(el));
        if (sys) sys.cleanup(() => ro.disconnect());
      }
      relayout();
    })();

    /* ---------- dither engine v2.1 ----------
       Perf model: cook the field at 1px/cell into an offscreen ImageData,
       blit once with nearest-neighbor scaling, then punch the cell gutters
       out with a destination-out grid pattern. ~2 canvas ops per cook
       instead of tens of thousands of fillRects; cooks at 30fps. */
    const B = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
    const hex2rgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    PALETTES.forEach((p) => { p.baseRGB = hex2rgb(p.base); p.hotRGB = hex2rgb(p.hot); });
    let W = 0, H = 0, ctx = null, t = 0;
    let FW = 0, FH = 0, FS = 4, FSbase = 0, field = null;
    let oc = null, octx = null, img = null, gridPat = null;

    // value noise (seeded permutation)
    const perm = new Uint8Array(512);
    (function () {
      const p = Array.from({ length: 256 }, (_, i) => i);
      let sd = 1337;
      const r = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
      for (let i = 255; i > 0; i--) { const j = (r() * (i + 1)) | 0; const tmp = p[i]; p[i] = p[j]; p[j] = tmp; }
      for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
    })();
    const fade = (x) => x * x * (3 - 2 * x);
    function vn(x, y) {
      const xi = Math.floor(x), yi = Math.floor(y);
      const xf = x - xi, yf = y - yi;
      const X = xi & 255, Y = yi & 255;
      const a = perm[perm[X] + Y] / 255, b = perm[perm[X + 1] + Y] / 255;
      const c = perm[perm[X] + Y + 1] / 255, d = perm[perm[X + 1] + Y + 1] / 255;
      const u = fade(xf), v = fade(yf);
      const l1 = a + (b - a) * u, l2 = c + (d - c) * u;
      return l1 + (l2 - l1) * v;
    }

    function size() {
      if (!cv) return;
      // Always cook a viewport-sized field (canvas is position:fixed) so the
      // dither cell size is consistent regardless of the patch's total height.
      // clientWidth/Height exclude the scrollbar → match the inset:0 CSS box.
      const de = document.documentElement;
      W = cv.width = de.clientWidth || window.innerWidth;
      H = cv.height = de.clientHeight || window.innerHeight;
      allocField();
    }
    function allocField() {
      FSbase = Math.max(2, Math.round(P.scale));
      let s = FSbase;
      while (Math.ceil(W / s) * Math.ceil(H / s) > 140000) s++; // perf cap
      FS = s;
      FW = Math.max(1, Math.ceil(W / s)); FH = Math.max(1, Math.ceil(H / s));
      field = new Float32Array(FW * FH);
      // offscreen cell buffer
      oc = document.createElement('canvas');
      oc.width = FW; oc.height = FH;
      octx = oc.getContext('2d');
      img = octx.createImageData(FW, FH);
      // gutter pattern (1px cell gaps, erased via destination-out)
      const gp = document.createElement('canvas');
      gp.width = s; gp.height = s;
      const g = gp.getContext('2d');
      g.fillStyle = '#000';
      g.fillRect(s - 1, 0, 1, s);
      g.fillRect(0, s - 1, s, 1);
      gridPat = ctx ? ctx.createPattern(gp, 'repeat') : null;
    }
    if (cv) {
      ctx = cv.getContext('2d');
      const szRo = new ResizeObserver(size);
      szRo.observe(host);
      if (sys) sys.cleanup(() => szRo.disconnect());
      on(window, 'resize', size);
      on(document, 'patchmode', () => setTimeout(size, 50));
      size();
    }

    /* heat intake — desktop: velocity-driven cursor heat (a parked cursor
       cools down); touch: taps burst, scroll rides the blob. Every real
       input stamps lastReal, which gates the ghost painter below. */
    let mcx = -1e4, mcy = -1e4, energy = 0, lmx = 0, lmy = 0, lastReal = -1e4;
    on(window, 'pointermove', (e) => {
      energy = Math.min(70, energy + Math.hypot(e.clientX - lmx, e.clientY - lmy) * 0.6);
      lmx = e.clientX; lmy = e.clientY;
      mcx = e.clientX; mcy = e.clientY;
      lastReal = performance.now();
    }, { passive: true });
    on(window, 'pointerdown', (e) => {
      energy = Math.min(70, energy + 45); // tap = burst (the mobile "hover")
      lmx = mcx = e.clientX; lmy = mcy = e.clientY;
      lastReal = performance.now();
    }, { passive: true });
    let lastSc = window.scrollY || 0;
    on(window, 'scroll', () => {
      const y = window.scrollY || 0, d = y - lastSc;
      lastSc = y;
      if (!COARSE || !d) return;
      if (mcx < 0) { mcx = W * 0.5; mcy = H * 0.55; } // no touch yet → seed mid-screen
      mcy = Math.min(H - 40, Math.max(40, mcy - d * 0.4)); // blob rides the scroll
      energy = Math.min(70, energy + Math.min(18, Math.abs(d) * 0.25));
      lastReal = performance.now();
    }, { passive: true });

    function cookDither() {
      if (!ctx || P.density <= 0 || !field) return;
      if (Math.max(2, Math.round(P.scale)) !== FSbase) allocField();
      if (!REDUCED) t += 0.008 * P.speed; // cooks at half frame-rate
      energy *= 0.74;
      /* ghost painter — coarse pointers only: after 1s without real input the
         field paints itself (lissajous drift + noise wander; pace follows
         SPEED via t). Any real touch wins instantly; AUTO chip toggles it. */
      if (COARSE && !REDUCED && (P.wander | 0) && performance.now() - lastReal > 1000) {
        const gt = t * 6;
        mcx = W * (0.5 + 0.36 * Math.sin(gt) + 0.12 * (vn(gt * 0.7, 3.1) - 0.5));
        mcy = H * (0.5 + 0.36 * Math.sin(gt * 0.618 + 1.7) + 0.12 * (vn(7.7, gt * 0.53) - 0.5));
        energy = Math.min(70, energy + 6);
      }

      // mouse position in field space (canvas is viewport-fixed → screen coords)
      let mx = -1e4, my = -1e4;
      if (!REDUCED) { mx = mcx; my = mcy; }
      const heatR2 = 2 * 90 * 90;
      const heatA = Math.min(1.5, energy * 0.03);
      const fb = Math.min(0.95, Math.max(0, P.feedback));
      const s = FS, f1 = 0.012 * s, f2 = 0.027 * s;
      const pal = PALETTES[P.pal];
      const [br, bg2, bb] = pal.baseRGB, [hr, hg, hb] = pal.hotRGB;
      const nt = P.noiseT | 0, dt = P.ditherT | 0;
      const B2 = [[0, 2], [3, 1]];
      const data = img.data;

      for (let gy = 0; gy < FH; gy++) {
        const py = gy * s;
        for (let gx = 0; gx < FW; gx++) {
          const px = gx * s;
          // NOISE (type-switched)
          let n;
          if (nt === 2) {
            // PLASMA: sine interference
            n = 0.5 + (Math.sin(px * 0.018 + t * 1.2) + Math.sin(py * 0.023 - t * 0.8) + Math.sin((px + py) * 0.011 + t * 0.5)) / 6;
            n = Math.max(0, (n - 0.35) * 1.6);
          } else {
            let n1 = vn(gx * f1 + t * 0.55, gy * f1 + t * 0.18);
            let n2 = vn(gx * f2 - t * 0.35 + 40.7, gy * f2 + 11.3);
            if (nt === 1) {
              // RIDGE: folded veins
              n1 = 1 - Math.abs(2 * n1 - 1); n2 = 1 - Math.abs(2 * n2 - 1);
              n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.45) * 1.7);
            } else {
              // FBM
              n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.32) * 1.55);
            }
          }
          // mouse heat
          const dx = px - mx, dy = py - my;
          if (heatA > 0.02 && dx > -260 && dx < 260 && dy > -260 && dy < 260) {
            n += heatA * Math.exp(-(dx * dx + dy * dy) / heatR2);
          }
          // FEEDBK
          const i = gy * FW + gx;
          const v = (field[i] = n * (1 - fb) + field[i] * fb);
          // DITHER (type-switched threshold), two-tone output → ImageData
          const L = v * P.density * 1.2;
          let th;
          if (dt === 1) th = (B2[gy & 1][gx & 1] + 0.5) / 4;
          else if (dt === 2) th = ((gy & 3) + 0.5) / 4.4; // SCAN lines
          else if (dt === 3) { const h = ((gx * 73856093) ^ (gy * 19349663)) >>> 0; th = ((h >>> 8) & 1023) / 1024; } // STATIC
          else th = (B[gy & 3][gx & 3] + 0.5) / 16; // BAYER4
          const o = i * 4;
          if (L > th) {
            const hot = L - 0.55 > th;
            data[o] = hot ? hr : br;
            data[o + 1] = hot ? hg : bg2;
            data[o + 2] = hot ? hb : bb;
            data[o + 3] = 255;
          } else {
            data[o + 3] = 0;
          }
        }
      }
      // blit: cells → screen, then punch out the gutters
      octx.putImageData(img, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(oc, 0, 0, FW, FH, 0, 0, FW * s, FH * s);
      if (gridPat && s > 2) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.fillStyle = gridPat;
        ctx.fillRect(0, 0, W, H);
        ctx.globalCompositeOperation = 'source-over';
      }
    }

    /* ---------- wires ---------- */
    function portPos(el, side) {
      const r = el.getBoundingClientRect(), h = host.getBoundingClientRect();
      return { x: (side === 'out' ? r.right : r.left) - h.left, y: r.top + r.height / 2 - h.top };
    }
    let phase = 0;
    function cookWires() {
      if (!svg || isRead()) { if (svg && isRead()) svg.innerHTML = ''; return; }
      if (!REDUCED) phase += 0.008;
      const sig = PALETTES[((P.pal % PALETTES.length) + PALETTES.length) % PALETTES.length].hot;
      let o = '';
      const geo = []; // per drawn cable: endpoints for the routed-delivery pulses
      for (let i = 0; i < LINKS.length; i++) {
        const a = document.getElementById(LINKS[i][0]), b = document.getElementById(LINKS[i][1]);
        if (!a || !b) continue;
        const A = portPos(a, 'out'), Bp = portPos(b, 'in');
        const dx = Math.max(60, Math.abs(Bp.x - A.x) * 0.5);
        geo.push({ f: LINKS[i][0], t: LINKS[i][1], A, Bp, dx });
        const d = `M ${A.x} ${A.y} C ${A.x + dx} ${A.y}, ${Bp.x - dx} ${Bp.y}, ${Bp.x} ${Bp.y}`;
        o += `<path d="${d}" fill="none" stroke="${sig}" stroke-opacity=".28" stroke-width="1.4"/>`;
        if (!REDUCED) {
          const tt = (phase + i * 0.22) % 1;
          const len = Math.hypot(Bp.x - A.x, Bp.y - A.y) + 2 * dx;
          o += `<path d="${d}" fill="none" stroke="${sig}" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="10 2000" stroke-dashoffset="${-(tt * len)}" opacity=".9"/>`;
        }
      }
      /* transient pulses (visual = truth): every routed delivery queued a
         one-shot dot that travels its cable in ~300ms. Reduced motion: skipped
         (ambient drift is already static there). */
      if (net && !REDUCED && net.pulses.length) {
        const now = performance.now(), q = net.pulses;
        for (let i = q.length - 1; i >= 0; i--) {
          const p = (now - q[i].t0) / 300;
          if (p >= 1) { q.splice(i, 1); continue; }
          const g = geo.find((x) => x.f === q[i].f && x.t === q[i].t);
          if (!g) continue;
          const u = 1 - p, c1x = g.A.x + g.dx, c2x = g.Bp.x - g.dx;
          const x = u * u * u * g.A.x + 3 * u * u * p * c1x + 3 * u * p * p * c2x + p * p * p * g.Bp.x;
          const y = u * u * u * g.A.y + 3 * u * u * p * g.A.y + 3 * u * p * p * g.Bp.y + p * p * p * g.Bp.y;
          o += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3" fill="${sig}" opacity="${(1 - p * 0.45).toFixed(2)}"/>`;
        }
      }
      svg.innerHTML = o;
    }

    /* ---------- main loop (dither cooks at half rate) ---------- */
    let fc = 0;
    function frame() {
      if (!host.isConnected) return;
      if ((fc++ & 1) === 0) cookDither();
      cookWires();
      requestAnimationFrame(frame);
    }
    if (REDUCED) {
      // static single cook; params still recook on change
      const still = () => { cookDither(); cookWires(); };
      host.addEventListener('input', () => setTimeout(still, 0));
      host.addEventListener('click', () => setTimeout(still, 0));
      on(document, 'patchmode', () => setTimeout(still, 80));
      still();
    } else {
      frame();
    }

    /* ---------- draggable operators ---------- */
    host.querySelectorAll('.op').forEach((op) => {
      const bar = op.querySelector('.ohead');
      if (!bar) return;
      let sx, sy, ox, oy, drag = false;
      bar.addEventListener('mousedown', (e) => {
        if (isRead()) return;
        drag = true; sx = e.clientX; sy = e.clientY;
        op.setAttribute('data-manual', ''); // layout resolver leaves dragged ops alone
        // offsetParent, not parentElement: ops may sit inside a display:contents
        // wrapper (e.g. the homepage rack), which has no box to measure against
        const r = op.getBoundingClientRect(), pr = (op.offsetParent || host).getBoundingClientRect();
        ox = r.left - pr.left; oy = r.top - pr.top;
        op.style.left = ox + 'px'; op.style.top = oy + 'px'; op.style.right = 'auto'; op.style.bottom = 'auto'; op.style.transform = 'none';
        host.querySelectorAll('.op').forEach((o) => (o.style.zIndex = 5));
        op.style.zIndex = 25;
        e.preventDefault();
      });
      on(window, 'mousemove', (e) => {
        if (!drag) return;
        op.style.left = ox + e.clientX - sx + 'px';
        op.style.top = oy + e.clientY - sy + 'px';
      });
      on(window, 'mouseup', () => (drag = false));
    });

    /* ---------- DUO dock: co-visibility for paired surfaces ---------- */
    (function () {
      const members = Array.from(host.querySelectorAll('[data-duo]'));
      if (members.length < 2) return;
      // phones get a smaller dock — 200px wide covered the very controls it previews
      const dockMax = () => (window.innerWidth <= 480 ? [148, 170] : [200, 230]);

      const dock = document.createElement('div');
      dock.className = 'pfdock';
      dock.setAttribute('role', 'button');
      dock.tabIndex = 0;
      dock.hidden = true;
      dock.innerHTML = '<div class="pfdock-body"></div><span class="pfdock-chip"></span>';
      host.appendChild(dock);
      const dockBody = dock.querySelector('.pfdock-body');
      const dockChip = dock.querySelector('.pfdock-chip');

      let docked = null;

      function fit(el) {
        const [DW, DH] = dockMax();
        const sc = Math.min(DW / el.__w, DH / el.__h, 1);
        el.style.transformOrigin = 'top left';
        el.style.transform = 'scale(' + sc + ')';
        dockBody.style.width = el.__w * sc + 'px';
        dockBody.style.height = el.__h * sc + 'px';
      }
      function dockEl(el) {
        if (docked === el) return;
        if (docked) undock();
        const name = el.dataset.duoName || el.dataset.duo;
        el.__w = el.offsetWidth || 1;
        el.__h = el.offsetHeight || 1;
        el.__next = el.nextSibling;
        // pin real size (dock width would otherwise re-resolve % widths),
        // reserve the home region so the page doesn't jump
        el.__home.style.minHeight = el.__home.offsetHeight + 'px';
        el.style.width = el.__w + 'px';
        el.style.height = el.__h + 'px';
        dockBody.appendChild(el);
        fit(el);
        dockChip.textContent = '⇆ ' + name;
        dock.setAttribute('aria-label', name + ' docked — activate to bring it back into view');
        dock.hidden = false;
        docked = el;
        document.dispatchEvent(new CustomEvent('patch:duo', { detail: { el, docked: true } }));
      }
      function undock() {
        if (!docked) return;
        const el = docked;
        el.style.transform = ''; el.style.transformOrigin = '';
        el.style.width = ''; el.style.height = '';
        el.__home.insertBefore(el, el.__next && el.__next.parentNode === el.__home ? el.__next : null);
        el.__home.style.minHeight = '';
        dock.hidden = true;
        docked = null;
        document.dispatchEvent(new CustomEvent('patch:duo', { detail: { el, docked: false } }));
      }

      // one dock per field: first complete pair claims it
      const byPair = {};
      members.forEach((el) => { (byPair[el.dataset.duo] = byPair[el.dataset.duo] || []).push(el); });
      const pair = Object.values(byPair).find((p) => p.length === 2);
      if (!pair) return;

      const vis = new Map();
      pair.forEach((el) => { el.__home = el.parentElement; vis.set(el, true); });
      const io = new IntersectionObserver((es) => {
        es.forEach((en) => {
          const el = pair.find((m) => m.__home === en.target);
          if (el) vis.set(el, en.isIntersecting && en.intersectionRatio >= 0.18);
        });
        const [a, b] = pair;
        if (vis.get(a) && vis.get(b)) undock();
        else if (vis.get(a) && !vis.get(b)) dockEl(b);
        else if (vis.get(b) && !vis.get(a)) dockEl(a);
        // neither visible → keep the current dock, no thrash
      }, { threshold: [0, 0.18, 0.5] });
      pair.forEach((el) => io.observe(el.__home));
      if (sys) sys.cleanup(() => io.disconnect());

      function activate() {
        if (!docked) return;
        const home = docked.__home;
        undock(); // immediate feedback; IO settles the counterpart
        home.scrollIntoView({ behavior: REDUCED ? 'auto' : 'smooth', block: 'center' });
      }
      // a drag must not fire the tap action — `dragged` is set by the
      // drag-to-corner logic below and consumed by this guard
      dock.addEventListener('click', () => { if (dragged) { dragged = false; return; } activate(); });
      dock.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });

      /* drag-to-corner: on phones the dock can cover the very controls the
         other surface needs — let the visitor park it in any corner. <8px of
         travel is a tap (activate, unchanged); more = drag, snap to nearest
         corner on release, persisted. Safe insets clear the nav + playbar. */
      const CKEY = 'pfdock-corner';
      let corner = 'br';
      try { const c = localStorage.getItem(CKEY); if (/^[tb][lr]$/.test(c || '')) corner = c; } catch (e) {}
      function applyCorner() {
        const m = 14;
        dock.style.left = dock.style.right = dock.style.top = dock.style.bottom = 'auto';
        dock.style[corner[1] === 'l' ? 'left' : 'right'] = m + 'px';
        if (corner[0] === 't') dock.style.top = 'calc(var(--nav-height) + ' + m + 'px)';
        else dock.style.bottom = 'calc(var(--playbar-height) + ' + m + 'px)';
      }
      applyCorner();
      let dgx = 0, dgy = 0, tracking = false, dragged = false;
      dock.addEventListener('pointerdown', (e) => {
        tracking = true; dragged = false; dgx = e.clientX; dgy = e.clientY;
        if (dock.setPointerCapture) try { dock.setPointerCapture(e.pointerId); } catch (e2) {}
      });
      dock.addEventListener('pointermove', (e) => {
        if (!tracking) return;
        const dx = e.clientX - dgx, dy = e.clientY - dgy;
        if (!dragged && Math.hypot(dx, dy) < 8) return;
        dragged = true;
        dock.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
      });
      const endDrag = () => {
        if (!tracking) return;
        tracking = false;
        if (!dragged) return; // plain tap → the click listener activates
        const r = dock.getBoundingClientRect();
        corner = (r.top + r.height / 2 < window.innerHeight / 2 ? 't' : 'b') +
                 (r.left + r.width / 2 < window.innerWidth / 2 ? 'l' : 'r');
        dock.style.transform = '';
        applyCorner();
        try { localStorage.setItem(CKEY, corner); } catch (e) {}
      };
      dock.addEventListener('pointerup', endDrag);
      dock.addEventListener('pointercancel', () => { tracking = false; dragged = false; dock.style.transform = ''; });

      on(window, 'resize', () => { if (docked) fit(docked); });
      // mode toggles reflow everything — reset and let the IO re-decide
      on(document, 'patchmode', undock);
    })();
  });
})();
</script>
