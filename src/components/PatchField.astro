---
/**
 * PatchField — the shared network canvas.
 *
 * Wraps a set of Operators in a spatial patch: dot-grid background,
 * generative dither canvas, bezier cables with signal pulses, and
 * draggable operators. One inline runtime initializes every field
 * on the page (guarded, view-transition safe).
 *
 * DITHER ENGINE v2 (the bg_generator chain, for real):
 *   NOISE   — two-octave value noise drifting over time
 *   FEEDBK  — persistent field buffer; new = noise*(1-fb) + field*fb,
 *             which turns the mouse's heat into phosphor trails
 *   DITHER  — 4×4 Bayer, two-tone: quiet base pixels + bright signal
 *             pixels where the field runs hot (e.g. under the cursor)
 *   OUT     — palette select (green / amber / cyan / mono)
 *
 * TD-style params: any <input data-param="density|speed|scale|feedback">
 * inside the field cooks instantly; a <button data-cycle="palette">
 * cycles palettes; readouts go to [data-out="..."]; inputs may carry
 * data-stage="noise|feedbk|dither|out" to flash the matching
 * [data-chip="..."] chain chip when touched.
 *
 * READ mode (body.perform): operators stack in DOM order; wires hide;
 * the dither keeps cooking as a fixed, quieter backdrop so the
 * bg_generator controls still mean something.
 *
 * Props:
 *  - id:      DOM id (required, unique per field)
 *  - links:   [[fromOpId, toOpId], ...] — cables, drawn out-port → in-port
 *  - density: initial dither density 0–1 (0 disables the dither canvas)
 *  - height:  'viewport' (fill viewport minus chrome) | CSS min-height value
 *  - label:   aria-label for the region
 */
interface Props {
  id: string;
  links?: [string, string][];
  density?: number;
  height?: string;
  label?: string;
}
const { id, links = [], density = 0.5, height = 'viewport', label = 'Interactive patch — press P for read view' } = Astro.props;
const heightStyle =
  height === 'viewport'
    ? `height: calc(100vh - var(--nav-height) - var(--playbar-height) - 4px); min-height: 760px;`
    : `min-height: ${height};`;
---

<section
  class="patchfield"
  id={id}
  aria-label={label}
  data-links={JSON.stringify(links)}
  data-density={String(density)}
  style={heightStyle}
>
  {density > 0 && <canvas class="bgdither" aria-hidden="true"></canvas>}
  <svg class="wires" aria-hidden="true"></svg>
  <slot />
</section>

<style>
  .patchfield {
    position: relative;
    overflow: hidden;
    cursor: crosshair;
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  .bgdither { position: absolute; inset: 0; opacity: 0.75; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }

  /* READ mode: the network becomes a document; the dither drops behind
     everything as a fixed, quieter backdrop (params still live) */
  :global(body.perform) .patchfield {
    height: auto !important;
    min-height: 0 !important;
    cursor: default;
    background-image: none;
    padding: calc(var(--nav-height) + 40px) 20px 64px;
    /* centers the inline-block SYS control strip; ops reset to left */
    text-align: center;
  }
  :global(body.perform) .patchfield :global(.op) { text-align: left; }
  :global(body.perform) .bgdither {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    opacity: 0.28;
  }
</style>

<script is:inline data-astro-rerun>
(function () {
  document.querySelectorAll('.patchfield').forEach((host) => {
    if (host.dataset.pfInit) return;
    host.dataset.pfInit = '1';

    const cv = host.querySelector('canvas.bgdither');
    const svg = host.querySelector('svg.wires');
    const LINKS = JSON.parse(host.dataset.links || '[]');
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isRead = () => document.body.classList.contains('perform');

    /* ---------- TD-style parameters ---------- */
    const PALETTES = [
      { n: 'GRN', base: '#233b2c', hot: '#3dff88' },
      { n: 'AMB', base: '#3a2c14', hot: '#e8a317' },
      { n: 'CYN', base: '#15303d', hot: '#56b4e9' },
      { n: 'MONO', base: '#26262a', hot: '#9f9f98' },
    ];
    /* defaults (Carlton's picks, 2026-07-02) — overridden by any values
       the visitor tweaked earlier (persisted across pages/visits) */
    const P = {
      density: parseFloat(host.dataset.density || '0.77'),
      speed: 1,
      scale: 3,
      feedback: 0.78,
      pal: 0,
      noiseT: 1,   // RIDGE
      ditherT: 1,  // BAYER2
    };
    const STORE = 'patch-bg';
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(STORE) || '{}') || {}; } catch (e) {}
    Object.keys(P).forEach((k) => { if (typeof saved[k] === 'number' && isFinite(saved[k])) P[k] = saved[k]; });
    function persist() {
      try { localStorage.setItem(STORE, JSON.stringify(P)); } catch (e) {}
    }

    host.querySelectorAll('[data-param]').forEach((inp) => {
      const k = inp.dataset.param;
      const div = parseFloat(inp.dataset.div || '1');
      const out = host.querySelector(`[data-out="${k}"]`);
      // reflect current (possibly persisted) value in the control
      inp.value = String(P[k] * div);
      const upd = (save) => {
        P[k] = parseFloat(inp.value) / div;
        if (out) out.textContent = div === 1 ? String(P[k]) : P[k].toFixed(2);
        // track fill up to the thumb (consumed by .prange CSS)
        const mn = parseFloat(inp.min || '0'), mx = parseFloat(inp.max || '100');
        inp.style.setProperty('--p', (((parseFloat(inp.value) - mn) / (mx - mn)) * 100).toFixed(1) + '%');
        if (save) persist();
      };
      inp.addEventListener('input', () => upd(true));
      upd(false);
    });
    /* type cyclers — <button data-cycle="palette|noise|dither" data-prefix="..."> */
    const CYC = {
      palette: { key: 'pal', opts: PALETTES.map((p) => p.n) },
      noise: { key: 'noiseT', opts: ['FBM', 'RIDGE', 'PLASMA'] },
      dither: { key: 'ditherT', opts: ['BAYER4', 'BAYER2', 'SCAN', 'STATIC'] },
    };
    host.querySelectorAll('[data-cycle]').forEach((btn) => {
      const c = CYC[btn.dataset.cycle];
      if (!c) return;
      const pre = btn.dataset.prefix || btn.dataset.cycle.toUpperCase();
      const label = () => {
        P[c.key] = ((P[c.key] | 0) % c.opts.length + c.opts.length) % c.opts.length;
        btn.textContent = `${pre} ▸ ${c.opts[P[c.key]]}`;
      };
      btn.addEventListener('click', () => { P[c.key] = (P[c.key] + 1) % c.opts.length; label(); persist(); });
      label();
    });

    /* ---------- dither engine v2.1 ----------
       Perf model: cook the field at 1px/cell into an offscreen ImageData,
       blit once with nearest-neighbor scaling, then punch the cell gutters
       out with a destination-out grid pattern. ~2 canvas ops per cook
       instead of tens of thousands of fillRects; cooks at 30fps. */
    const B = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
    const hex2rgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    PALETTES.forEach((p) => { p.baseRGB = hex2rgb(p.base); p.hotRGB = hex2rgb(p.hot); });
    let W = 0, H = 0, ctx = null, t = 0;
    let FW = 0, FH = 0, FS = 4, FSbase = 0, field = null;
    let oc = null, octx = null, img = null, gridPat = null;

    // value noise (seeded permutation)
    const perm = new Uint8Array(512);
    (function () {
      const p = Array.from({ length: 256 }, (_, i) => i);
      let sd = 1337;
      const r = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
      for (let i = 255; i > 0; i--) { const j = (r() * (i + 1)) | 0; const tmp = p[i]; p[i] = p[j]; p[j] = tmp; }
      for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
    })();
    const fade = (x) => x * x * (3 - 2 * x);
    function vn(x, y) {
      const xi = Math.floor(x), yi = Math.floor(y);
      const xf = x - xi, yf = y - yi;
      const X = xi & 255, Y = yi & 255;
      const a = perm[perm[X] + Y] / 255, b = perm[perm[X + 1] + Y] / 255;
      const c = perm[perm[X] + Y + 1] / 255, d = perm[perm[X + 1] + Y + 1] / 255;
      const u = fade(xf), v = fade(yf);
      const l1 = a + (b - a) * u, l2 = c + (d - c) * u;
      return l1 + (l2 - l1) * v;
    }

    function size() {
      if (!cv) return;
      if (isRead()) { W = cv.width = window.innerWidth; H = cv.height = window.innerHeight; }
      else { W = cv.width = host.clientWidth; H = cv.height = host.clientHeight; }
      allocField();
    }
    function allocField() {
      FSbase = Math.max(2, Math.round(P.scale));
      let s = FSbase;
      while (Math.ceil(W / s) * Math.ceil(H / s) > 140000) s++; // perf cap
      FS = s;
      FW = Math.max(1, Math.ceil(W / s)); FH = Math.max(1, Math.ceil(H / s));
      field = new Float32Array(FW * FH);
      // offscreen cell buffer
      oc = document.createElement('canvas');
      oc.width = FW; oc.height = FH;
      octx = oc.getContext('2d');
      img = octx.createImageData(FW, FH);
      // gutter pattern (1px cell gaps, erased via destination-out)
      const gp = document.createElement('canvas');
      gp.width = s; gp.height = s;
      const g = gp.getContext('2d');
      g.fillStyle = '#000';
      g.fillRect(s - 1, 0, 1, s);
      g.fillRect(0, s - 1, s, 1);
      gridPat = ctx ? ctx.createPattern(gp, 'repeat') : null;
    }
    if (cv) {
      ctx = cv.getContext('2d');
      new ResizeObserver(size).observe(host);
      window.addEventListener('resize', size);
      document.addEventListener('patchmode', () => setTimeout(size, 50));
      size();
    }

    /* mouse heat — velocity-driven so a parked cursor cools down */
    let mcx = -1e4, mcy = -1e4, energy = 0, lmx = 0, lmy = 0;
    window.addEventListener('pointermove', (e) => {
      energy = Math.min(70, energy + Math.hypot(e.clientX - lmx, e.clientY - lmy) * 0.6);
      lmx = e.clientX; lmy = e.clientY;
      mcx = e.clientX; mcy = e.clientY;
    }, { passive: true });

    function cookDither() {
      if (!ctx || P.density <= 0 || !field) return;
      if (Math.max(2, Math.round(P.scale)) !== FSbase) allocField();
      if (!REDUCED) t += 0.008 * P.speed; // cooks at half frame-rate
      energy *= 0.74;

      // mouse position in field space
      let mx = -1e4, my = -1e4;
      if (!REDUCED) {
        const r = isRead() ? { left: 0, top: 0 } : host.getBoundingClientRect();
        mx = mcx - r.left; my = mcy - r.top;
      }
      const heatR2 = 2 * 90 * 90;
      const heatA = Math.min(1.5, energy * 0.03);
      const fb = Math.min(0.95, Math.max(0, P.feedback));
      const s = FS, f1 = 0.012 * s, f2 = 0.027 * s;
      const pal = PALETTES[P.pal];
      const [br, bg2, bb] = pal.baseRGB, [hr, hg, hb] = pal.hotRGB;
      const nt = P.noiseT | 0, dt = P.ditherT | 0;
      const B2 = [[0, 2], [3, 1]];
      const data = img.data;

      for (let gy = 0; gy < FH; gy++) {
        const py = gy * s;
        for (let gx = 0; gx < FW; gx++) {
          const px = gx * s;
          // NOISE (type-switched)
          let n;
          if (nt === 2) {
            // PLASMA: sine interference
            n = 0.5 + (Math.sin(px * 0.018 + t * 1.2) + Math.sin(py * 0.023 - t * 0.8) + Math.sin((px + py) * 0.011 + t * 0.5)) / 6;
            n = Math.max(0, (n - 0.35) * 1.6);
          } else {
            let n1 = vn(gx * f1 + t * 0.55, gy * f1 + t * 0.18);
            let n2 = vn(gx * f2 - t * 0.35 + 40.7, gy * f2 + 11.3);
            if (nt === 1) {
              // RIDGE: folded veins
              n1 = 1 - Math.abs(2 * n1 - 1); n2 = 1 - Math.abs(2 * n2 - 1);
              n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.45) * 1.7);
            } else {
              // FBM
              n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.32) * 1.55);
            }
          }
          // mouse heat
          const dx = px - mx, dy = py - my;
          if (heatA > 0.02 && dx > -260 && dx < 260 && dy > -260 && dy < 260) {
            n += heatA * Math.exp(-(dx * dx + dy * dy) / heatR2);
          }
          // FEEDBK
          const i = gy * FW + gx;
          const v = (field[i] = n * (1 - fb) + field[i] * fb);
          // DITHER (type-switched threshold), two-tone output → ImageData
          const L = v * P.density * 1.2;
          let th;
          if (dt === 1) th = (B2[gy & 1][gx & 1] + 0.5) / 4;
          else if (dt === 2) th = ((gy & 3) + 0.5) / 4.4; // SCAN lines
          else if (dt === 3) { const h = ((gx * 73856093) ^ (gy * 19349663)) >>> 0; th = ((h >>> 8) & 1023) / 1024; } // STATIC
          else th = (B[gy & 3][gx & 3] + 0.5) / 16; // BAYER4
          const o = i * 4;
          if (L > th) {
            const hot = L - 0.55 > th;
            data[o] = hot ? hr : br;
            data[o + 1] = hot ? hg : bg2;
            data[o + 2] = hot ? hb : bb;
            data[o + 3] = 255;
          } else {
            data[o + 3] = 0;
          }
        }
      }
      // blit: cells → screen, then punch out the gutters
      octx.putImageData(img, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(oc, 0, 0, FW, FH, 0, 0, FW * s, FH * s);
      if (gridPat && s > 2) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.fillStyle = gridPat;
        ctx.fillRect(0, 0, W, H);
        ctx.globalCompositeOperation = 'source-over';
      }
    }

    /* ---------- wires ---------- */
    function portPos(el, side) {
      const r = el.getBoundingClientRect(), h = host.getBoundingClientRect();
      return { x: (side === 'out' ? r.right : r.left) - h.left, y: r.top + r.height / 2 - h.top };
    }
    let phase = 0;
    function cookWires() {
      if (!svg || isRead()) { if (svg && isRead()) svg.innerHTML = ''; return; }
      if (!REDUCED) phase += 0.008;
      let o = '';
      for (let i = 0; i < LINKS.length; i++) {
        const a = document.getElementById(LINKS[i][0]), b = document.getElementById(LINKS[i][1]);
        if (!a || !b) continue;
        const A = portPos(a, 'out'), Bp = portPos(b, 'in');
        const dx = Math.max(60, Math.abs(Bp.x - A.x) * 0.5);
        const d = `M ${A.x} ${A.y} C ${A.x + dx} ${A.y}, ${Bp.x - dx} ${Bp.y}, ${Bp.x} ${Bp.y}`;
        o += `<path d="${d}" fill="none" stroke="#3dff88" stroke-opacity=".28" stroke-width="1.4"/>`;
        if (!REDUCED) {
          const tt = (phase + i * 0.22) % 1;
          const len = Math.hypot(Bp.x - A.x, Bp.y - A.y) + 2 * dx;
          o += `<path d="${d}" fill="none" stroke="#3dff88" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="10 2000" stroke-dashoffset="${-(tt * len)}" opacity=".9"/>`;
        }
      }
      svg.innerHTML = o;
    }

    /* ---------- main loop (dither cooks at half rate) ---------- */
    let fc = 0;
    function frame() {
      if (!host.isConnected) return;
      if ((fc++ & 1) === 0) cookDither();
      cookWires();
      requestAnimationFrame(frame);
    }
    if (REDUCED) {
      // static single cook; params still recook on change
      const still = () => { cookDither(); cookWires(); };
      host.addEventListener('input', () => setTimeout(still, 0));
      host.addEventListener('click', () => setTimeout(still, 0));
      document.addEventListener('patchmode', () => setTimeout(still, 80));
      still();
    } else {
      frame();
    }

    /* ---------- draggable operators ---------- */
    host.querySelectorAll('.op').forEach((op) => {
      const bar = op.querySelector('.ohead');
      if (!bar) return;
      let sx, sy, ox, oy, drag = false;
      bar.addEventListener('mousedown', (e) => {
        if (isRead()) return;
        drag = true; sx = e.clientX; sy = e.clientY;
        const r = op.getBoundingClientRect(), pr = op.parentElement.getBoundingClientRect();
        ox = r.left - pr.left; oy = r.top - pr.top;
        op.style.left = ox + 'px'; op.style.top = oy + 'px'; op.style.right = 'auto'; op.style.bottom = 'auto'; op.style.transform = 'none';
        host.querySelectorAll('.op').forEach((o) => (o.style.zIndex = 5));
        op.style.zIndex = 25;
        e.preventDefault();
      });
      window.addEventListener('mousemove', (e) => {
        if (!drag) return;
        op.style.left = ox + e.clientX - sx + 'px';
        op.style.top = oy + e.clientY - sy + 'px';
      });
      window.addEventListener('mouseup', () => (drag = false));
    });
  });
})();
</script>
