---
/**
 * PatchField — the shared network canvas.
 *
 * Wraps a set of Operators in a spatial patch: dot-grid background,
 * generative dither canvas, bezier cables with signal pulses, and
 * draggable operators. One inline runtime initializes every field
 * on the page (guarded, view-transition safe).
 *
 * DITHER ENGINE v2 (the bg_generator chain, for real):
 *   NOISE   — two-octave value noise drifting over time
 *   FEEDBK  — persistent field buffer; new = noise*(1-fb) + field*fb,
 *             which turns the mouse's heat into phosphor trails
 *   DITHER  — 4×4 Bayer, two-tone: quiet base pixels + bright signal
 *             pixels where the field runs hot (e.g. under the cursor)
 *   OUT     — palette select (green / amber / cyan / mono)
 *
 * TD-style params: any <input data-param="density|speed|scale|feedback">
 * inside the field cooks instantly; a <button data-cycle="palette">
 * cycles palettes; readouts go to [data-out="..."]; inputs may carry
 * data-stage="noise|feedbk|dither|out" to flash the matching
 * [data-chip="..."] chain chip when touched.
 *
 * READ mode (body.perform): operators stack in DOM order; wires hide;
 * the dither keeps cooking as a fixed, quieter backdrop so the
 * bg_generator controls still mean something.
 *
 * DUO dock: two elements marked data-duo="<pairId>" (+ data-duo-name for
 * the chip label) are a pair of surfaces that want co-visibility (e.g.
 * GRID's controller + 3D studio). IO-driven, no breakpoints: whenever one
 * surface's home region is on screen and the other's isn't, the other is
 * re-parented into a fixed corner dock (scaled live preview, tap/Enter to
 * swap — smooth-scrolls its home back into view and the IO settles the
 * rest). Home parents keep a min-height reservation so nothing jumps.
 * Emits `patch:duo` CustomEvents ({el, docked}) so demos can adapt
 * (e.g. drop pixel ratio while docked). One dock per field; first pair
 * wins if several fight over it.
 *
 * LAYOUT RESOLVER (opt-in via the `layout` prop): places ops that carry an
 * `area` prop from an ASCII grid-areas string, snapped to the dot grid.
 *   layout = {
 *     mode: 'fill' | 'content',  // fill: rows share the field height (hero pages)
 *                                // content: rows measure their tallest op, field
 *                                //          height is computed (long pages)
 *     padTop: 0,                 // extra px above row 0
 *     jitter: false,             // seeded half-grid scatter per op (opt-in)
 *     tiers: [                   // ascending `min` (field width px); last match wins
 *       { min: 0, cols: 12, areas: `
 *           hero hero .    view view
 *           .    .    .    view view
 *       ` },
 *     ],
 *   }
 * FLEX MODE (`mode: 'flex'`): no sketch. `rows` describes the page as flexbox (a column of rows,
 * rows of cards, columns inside rows) and the browser lays it out. The words are listed above
 * flexLayout in src/lib/patch-field.js. Cards may sit off the dot grid.
 *
 * Rules: resolver only touches `.op[data-area]`; `pos` ops are never touched;
 * dragged ops (data-manual) and DUO-docked ops are left alone; overlaps get
 * relaxed down-column; every tier should name every area op (missing ones keep
 * their previous position). Re-resolves on resize / patchmode / (content mode)
 * op size changes — late-hydrating islands are safe.
 *
 * PATCH RUNTIME (P1): PatchField inlines `src/lib/patch-runtime.js` and
 * registers each field as a runtime scope (`Patch.field(id)`), feeding it the
 * links array. Links may carry ports — ['opIndex:selection', 'opFx'] — which
 * makes the cable a real subscription: node registrations (page scripts)
 * emit/receive along them, and every routed delivery pushes a one-shot pulse
 * that cookWires renders as a traveling dot on the correct cable. Old
 * two-string links stay valid and purely visual. `?nopatch=1` skips the
 * runtime (visual-only cables). Field-level timers/listeners/observers ride
 * a housekeeping node so `astro:before-swap` tears everything down.
 *
 * Props:
 *  - id:      DOM id (required, unique per field)
 *  - links:   [[fromOpId, toOpId], ...] — cables, drawn out-port → in-port;
 *             ends may carry ports ('opId:channel') for runtime routing
 *  - density: initial dither density 0–1 (0 disables the dither canvas)
 *  - height:  'viewport' (fill viewport minus chrome) | CSS min-height value
 *             (content-mode layouts recompute this at runtime; the prop is the
 *             pre-JS fallback)
 *  - label:   aria-label for the region
 *  - layout:  optional layout-resolver config (see above)
 */
interface Props {
  id: string;
  links?: [string, string][];
  density?: number;
  height?: string;
  label?: string;
  layout?: {
    mode?: 'fill' | 'content' | 'flex';
    padTop?: number;
    jitter?: boolean;
    tiers?: { min?: number; cols?: number; areas?: string; rows?: unknown[] }[];
    /** mode 'flex': the page as flexbox. See flexLayout in src/lib/patch-field.js for the words. */
    rows?: unknown[];
    gap?: number;
  };
}
import { patchSrc } from '../lib/bundles.js';
const { id, links = [], density = 0.5, height = 'viewport', label = 'Interactive patch — press P for read view', layout } = Astro.props;
// Fill the content area (viewport minus the fixed nav + footer/playbar). For
// fixed-height fields (case studies, contact) still grow to at least fill, so
// short pages don't leave a bare strip below the dither.
const fillH = 'calc(100vh - var(--nav-height) - var(--playbar-height))';
const heightStyle =
  height === 'viewport'
    ? `height: ${fillH}; min-height: 640px;`
    : `min-height: max(${height}, ${fillH});`;
---

<section
  class="patchfield"
  id={id}
  aria-label={label}
  data-links={JSON.stringify(links)}
  data-density={String(density)}
  data-layout={layout ? JSON.stringify(layout) : undefined}
  style={heightStyle}
>
  {density > 0 && <canvas class="bgdither" aria-hidden="true" transition:persist="bgdither"></canvas>}
  <svg class="wires" aria-hidden="true"></svg>
  <slot />
</section>

<style>
  .patchfield {
    position: relative;
    overflow: hidden;
    cursor: crosshair;
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  /* One viewport-fixed dither field (both modes). Cell size then depends only
     on the viewport, not on how tall a page's patch is — so the dither looks
     the same on a short page and a long case study — and it always fills. */
  /* width/height:100% of the fixed viewport (NOT 100vw/100vh) so the canvas
     never overhangs the scrollbar and forces a horizontal scroll — that
     overflow was clipping the navbar/footer right edge. */
  /* 0.28 in both modes since 2026-10-05. PATCH used to be 0.75, which fought the cards for attention. */
  .bgdither { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0.28; pointer-events: none; transition: opacity 0.35s; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }

  /* READ mode: the network becomes a document; the dither drops behind
     everything as a fixed, quieter backdrop (params still live) */
  :global(body.perform) .patchfield {
    height: auto !important;
    min-height: 0 !important;
    cursor: default;
    background-image: none;
    padding: calc(var(--nav-height) + 40px) 20px 64px;
    /* centers the inline-block SYS control strip; ops reset to left */
    text-align: center;
  }
  :global(body.perform) .patchfield :global(.op) { text-align: left; transition: opacity 0.35s; }
  :global(body.perform) .bgdither {
    z-index: -1;
    opacity: 0.28;
    transition: opacity 0.35s;
  }
  /* audition: a bg control is being touched — the field comes forward so the
     change is legible under the finger; content steps back for a beat
     (body class set by the engine, auto-clears ~1.2s after last input).
     Both modes since 2026-10-05; it used to be READ only. */
  .patchfield :global(.op) { transition: opacity 0.35s, box-shadow var(--duration-normal), border-color var(--duration-normal); }
  :global(body.bg-audition) .bgdither { opacity: 0.65; }
  :global(body.bg-audition) .patchfield :global(.op:not(.op-sys)) { opacity: 0.25; }
</style>

<!-- resolver-managed ops stay invisible until first placement (no flash at 0,0);
     scoped to JS-on patch mode: READ mode and noscript never hide anything -->
<noscript>
  <style>
    /* no JS = no resolver, no drag, no wires: fall back to READ-style stacking */
    .patchfield { height: auto !important; min-height: 0 !important; padding: 80px 20px 64px; }
    .patchfield .op { position: static !important; width: 100% !important; max-width: 680px; margin: 0 auto 40px; visibility: visible !important; }
  </style>
</noscript>

<!-- DUO dock — JS-created, so it can't take Astro's scoped attributes -->
<style is:global>
  body:not(.perform) .patchfield .op[data-area]:not([data-placed]) { visibility: hidden; }

  .pfdock {
    position: fixed;
    right: 14px;
    bottom: calc(var(--playbar-height) + 14px);
    z-index: 80; /* above ops (≤25), under the nav (90) */
    background: var(--bg-elevated);
    border: 1px solid rgba(61, 255, 136, 0.45); /* clickable = signal border (.chipbtn grammar) */
    border-radius: var(--radius-md);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
    padding: 6px;
    cursor: pointer;
    text-align: left;
    touch-action: none; /* drag-to-corner: the dock owns its touch gestures */
    transition: box-shadow var(--duration-fast), background var(--duration-fast);
  }
  .pfdock:hover,
  .pfdock:focus-visible { background: rgba(61, 255, 136, 0.06); box-shadow: 0 0 12px rgba(61, 255, 136, 0.18), 0 18px 50px rgba(0, 0, 0, 0.6); }
  .pfdock:focus-visible { outline: 1px solid var(--signal); outline-offset: 2px; }
  .pfdock-body { overflow: hidden; pointer-events: none; border-radius: 4px; }
  /* docked surfaces may carry home-layout margins (e.g. flush-bleed wrappers) */
  .pfdock-body > * { margin: 0 !important; }
  /* hover: the verb chip beside the pointer */
  .pfverb {
    position: fixed; left: 0; top: 0; z-index: 85; /* above ops, under the nav */
    pointer-events: none;
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em;
    color: var(--bg); background: var(--signal);
    padding: 2px 6px; border-radius: 3px; white-space: nowrap;
    opacity: 0; transition: opacity 0.08s; will-change: transform;
  }
  .pfverb.on { opacity: 1; }
  body.perform .pfverb { display: none; }
  @media (prefers-reduced-motion: reduce) { .pfverb { transition: none; } }
  .pfdock-chip {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--signal);
    text-align: center;
  }
</style>

<!-- The patch runtime and the network script, as one cached file (src/lib/bundles.js).
     It must come before every page script that registers a node, and it runs again on
     every page (data-astro-rerun). -->
<script is:inline data-astro-rerun src={patchSrc}></script>
