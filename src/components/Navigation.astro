---
/**
 * Navigation — "PatchBar"
 *
 * Patch chrome, not OS chrome, in three clusters:
 *   1. brand mark + live network-path chip
 *   2. routes addressed like operators (/work /about …) with port dots
 *   3. instrument controls: TAB hint · PATCH/READ toggle · cook status
 * Modes are labeled PATCH (spatial) / READ (linear) for visitors;
 * internally the class/localStorage values remain network/perform.
 * Pure Astro; scripts are inline and dependency-free.
 */
import { projects } from '../data/content.js';

const currentPath = Astro.url.pathname;

// /work addresses the full project index (case studies highlight it too);
// the homepage network is reachable through the brand mark, like a patch's
// root node. Active state is prefix-aware so /projects/futurescaper lights
// /work and /lab/* lights /lab.
const links = [
  { href: '/projects', label: 'work' },
  { href: '/about', label: 'about' },
  { href: '/lab', label: 'lab' },
  { href: '/contact', label: 'contact' },
];
const isOn = (href) => {
  const path = currentPath.replace(/\/+$/, '') || '/';
  return path === href || (href !== '/' && path.startsWith(href + '/'));
};

// op-search palette entries
const ops = [
  { href: '/', name: 'network_home', typ: 'SYS' },
  { href: '/projects', name: 'work_index', typ: 'DATA' },
  { href: '/about', name: 'bio_txt', typ: 'TXT' },
  { href: '/lab', name: 'experiments_index', typ: 'DATA' },
  { href: '/contact', name: 'say_hi', typ: 'TXT' },
  ...projects.map((p) => ({
    href: `/projects/${p.slug}`,
    name: p.slug.replace(/-/g, '_'),
    typ: p.featured ? 'VIEW' : 'TXT',
  })),
];

// network path readout, e.g. /network/work/futurescaper
const netPath = currentPath === '/' ? '/network/home' : `/network${currentPath.replace(/\/$/, '')}`;
---

<header
  class="fixed top-0 left-0 right-0 z-50 h-[var(--nav-height)] border-b border-border"
  style="background: var(--backdrop-blur); backdrop-filter: blur(12px);"
  transition:persist
>
  <nav class="h-full flex items-center gap-3 px-5 md:px-8 lg:px-10">
    <!-- cluster 1: brand + live network path -->
    <a href="/" class="brand" aria-label="carlton.dev — home">
      <span class="mark" aria-hidden="true">▛▟</span>
      <span class="hidden sm:inline">carlton.dev</span>
    </a>
    <span class="pathchip hidden lg:inline-flex" aria-hidden="true">{netPath}</span>

    <span class="flex-1"></span>

    <!-- cluster 2: routes, addressed like operators -->
    <ul class="flex items-center gap-1 list-none overflow-x-auto">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['navlink', { on: isOn(href) }]}>
            <i class="ndot" aria-hidden="true"></i><span class="slash" aria-hidden="true">/</span>{label}
          </a>
        </li>
      ))}
    </ul>

    <!-- cluster 3: instrument controls -->
    <span class="vdiv hidden xl:block" aria-hidden="true"></span>
    <span class="kbdhint hidden xl:inline-flex" aria-hidden="true"><kbd>TAB</kbd> ops</span>
    <button
      id="modeToggle"
      class="modetog hidden xl:flex"
      aria-label="Toggle patch / read view"
      title="P — toggle PATCH (spatial) / READ (linear)"
    >
      <span data-mode="network" class="mode-on">PATCH</span>
      <span data-mode="perform" class="text-text-muted">READ</span>
    </button>
    <span class="vdiv hidden xl:block" aria-hidden="true"></span>
    <span class="cook hidden xl:inline-flex" aria-hidden="true"><i></i>COOKED</span>
  </nav>

  <!-- op-search palette (TAB in network mode / ⌘K anywhere) -->
  <div id="opSearch" class="opsearch" hidden>
    <div class="opsearch-box" role="dialog" aria-modal="true" aria-label="Operator search">
      <div class="opsearch-head">
        <span>ADD OPERATOR</span>
        <span class="opsearch-kbd">ESC</span>
      </div>
      <input id="opSearchInput" type="text" placeholder="type to filter ops…" autocomplete="off" spellcheck="false" />
      <ul id="opSearchList">
        {ops.map(({ href, name, typ }) => (
          <li data-href={href} data-name={name}>
            <a href={href} tabindex="-1">
              <span class={`opsearch-typ t-${typ.toLowerCase()}`}>{typ}</span>
              <span class="opsearch-name">{name}</span>
              <span class="opsearch-path">{href}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<style>
  /* --- PatchBar clusters --- */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover { color: var(--signal); }
  .brand .mark { color: var(--signal); font-weight: 400; }

  .pathchip {
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--signal);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 2px 8px;
    background: rgba(61, 255, 136, 0.04);
    white-space: nowrap;
  }

  .navlink {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .navlink .slash { color: var(--text-dim); }
  .navlink .ndot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    border: 1px solid var(--text-dim);
    background: transparent;
    transition: background var(--duration-fast), border-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  .navlink:hover { color: var(--text); background: rgba(230, 230, 226, 0.04); }
  .navlink:hover .ndot { border-color: var(--text-muted); }
  .navlink.on { color: var(--signal); }
  .navlink.on .slash { color: var(--signal-dim); }
  .navlink.on .ndot {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 7px rgba(61, 255, 136, 0.8);
  }

  .vdiv { width: 1px; height: 16px; background: var(--border-color); margin: 0 4px; }

  .kbdhint {
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .kbdhint kbd {
    border: 1px solid #2c2c30;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 9px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .modetog {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    border: 1px solid var(--border-color);
    border-radius: 5px;
    overflow: hidden;
    cursor: pointer;
  }
  .modetog span { padding: 3px 10px; }
  .mode-on { background: var(--signal); color: var(--bg); font-weight: 700; }

  .cook {
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--signal);
    white-space: nowrap;
  }
  .cook i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: cookpulse 2.4s ease-in-out infinite;
  }
  @keyframes cookpulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px rgba(61, 255, 136, 0.9); }
    50% { opacity: 0.45; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cook i { animation: none; }
  }

  .opsearch {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(10, 10, 11, 0.7);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
  }
  .opsearch-box {
    width: min(480px, 92vw);
    background: var(--bg-elevated);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .opsearch-head {
    display: flex;
    justify-content: space-between;
    padding: 7px 12px;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  .opsearch-kbd {
    border: 1px solid #2c2c30;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 9px;
    color: var(--text-dim);
  }
  .opsearch input {
    width: 100%;
    background: var(--bg-surface);
    border: none;
    outline: none;
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
  }
  .opsearch ul { list-style: none; max-height: 42vh; overflow-y: auto; margin: 0; padding: 4px 0; }
  .opsearch li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .opsearch li[hidden] { display: none; }
  .opsearch li.sel a, .opsearch li a:hover { background: rgba(61, 255, 136, 0.07); }
  .opsearch-typ { font-size: 8.5px; font-weight: 700; padding: 1px 5px; border-radius: 3px; }
  .opsearch-typ.t-view { background: var(--op-view-bg); color: var(--op-view-fg); }
  .opsearch-typ.t-txt { background: var(--op-txt-bg); color: var(--op-txt-fg); }
  .opsearch-typ.t-data { background: var(--op-data-bg); color: var(--op-data-fg); }
  .opsearch-typ.t-sys { background: var(--op-sys-bg); color: var(--op-sys-fg); }
  .opsearch-name { color: var(--text); }
  .opsearch-path { margin-left: auto; color: var(--text-dim); font-size: 10px; }
</style>

<script is:inline>
  (function () {
    const KEY = 'patch-mode';
    const btn = document.getElementById('modeToggle');
    // The visitor's EXPLICIT choice is the only thing we persist. The mode we
    // actually render ("effective") may be forced to READ on narrow viewports
    // or for reduced motion — but that must not overwrite their preference, or
    // a transient narrow window would trap them in READ everywhere afterward.
    const readPref = () => { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
    const forced = () => window.matchMedia('(max-width: 1279px)').matches ||
                         window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const effective = () => forced() ? 'perform' : (readPref() || 'network');
    function apply(mode, persist) {
      document.body.classList.toggle('perform', mode === 'perform');
      if (btn) btn.querySelectorAll('span').forEach(s => {
        const on = s.dataset.mode === mode;
        s.classList.toggle('mode-on', on);
        s.classList.toggle('text-text-muted', !on);
      });
      if (persist) { try { localStorage.setItem(KEY, mode); } catch (e) {} }
      document.dispatchEvent(new CustomEvent('patchmode', { detail: mode }));
    }
    apply(effective(), false);
    // An explicit toggle: flip relative to the current EFFECTIVE mode and save
    // it as the new preference so it carries across every subsequent page.
    const toggle = () => {
      const next = document.body.classList.contains('perform') ? 'network' : 'perform';
      apply(next, true);
    };
    btn && btn.addEventListener('click', toggle);
    window.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() === 'p' && !e.metaKey && !e.ctrlKey &&
          !/input|textarea/i.test(document.activeElement?.tagName || '')) toggle();
    });
    // keep the effective mode correct if the window crosses the breakpoint
    window.matchMedia('(max-width: 1279px)').addEventListener?.('change', () => apply(effective(), false));

    // The header is transition:persist (kept across view-transition swaps), so
    // the active route + /network path chip must be refreshed by hand on nav.
    function updateNav() {
      const path = (location.pathname || '/').replace(/\/+$/, '') || '/';
      document.querySelectorAll('header .navlink').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
        // prefix-aware: /projects/foo lights /work, /lab/foo lights /lab
        a.classList.toggle('on', href === path || (href !== '/' && path.indexOf(href + '/') === 0));
      });
      const chip = document.querySelector('header .pathchip');
      if (chip) chip.textContent = path === '/' ? '/network/home' : '/network' + path;
    }

    /* ---------- op-search palette ---------- */
    const pal = document.getElementById('opSearch');
    const inp = document.getElementById('opSearchInput');
    const list = document.getElementById('opSearchList');
    if (!pal || pal.dataset.init) return;
    pal.dataset.init = '1';
    let sel = 0;

    function rows() { return [...list.querySelectorAll('li:not([hidden])')]; }
    function paint() {
      rows().forEach((li, i) => li.classList.toggle('sel', i === sel));
      const cur = rows()[sel];
      cur && cur.scrollIntoView({ block: 'nearest' });
    }
    function openPal() {
      pal.hidden = false;
      inp.value = '';
      list.querySelectorAll('li').forEach((li) => (li.hidden = false));
      sel = 0; paint();
      inp.focus();
    }
    function closePal() { pal.hidden = true; inp.blur(); }

    window.addEventListener('keydown', (e) => {
      const inField = /input|textarea/i.test(document.activeElement?.tagName || '') &&
                      document.activeElement !== inp;
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      // TAB opens the palette in NETWORK mode only — perform mode keeps
      // native keyboard navigation untouched (accessibility first).
      const tab = e.key === 'Tab' && !e.shiftKey &&
                  !document.body.classList.contains('perform') && !inField;
      if ((cmdK || tab) && pal.hidden) { e.preventDefault(); openPal(); return; }
      if (!pal.hidden && e.key === 'Escape') { e.preventDefault(); closePal(); }
    });
    pal.addEventListener('mousedown', (e) => { if (e.target === pal) closePal(); });

    inp.addEventListener('input', () => {
      const q = inp.value.trim().toLowerCase();
      list.querySelectorAll('li').forEach((li) => {
        li.hidden = q !== '' && !li.dataset.name.includes(q) && !li.dataset.href.includes(q);
      });
      sel = 0; paint();
    });
    inp.addEventListener('keydown', (e) => {
      const r = rows();
      if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(sel + 1, r.length - 1); paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(sel - 1, 0); paint(); }
      else if (e.key === 'Enter') { e.preventDefault(); r[sel] && (location.href = r[sel].dataset.href); }
      else if (e.key === 'Tab') { e.preventDefault(); closePal(); }
    });
    document.addEventListener('astro:after-swap', () => {
      closePal();
      // body classes don't survive the view-transition swap — re-apply the
      // effective mode (which respects the saved preference), so navigating
      // from PATCH lands you in PATCH, from READ lands you in READ.
      apply(effective(), false);
      updateNav();
    });
  })();
</script>
