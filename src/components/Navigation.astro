---
/**
 * Navigation — "PatchBar"
 *
 * Patch chrome, not OS chrome, in three clusters:
 *   1. brand mark + live network-path chip
 *   2. routes addressed like operators (/work /about …) with port dots
 *   3. instrument controls: TAB hint · PATCH/READ toggle · cook status
 * Modes are labeled PATCH (spatial) / READ (linear) for visitors;
 * internally the class/localStorage values remain network/perform.
 * Pure Astro; scripts are inline and dependency-free.
 */
import { projects } from '../data/content.js';

const currentPath = Astro.url.pathname;

// /work addresses the full project index (case studies highlight it too);
// the homepage network is reachable through the brand mark, like a patch's
// root node. Active state is prefix-aware so /projects/futurescaper lights
// /work and /lab/* lights /lab.
const links = [
  { href: '/projects/', label: 'work' },
  { href: '/about/', label: 'about' },
  { href: '/lab/', label: 'lab' },
  { href: '/contact/', label: 'contact' },
];
const isOn = (href) => {
  const path = currentPath.replace(/\/+$/, '') || '/';
  const to = href.replace(/\/+$/, '') || '/';
  return path === to || (to !== '/' && path.startsWith(to + '/'));
};

// op-search palette entries
const ops = [
  { href: '/', name: 'network_home', typ: 'SYS' },
  { href: '/projects/', name: 'work_index', typ: 'DATA' },
  { href: '/about/', name: 'bio_txt', typ: 'TXT' },
  { href: '/lab/', name: 'experiments_index', typ: 'DATA' },
  { href: '/contact/', name: 'say_hi', typ: 'TXT' },
  ...projects.map((p) => ({
    href: `/projects/${p.slug}/`,
    name: p.slug.replace(/-/g, '_'),
    typ: p.featured ? 'VIEW' : 'TXT',
  })),
];

// network path readout, e.g. /network/work/futurescaper
const netPath = currentPath === '/' ? '/network/home' : `/network${currentPath.replace(/\/$/, '')}`;
---

<header
  class="fixed top-0 left-0 right-0 z-50 h-[var(--nav-height)] border-b border-border"
  style="background: var(--backdrop-blur); backdrop-filter: blur(12px);"
  transition:persist
>
  <nav class="h-full flex items-center gap-3 px-5 md:px-8 lg:px-10">
    <!-- cluster 1: brand + live network path -->
    <a href="/" class="brand" aria-label="carlton.dev — home">
      <span class="mark" aria-hidden="true">▛▟</span>
      <span class="hidden sm:inline">carlton.dev</span>
    </a>
    <span class="pathchip hidden lg:inline-flex" aria-hidden="true">{netPath}</span>

    <span class="flex-1"></span>

    <!-- cluster 2: routes, addressed like operators -->
    <ul class="flex items-center gap-1 list-none overflow-x-auto">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['navlink', { on: isOn(href) }]} data-warm>
            <i class="ndot" aria-hidden="true"></i><span class="slash" aria-hidden="true">/</span>{label}
          </a>
        </li>
      ))}
    </ul>

    <!-- cluster 3: instrument controls -->
    <!-- touch path into the op-search palette: TAB/⌘K don't exist on phones -->
    <button id="opsBtn" class="opsbtn xl:hidden" aria-label="Open operator search">▸ OPS</button>
    <span class="vdiv hidden xl:block" aria-hidden="true"></span>
    <span class="kbdhint hidden xl:inline-flex" aria-hidden="true"><kbd>TAB</kbd> ops</span>
    <!-- REC: the answer to the recording question, and how to change it (src/lib/analytics.js).
         <html data-rec> picks the label before the first paint. -->
    <button id="recChip" type="button" class="recchip chipbtn" aria-label="Recording: not answered yet">
      <span class="rc rc-ask"><span class="rcw">REC </span>?</span>
      <span class="rc rc-yes"><i class="rdot"></i><span class="rcw">REC</span></span>
      <span class="rc rc-no"><i class="rdot off"></i><span class="rcw">REC<span class="rcoff"> OFF</span></span></span>
    </button>
    <button
      id="modeToggle"
      class="modetog hidden xl:flex"
      aria-label="Toggle patch / read view"
    >
      <span data-mode="network" class="mode-on">PATCH</span>
      <span data-mode="perform" class="text-text-muted">READ</span>
    </button>
    <span class="vdiv hidden xl:block" aria-hidden="true"></span>
    <span class="cook hidden xl:inline-flex" aria-hidden="true"><i></i>COOKED</span>
  </nav>

  <!-- op-search palette (TAB in network mode / ⌘K anywhere) -->
  <div id="opSearch" class="opsearch" hidden>
    <div class="opsearch-box" role="dialog" aria-modal="true" aria-label="Operator search">
      <div class="opsearch-head">
        <span>ADD OPERATOR</span>
        <button id="opSearchClose" class="opsearch-kbd" aria-label="Close operator search">
          <span class="hidden xl:inline">ESC</span><span class="xl:hidden">✕</span>
        </button>
      </div>
      <input id="opSearchInput" type="text" placeholder="type to filter ops…" autocomplete="off" spellcheck="false" />
      <ul id="opSearchList">
        {ops.map(({ href, name, typ }) => (
          <li data-href={href} data-name={name}>
            <a href={href} tabindex="-1">
              <span class={`opsearch-typ t-${typ.toLowerCase()}`}>{typ}</span>
              <span class="opsearch-name">{name}</span>
              <span class="opsearch-path">{href}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<!-- The recording question (docs/prototypes/consent-operator.html, changed 2026-10-22: under the
     REC chip in PATCH, at the bottom in READ, no cable; src/lib/analytics.js). Outside the header:
     its backdrop-filter would make the header the box this fixed operator sits in.
     Persisted like the header, so a question that's up stays up across page changes. -->
<section id="recOp" class="rec-op" aria-label="Recording" transition:persist="rec-op">
  <div class="rec-head">
    <span>sys · recorder</span>
    <span><span class="rec-st"><span class="rs-ask">waiting</span><span class="rs-yes">● rec</span><span class="rs-no">○ off</span></span> <span class="rec-typ">SYS</span></span>
  </div>
  <div class="rec-body">
    <p class="rec-copy">Mind if I record your visit? It helps me make the site better. Anything you type stays hidden.</p>
    <div class="rec-row">
      <button type="button" class="rec-btn chipbtn" data-rec-a="yes">▶ ok</button>
      <button type="button" class="rec-btn chipbtn" data-rec-a="no">■ no thanks</button>
      <a href="/privacy/">privacy →</a>
    </div>
  </div>
</section>

<style>
  /* --- PatchBar clusters --- */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover { color: var(--signal); }
  .brand .mark { color: var(--signal); font-weight: 400; }

  .pathchip {
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--signal);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 2px 8px;
    background: rgba(61, 255, 136, 0.04);
    white-space: nowrap;
  }

  .navlink {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .navlink .slash { color: var(--text-dim); }
  .navlink .ndot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    border: 1px solid var(--text-dim);
    background: transparent;
    transition: background var(--duration-fast), border-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  .navlink:hover { color: var(--text); background: rgba(230, 230, 226, 0.04); }
  .navlink:hover .ndot { border-color: var(--text-muted); }
  .navlink.on { color: var(--signal); }
  .navlink.on .slash { color: var(--signal-dim); }
  .navlink.on .ndot {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 7px rgba(61, 255, 136, 0.8);
  }

  /* phones: all four routes fit beside OPS and the REC chip without a sideways scroll (down to about 360px) */
  @media (max-width: 500px) {
    nav { gap: 6px; padding-left: 14px; padding-right: 14px; }
    .navlink { padding: 3px 4px; }
    .navlink .ndot { display: none; }
  }

  .vdiv { width: 1px; height: 16px; background: var(--border-color); margin: 0 4px; }

  /* touch entry to the palette — chip grammar, signal accents like a chipbtn */
  .opsbtn {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--signal);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    padding: 4px 9px;
    background: rgba(61, 255, 136, 0.04);
    white-space: nowrap;
    cursor: pointer;
  }
  .opsbtn:active { background: rgba(61, 255, 136, 0.12); }

  .kbdhint {
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .kbdhint kbd {
    border: 1px solid #2c2c30;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 9px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .modetog {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    border: 1px solid var(--border-color);
    border-radius: 5px;
    overflow: hidden;
    cursor: pointer;
  }
  .modetog span { padding: 3px 10px; }
  .mode-on { background: var(--signal); color: var(--bg); font-weight: 700; }

  .cook {
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--signal);
    white-space: nowrap;
  }
  .cook i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: cookpulse 2.4s ease-in-out infinite;
  }
  @keyframes cookpulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px rgba(61, 255, 136, 0.9); }
    50% { opacity: 0.45; box-shadow: none; }
  }
  /* room for the longest state (COOK 99%) so the links beside it never shift */
  .cook { min-width: 11ch; }
  /* COOKING: a page change is in progress (the front, then the cables wiring in) */
  .cook.busy i { background: transparent; border: 1px solid var(--signal); box-shadow: none; animation: none; }
  @media (prefers-reduced-motion: reduce) {
    .cook i { animation: none; }
  }

  /* --- the recording question: REC chip and operator (src/lib/analytics.js) --- */
  /* <html data-rec> (ask | yes | no) is set in the head before the first paint. Without it (no JS)
     neither shows: nothing would record anyway. */
  .recchip {
    display: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    background: transparent;
    white-space: nowrap;
  }
  :global(html[data-rec]) .recchip { display: inline-grid; }
  /* the three labels share one cell, so the chip is as wide as the longest and nothing beside it moves */
  .recchip .rc { grid-area: 1 / 1; justify-self: center; visibility: hidden; }
  :global(html[data-rec='ask']) .recchip .rc-ask,
  :global(html[data-rec='yes']) .recchip .rc-yes,
  :global(html[data-rec='no']) .recchip .rc-no { visibility: visible; }
  .rdot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 5px;
    background: var(--signal);
    box-shadow: 0 0 8px var(--signal);
  }
  .rdot.off { background: transparent; border: 1.5px solid var(--text-dim); box-shadow: none; }
  /* beside ▸ OPS (below 1280): the same size as it, so "OFF" goes and ○ says it */
  @media (max-width: 1279px) {
    .recchip { padding: 4px 9px; border-radius: 5px; }
    .recchip .rcoff { display: none; }
  }
  /* phones: the chip keeps only its mark, ? until an answer, then ● or ○ (its aria-label says the rest) */
  @media (max-width: 500px) {
    .recchip { padding: 4px 6px; }
    .recchip .rcw { display: none; }
    .recchip .rdot { margin-right: 0; }
  }
  :global(html[data-rec='ask']) .recchip { animation: rec-breathe 2.4s ease-in-out infinite; }
  @keyframes rec-breathe { 50% { box-shadow: 0 0 0 1px var(--signal); } }

  /* The operator floats: fixed, so no card moves and the page height stays. It is up while there's
     no answer, and again when the chip reopens it (.open). After an answer it leaves (.leave), then
     display:none. On the DUO dock's layer (.pfdock).
     PATCH: under the REC chip, right edges lined up. analytics.js measures --ar; 252px is what it
     measures at every PATCH width, so there's no jump before it runs. */
  .rec-op {
    display: none;
    position: fixed;
    top: calc(var(--nav-height) + 12px);
    right: var(--ar, 252px);
    width: 300px;
    z-index: 80;
    background: var(--bg-elevated);
    border: 1px solid #2a2a2e;
    border-radius: var(--radius-md);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
    transition: box-shadow 0.3s;
    text-align: left;
  }
  :global(html[data-rec='ask']) .rec-op,
  .rec-op.open,
  .rec-op.leave { display: block; }
  .rec-head {
    display: flex; justify-content: space-between; align-items: center; gap: 14px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .rec-st { color: var(--text-dim); }
  .rec-st > span { display: none; }
  :global(html[data-rec='ask']) .rec-st .rs-ask,
  :global(html[data-rec='yes']) .rec-st .rs-yes,
  :global(html[data-rec='no']) .rec-st .rs-no { display: inline; }
  .rec-typ { font-size: 9px; padding: 1px 6px; border-radius: 3px; font-weight: 700; background: var(--op-sys-bg); color: var(--op-sys-fg); }
  /* the accent follows the visitor's palette; the text stays near-black on it */
  .rec-body { padding: 12px 14px; background: var(--signal); color: #0a0a0b; border-radius: 0 0 var(--radius-md) var(--radius-md); }
  .rec-copy { margin: 0 0 10px; font-size: 13px; line-height: 1.55; font-weight: 500; }
  .rec-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .rec-btn {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    padding: 4px 9px;
    border-radius: 4px;
    background: var(--bg) !important;
  }
  .rec-btn:hover { background: color-mix(in srgb, var(--signal) 12%, var(--bg)) !important; box-shadow: none; }
  .rec-btn:focus-visible { outline: 2px solid #0a0a0b; outline-offset: 2px; }
  /* reopened: the current answer is ticked */
  :global(html[data-rec='yes']) .rec-op.anchored [data-rec-a='yes']::after,
  :global(html[data-rec='no']) .rec-op.anchored [data-rec-a='no']::after { content: ' ✓'; }
  .rec-row a { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; color: rgba(10, 10, 11, 0.7); text-decoration: none; margin-left: auto; }
  .rec-row a:hover { color: #0a0a0b; text-decoration: underline; }

  /* Enter (first load): fades in toward its place, down from the top in PATCH, up from the bottom in
     READ. Hidden until analytics.js brings it in (.in), so it never shows before its buttons work.
     Leave: drop and fade. Arrive (reopened): drop in from the chip. Only translate and opacity move. */
  :global(html[data-rec='ask']) .rec-op:not(.in) { visibility: hidden; }
  .rec-op.enter { animation: rec-enter-down 220ms cubic-bezier(0, 0, 0.2, 1) both; }
  :global(body.perform) .rec-op.enter { animation-name: rec-enter-up; }
  @keyframes rec-enter-down { from { translate: 0 -16px; opacity: 0; } }
  @keyframes rec-enter-up { from { translate: 0 16px; opacity: 0; } }
  .rec-op.leave { animation: rec-leave 220ms cubic-bezier(0.4, 0, 1, 1) forwards; }
  .rec-op.arrive { animation: rec-arrive 200ms cubic-bezier(0, 0, 0.2, 1) forwards; }
  .rec-op.enter, .rec-op.leave, .rec-op.arrive { pointer-events: none; will-change: translate, opacity; }
  @keyframes rec-leave { to { translate: 0 16px; opacity: 0; } }
  @keyframes rec-arrive { from { translate: 0 -8px; opacity: 0; } }
  .rec-op.nudge { box-shadow: 0 0 0 2px var(--signal), 0 18px 50px rgba(0, 0, 0, 0.6); }

  /* READ: at the bottom, in the reading column. Reopened from the chip (.anchored), under the chip. */
  :global(body.perform) .rec-op { top: auto; bottom: calc(var(--playbar-height) + 16px); left: 0; right: 0; margin-inline: auto; width: min(600px, calc(100% - 32px)); }
  :global(body.perform) .rec-op.anchored { top: calc(var(--nav-height) + 12px); bottom: auto; left: auto; right: var(--ar, 16px); width: 300px; margin: 0; }

  /* phones: the width of the screen, at the bottom, or under the nav when reopened */
  @media (max-width: 639px) {
    :global(body.perform) .rec-op,
    :global(body.perform) .rec-op.anchored { left: 12px; right: 12px; width: auto; margin: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec-op.enter, .rec-op.leave, .rec-op.arrive { animation-duration: 1ms; }
    :global(html[data-rec='ask']) .recchip { animation: none; }
  }

  .opsearch {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(10, 10, 11, 0.7);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
  }
  .opsearch-box {
    width: min(480px, 92vw);
    background: var(--bg-elevated);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .opsearch-head {
    display: flex;
    justify-content: space-between;
    padding: 7px 12px;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  .opsearch-kbd {
    border: 1px solid #2c2c30;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    font-size: 9px;
    color: var(--text-dim);
    background: transparent;
    font-family: var(--font-mono);
    cursor: pointer;
    min-width: 26px;
    min-height: 20px;
  }
  .opsearch input {
    width: 100%;
    background: var(--bg-surface);
    border: none;
    outline: none;
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
  }
  /* mobile: 16px keeps iOS from zoom-jumping when the input focuses */
  @media (max-width: 1279px) {
    .opsearch input { font-size: 16px; }
  }
  .opsearch ul { list-style: none; max-height: 42vh; overflow-y: auto; margin: 0; padding: 4px 0; }
  .opsearch li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .opsearch li[hidden] { display: none; }
  .opsearch li.sel a, .opsearch li a:hover { background: rgba(61, 255, 136, 0.07); }
  .opsearch-typ { font-size: 8.5px; font-weight: 700; padding: 1px 5px; border-radius: 3px; }
  .opsearch-typ.t-view { background: var(--op-view-bg); color: var(--op-view-fg); }
  .opsearch-typ.t-txt { background: var(--op-txt-bg); color: var(--op-txt-fg); }
  .opsearch-typ.t-data { background: var(--op-data-bg); color: var(--op-data-fg); }
  .opsearch-typ.t-sys { background: var(--op-sys-bg); color: var(--op-sys-fg); }
  .opsearch-name { color: var(--text); }
  .opsearch-path { margin-left: auto; color: var(--text-dim); font-size: 10px; }
</style>

<script is:inline>
  (function () {
    const KEY = 'patch-mode';
    const btn = document.getElementById('modeToggle');
    // The visitor's EXPLICIT choice is the only thing we persist. The mode we
    // actually render ("effective") may be forced to READ on narrow viewports
    // or for reduced motion — but that must not overwrite their preference, or
    // a transient narrow window would trap them in READ everywhere afterward.
    const readPref = () => { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
    const forced = () => window.matchMedia('(max-width: 1279px)').matches ||
                         window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const effective = () => forced() ? 'perform' : (readPref() || 'network');
    function apply(mode, persist) {
      document.body.classList.toggle('perform', mode === 'perform');
      if (btn) btn.querySelectorAll('span').forEach(s => {
        const on = s.dataset.mode === mode;
        s.classList.toggle('mode-on', on);
        s.classList.toggle('text-text-muted', !on);
      });
      if (persist) { try { localStorage.setItem(KEY, mode); } catch (e) {} }
      document.dispatchEvent(new CustomEvent('patchmode', { detail: mode }));
    }
    apply(effective(), false);
    // An explicit toggle: flip relative to the current EFFECTIVE mode and save
    // it as the new preference so it carries across every subsequent page.
    const toggle = () => {
      const next = document.body.classList.contains('perform') ? 'network' : 'perform';
      apply(next, true);
    };
    btn && btn.addEventListener('click', toggle);
    window.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() === 'p' && !e.metaKey && !e.ctrlKey &&
          !/input|textarea/i.test(document.activeElement?.tagName || '')) toggle();
    });
    // keep the effective mode correct if the window crosses the breakpoint
    window.matchMedia('(max-width: 1279px)').addEventListener?.('change', () => apply(effective(), false));

    // The header is transition:persist (kept across view-transition swaps), so
    // the active route + /network path chip must be refreshed by hand on nav.
    function updateNav() {
      const path = (location.pathname || '/').replace(/\/+$/, '') || '/';
      document.querySelectorAll('header .navlink').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
        // prefix-aware: /projects/foo lights /work, /lab/foo lights /lab
        a.classList.toggle('on', href === path || (href !== '/' && path.indexOf(href + '/') === 0));
      });
      const chip = document.querySelector('header .pathchip');
      if (chip && !typing) chip.textContent = netPath(path);
    }
    const netPath = (path) => (path === '/' ? '/network/home' : '/network' + path);

    /* The nav reports a page change. The path chip retypes to the new network path (delete back
       to the shared prefix, then type the rest), and the status chip reads COOKING until
       PatchField says the network is in ('patch:cooking' carries how long that takes).
       Under reduced motion both just switch. */
    let typing = 0, cookT = 0, cookRaf = 0;
    const STILL = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cookEl = document.querySelector('header .cook');
    const setCook = (busy) => {
      if (!cookEl) return;
      cookEl.classList.toggle('busy', busy);
      cookEl.lastChild.textContent = busy ? 'COOKING' : 'COOKED';
    };
    function typePath(to) {
      const chip = document.querySelector('header .pathchip');
      if (!chip) return;
      cancelAnimationFrame(typing); typing = 0;
      const from = chip.textContent.replace('▮', '');
      if (STILL.matches || from === to) { chip.textContent = to; return; }
      let pre = 0;
      while (pre < from.length && from[pre] === to[pre]) pre++;
      const del = from.length - pre, steps = del + to.length - pre, t0 = performance.now();
      const step = () => {
        const i = Math.floor(Math.min(1, (performance.now() - t0) / 320) * steps);
        if (i >= steps) { chip.textContent = to; typing = 0; return; }
        chip.textContent = (i < del ? from.slice(0, from.length - i) : to.slice(0, pre + i - del)) + '▮';
        typing = requestAnimationFrame(step);
      };
      typing = requestAnimationFrame(step);
    }
    if (!window.__pfNavBar) {
    window.__pfNavBar = 1;
    document.addEventListener('astro:before-preparation', (e) => {
      typePath(netPath((e.to.pathname || '/').replace(/\/+$/, '') || '/'));
      if (STILL.matches) return;
      setCook(true);
      clearTimeout(cookT);
      cookT = setTimeout(() => setCook(false), 1500); // fallback if no network reports in
    });
    document.addEventListener('patch:cooking', (e) => {
      const d = e.detail || {}, ms = d.ms || 0;
      clearTimeout(cookT); cancelAnimationFrame(cookRaf);
      setCook(true);
      if (d.boot && cookEl) { // the boot counts up: COOK 0% to 99%, then COOKED
        const t0 = performance.now();
        let shown = -1;
        const tick = () => {
          const pct = Math.floor(Math.min(0.99, (performance.now() - t0) / ms) * 100);
          if (pct !== shown) { shown = pct; cookEl.lastChild.textContent = 'COOK ' + pct + '%'; }
          cookRaf = requestAnimationFrame(tick);
        };
        tick();
      }
      cookT = setTimeout(() => { cancelAnimationFrame(cookRaf); setCook(false); }, ms);
    });
    }

    /* ---------- op-search palette ---------- */
    const pal = document.getElementById('opSearch');
    const inp = document.getElementById('opSearchInput');
    const list = document.getElementById('opSearchList');
    if (!pal || pal.dataset.init) return;
    pal.dataset.init = '1';
    let sel = 0;

    function rows() { return [...list.querySelectorAll('li:not([hidden])')]; }
    function paint() {
      rows().forEach((li, i) => li.classList.toggle('sel', i === sel));
      const cur = rows()[sel];
      cur && cur.scrollIntoView({ block: 'nearest' });
    }
    function openPal() {
      pal.hidden = false;
      inp.value = '';
      list.querySelectorAll('li').forEach((li) => (li.hidden = false));
      sel = 0; paint();
      // touch: don't auto-summon the keyboard over the list — tapping the
      // input still focuses it when the visitor wants to type a filter
      if (window.matchMedia('(hover: hover)').matches) inp.focus();
    }
    function closePal() { pal.hidden = true; inp.blur(); }

    // touch path: the ▸ OPS chip (below xl) + a tappable close chip —
    // phones have no TAB, no ⌘K, no ESC
    const opsBtn = document.getElementById('opsBtn');
    opsBtn && opsBtn.addEventListener('click', openPal);
    const closeBtn = document.getElementById('opSearchClose');
    closeBtn && closeBtn.addEventListener('click', closePal);

    window.addEventListener('keydown', (e) => {
      const inField = /input|textarea/i.test(document.activeElement?.tagName || '') &&
                      document.activeElement !== inp;
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      // TAB opens the palette in NETWORK mode only — perform mode keeps
      // native keyboard navigation untouched (accessibility first).
      const tab = e.key === 'Tab' && !e.shiftKey &&
                  !document.body.classList.contains('perform') && !inField;
      if ((cmdK || tab) && pal.hidden) { e.preventDefault(); openPal(); return; }
      if (!pal.hidden && e.key === 'Escape') { e.preventDefault(); closePal(); }
    });
    pal.addEventListener('mousedown', (e) => { if (e.target === pal) closePal(); });

    inp.addEventListener('input', () => {
      const q = inp.value.trim().toLowerCase();
      list.querySelectorAll('li').forEach((li) => {
        li.hidden = q !== '' && !li.dataset.name.includes(q) && !li.dataset.href.includes(q);
      });
      sel = 0; paint();
    });
    inp.addEventListener('keydown', (e) => {
      const r = rows();
      if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(sel + 1, r.length - 1); paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(sel - 1, 0); paint(); }
      else if (e.key === 'Enter') { e.preventDefault(); r[sel] && (location.href = r[sel].dataset.href); }
      else if (e.key === 'Tab') { e.preventDefault(); closePal(); }
    });
    document.addEventListener('astro:after-swap', () => {
      closePal();
      // body classes don't survive the view-transition swap — re-apply the
      // effective mode (which respects the saved preference), so navigating
      // from PATCH lands you in PATCH, from READ lands you in READ.
      apply(effective(), false);
      updateNav();
    });
  })();
</script>
