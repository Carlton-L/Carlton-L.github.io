---
/**
 * PrevisEngine: loads src/lib/previs.js (window.Previs), the shared project-preview engine
 * (five featured live previews + generic seeded schematics), as a cached file (src/lib/bundles.js).
 * Singleton-guarded inside the lib, so it is safe if two fields include it.
 * Must come before the page script that calls window.Previs (DOM order).
 */
import { previsSrc } from '../lib/bundles.js';
---

<script is:inline data-astro-rerun src={previsSrc}></script>
