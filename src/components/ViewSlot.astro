---
/**
 * ViewSlot: the loading contract for everything inside a VIEW operator.
 *
 *  - The content's box is its final size from the first paint. React islands are server-rendered
 *    (client:load or client:visible, never client:only), so their real markup holds the space;
 *    vanilla demos give the slot a `height` or `aspect`, and `phoneHeight` for narrow containers.
 *  - A COOKING VIEWER poster covers the content until it's ready, then fades out while the content
 *    fades in (0.3s; instant with reduced motion).
 *  - Ready means: an island inside has hydrated (default), or the content says so
 *    (`wait="event"`, then dispatch `view:ready` from inside, or call `ViewSlot.ready(el)`).
 *    After 4s it shows whatever is there, so a poster never sticks.
 *
 * Off-screen pausing is the other half of the contract: `Patch.onScreen(el, fn)` in page scripts
 * (the patch runtime), `useOnScreen(ref)` in React (`demos/_shared/useOnScreen.js`). One rule: run
 * while the element is within 200px of the viewport and the tab is visible.
 *
 *   <ViewSlot poster="COOKING VIEWER · SELF-GENERATING MAP…">
 *     <HeroMap client:load />
 *   </ViewSlot>
 *
 *   <ViewSlot poster="…" aspect="880 / 440" wait="event"> vanilla canvas </ViewSlot>
 */
interface Props {
  poster?: string;
  /** A CSS height for content that doesn't size itself (vanilla demos). */
  height?: string;
  /** A CSS aspect ratio, e.g. "880 / 440". */
  aspect?: string;
  /** Height when the slot is narrower than 720px (container query). */
  phoneHeight?: string;
  /** "island": ready when the island inside hydrates. "event": ready on `view:ready`. */
  wait?: 'island' | 'event';
  /** Background behind the poster, matching the product's own (FAST #111, Futurescaper paper). */
  bg?: string;
  /** Poster text colour for light backgrounds. */
  ink?: string;
  class?: string;
}

const {
  poster = 'COOKING VIEWER…',
  height,
  aspect,
  phoneHeight,
  wait = 'island',
  bg,
  ink,
  class: extra = '',
} = Astro.props;

const style = [
  height && `height:${height}`,
  aspect && `aspect-ratio:${aspect}`,
  phoneHeight && `--vslot-ph:${phoneHeight}`,
  bg && `--vslot-bg:${bg}`,
  ink && `--vslot-ink:${ink}`,
]
  .filter(Boolean)
  .join(';');
---

<div class:list={['vslot-wrap', extra]}>
  <div class:list={['vslot', phoneHeight && 'vslot-phone']} data-vslot data-wait={wait} style={style || undefined}>
    <div class="vslot-content"><slot /></div>
    <div class="vslot-poster" aria-hidden="true"><span class="vslot-dot"></span><span>{poster}</span></div>
  </div>
</div>

<noscript><style>.vslot-poster { display: none !important; } .vslot > .vslot-content { opacity: 1 !important; }</style></noscript>

<script>
  import { scanViewSlots } from '../lib/view-slot.js';
  scanViewSlots();
  document.addEventListener('astro:page-load', scanViewSlots);
</script>
