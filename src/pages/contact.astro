---
/**
 * Contact — a tiny network.
 * say_hi fans out cables to one DATA operator per channel.
 */
import Base from '../layouts/Base.astro';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';
import { contactLinks } from '../data/content.js';
import { getBreadcrumbJsonLd } from '../lib/seo.js';

const jsonLd = getBreadcrumbJsonLd([
  { name: 'Home', url: '/' },
  { name: 'Contact' },
]);

const channelIds = contactLinks.map((_, i) => `ctCh${i}`);
// say_hi fans out to the channels AND to the message input; the input's
// `message` out-port is a real subscription into the relay (the cable carries
// the actual submission — see the script at the bottom).
const links = [
  ...channelIds.map((id) => ['ctHi', id] as [string, string]),
  ['ctHi', 'ctMsg'] as [string, string],
  ['ctMsg:message', 'ctRelay'] as [string, string],
];

// Public endpoint of the serverless mail surface (repo: mail/, deployed on
// Vercel). The Resend API key lives there as an env var; the browser only
// ever sees this URL.
const MAIL_ENDPOINT = 'https://api.carlton.dev/api/contact';

// layout: say_hi holds the left column beside the channel stack (one row per
// channel; hi spans all but the last so the columns balance). Content mode —
// the field height is computed from the ops.
const areas = [
  ...channelIds.map((id, i) => `${i < channelIds.length - 1 ? 'hi hi hi hi hi' : '.  .  .  .  .'} . . ${id} ${id} ${id} ${id} .`),
  '. . . . . . . . . . . .',
  'msg msg msg msg msg msg . relay relay relay relay .',
].join('\n');
const layout = {
  mode: 'content',
  padTop: 48,
  tiers: [{ min: 0, cols: 12, areas }],
};
---

<Base
  title="Contact — Carlton Lindsay"
  description="Get in touch — available for design technology, creative engineering, and AI-focused frontend roles."
  jsonLd={jsonLd}
>
  <PatchField id="contactNet" links={links} density={0.3} height="640px" layout={layout} label="Contact network — press P for reading mode">
    <Operator id="ctHi" name="input · say_hi" type="txt" area="hi" nudge="0 24" ports="out">
      <h1 class="ct-h">Contact</h1>
      <p class="ct-p">
        Open to interesting roles and collaborations, especially at the
        intersection of AI, design, and hardware.
      </p>
      <span class="ct-tag">&gt; pick an output</span>
    </Operator>

    {contactLinks.map(({ label, value, href }, i) => (
      <Operator
        id={channelIds[i]}
        name={`out · ${label.toLowerCase()}`}
        type="data"
        area={channelIds[i]}
        ports="in"
      >
        <a
          class="ct-link"
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <span class="ct-label">{label}</span>
          <span class="ct-value">{value} →</span>
        </a>
      </Operator>
    ))}

    <Operator id="ctMsg" name="input · send_message" type="txt" area="msg" ports="both">
      <div class="ct-stage">
      <form class="ct-form" id="ctForm" data-endpoint={MAIL_ENDPOINT} novalidate>
        <label class="ct-f">
          <span class="ct-label">name</span>
          <input class="ct-in" name="name" type="text" autocomplete="name" maxlength="120" required />
        </label>
        <label class="ct-f">
          <span class="ct-label">email</span>
          <input class="ct-in" name="email" type="email" autocomplete="email" maxlength="254" required />
        </label>
        <label class="ct-f">
          <span class="ct-label">message</span>
          <textarea class="ct-in ct-ta" name="message" rows="5" maxlength="4000" required></textarea>
        </label>
        <!-- honeypot: invisible to people, irresistible to bots; server drops any submission that fills it -->
        <label class="ct-hp" aria-hidden="true">
          <span>website</span>
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="ct-row">
          <button class="chip chipbtn ct-send" type="submit"><span class="ct-spin" aria-hidden="true"></span><span class="ct-send-l">▶ send</span></button>
          <span class="ct-hint">a receipt lands in your inbox</span>
        </div>
      </form>
      <div class="ct-done" id="ctDone" hidden>
        <p class="ct-done-h" id="ctDoneH">sent ✓</p>
        <p class="ct-done-p" id="ctDoneP">Thanks. It's in my inbox and a receipt is on its way to yours.</p>
        <button class="chip chipbtn" type="button" id="ctAgain">▶ send another</button>
      </div>
      </div>
    </Operator>

    <Operator id="ctRelay" name="sys · resend_relay" type="sys" area="relay" ports="in">
      <pre class="ct-log" id="ctLog" aria-live="polite">state    idle
via      resend api · eu-west-1
receipt  reports on send
</pre>
    </Operator>
  </PatchField>
</Base>

<script is:inline data-astro-rerun>
(function () {
  const form = document.getElementById('ctForm');
  if (!form || form.dataset.init) return;
  form.dataset.init = '1';
  const log = document.getElementById('ctLog');
  const relayOp = document.getElementById('ctRelay');
  const msgOp = document.getElementById('ctMsg');
  const done = document.getElementById('ctDone');
  const doneH = document.getElementById('ctDoneH');
  const doneP = document.getElementById('ctDoneP');
  const again = document.getElementById('ctAgain');
  const btn = form.querySelector('.ct-send');
  const endpoint = form.dataset.endpoint;
  const statusUrl = endpoint.replace(/\/contact$/, '/status');
  const IDLE = [['state', 'idle'], ['via', 'resend api · eu-west-1'], ['receipt', 'reports on send']];

  /* ---- the network: send_message ─message→ resend_relay ----
     Submitting emits on the message port; the runtime routes it along the
     cable (pulse) into the relay's in-port, which does the fetch. Under
     ?nopatch=1 the stub path calls the relay directly. */
  const net = window.Patch ? window.Patch.field('contactNet') : null;
  const LIVE = !!(net && !net.stub);
  const NOOP = function () {};
  const N = (id, spec) => (net ? net.node(id, spec) : { el: null, emit: NOOP, every: NOOP, timeout: NOOP, observe: NOOP, listen: NOOP, cleanup: NOOP });

  const line = (k, v) => k.padEnd(9) + v;
  /* readout lines never wrap (op height is fixed); long addresses get a middle ellipsis */
  const short = (email, max) => {
    max = max || 22;
    if (!email || email.length <= max) return email;
    const at = email.lastIndexOf('@');
    if (at < 0) return email.slice(0, max - 1) + '…';
    const dom = email.slice(at), keep = Math.max(3, max - dom.length - 1);
    return email.slice(0, keep) + '…' + dom;
  };
  /* readout is always 4 lines so the op never changes height between states */
  const show = (rows) => { if (!log) return; const r = rows.slice(0, 4); while (r.length < 4) r.push(['', '']); log.textContent = r.map((x) => line(x[0], x[1])).join('\n') + '\n'; };
  const glow = () => { if (!relayOp) return; relayOp.classList.add('cooking'); relay.timeout(600, () => relayOp.classList.remove('cooking')); };

  let busy = false;
  const setBusy = (on) => {
    busy = on;
    form.classList.toggle('busy', on);
    if (btn) btn.disabled = on;
    form.querySelectorAll('.ct-in').forEach((el) => { el.disabled = on; });
  };
  /* ---- receipt tracking: poll /api/status for the auto-reply's last_event.
          Hard bounces (typo'd address) usually come back within seconds because
          the receiving server refuses during the SMTP conversation itself.
          Vocabulary: "accepted" = their server took it (SMTP 250), never "in inbox". ---- */
  let pollGen = 0, sentRows = null;
  const receiptLine = (v) => { if (!sentRows) return; sentRows[2] = ['receipt', v]; show(sentRows); };
  const track = (id, email) => {
    const gen = ++pollGen;
    const t0 = Date.now();
    const tick = async () => {
      if (gen !== pollGen) return;
      let ev = null;
      try { const r = await fetch(statusUrl + '?id=' + encodeURIComponent(id)); const j = await r.json(); ev = j.last_event || null; } catch (e) {}
      if (gen !== pollGen) return;
      if (ev === 'delivered') { receiptLine('accepted by their server ✓'); return; }
      if (ev === 'bounced' || ev === 'failed' || ev === 'suppressed') {
        receiptLine('bounced ✗ · check the address');
        if (doneH) doneH.textContent = 'sent ✓ · receipt bounced';
        if (doneP) doneP.textContent = 'Your message reached me, but the receipt to ' + email + ' bounced. If that address has a typo, send again with the right one so I can reply.';
        return;
      }
      if (ev === 'delivery_delayed') receiptLine('delayed · their server is slow');
      if (Date.now() - t0 < 45000) relay.timeout(3000, tick); else receiptLine('queued · no word yet');
    };
    relay.timeout(2500, tick);
  };

  const reset = () => {
    pollGen++; sentRows = null;
    if (doneH) doneH.textContent = 'sent ✓';
    if (doneP) doneP.textContent = "Thanks. It's in my inbox and a receipt is on its way to yours.";
    form.reset();
    form.querySelectorAll('.ct-in').forEach((el) => el.classList.remove('bad'));
    form.classList.remove('sent');
    form.removeAttribute('inert');
    if (done) done.hidden = true;
    show(IDLE);
    form.querySelector('[name="name"]') && form.querySelector('[name="name"]').focus();
  };
  const deliver = async (p) => {
    if (busy) return;
    setBusy(true);
    form.querySelectorAll('.ct-in').forEach((el) => el.classList.remove('bad'));
    show([['state', 'cooking ⟳'], ['call', 'POST /api/contact'], ['reply_to', short(p.email)], ['field', p.bg ? 'snapshot attached' : 'default']]);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(p),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (j.field) { const f = form.querySelector('[name="' + j.field + '"]'); f && f.classList.add('bad'); f && f.focus(); }
        show([['state', 'error ' + res.status], ['msg', j.error || 'send failed'], ['reply_to', short(p.email)]]);
      } else {
        glow();
        sentRows = [['state', 'sent ✓'], ['id', (j.id || '').slice(0, 8) + '…'], ['receipt', j.ack ? 'queued → ' + short(p.email) : 'off'], ['next', 'I read everything.']];
        show(sentRows);
        if (j.ack) track(j.ack, p.email);
        /* overlay the sent panel; the form keeps its size underneath so the op (and the dither gutter behind it) never reflows */
        form.classList.add('sent');
        form.setAttribute('inert', '');
        if (done) { done.hidden = false; again && again.focus(); }
      }
    } catch (e) {
      show([['state', 'error'], ['msg', 'network, try the email link'], ['reply_to', short(p.email)]]);
    }
    setBusy(false);
  };

  /* ---- field snapshot: one still frame of the visitor's dither field, with
          THEIR patch-bg settings, as a small PNG. Rides along with the message
          and becomes the inline background of both emails (cid:patchbg). A
          port of PatchField's pass minus heat/feedback; never blocks a send. ---- */
  const PALS = [['GRN', '#233b2c', '#3dff88'], ['AMB', '#3a2c14', '#e8a317'], ['CYN', '#15303d', '#56b4e9'], ['MONO', '#26262a', '#9f9f98']];
  const NOISE = ['FBM', 'RIDGE', 'PLASMA'], DITH = ['BAYER4', 'BAYER2', 'SCAN', 'STATIC'];
  const B4 = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]], B2 = [[0, 2], [3, 1]];
  const snapshot = () => {
    try {
      const P = { density: 0.77, scale: 3, pal: 0, noiseT: 1, ditherT: 1 };
      let saved = {};
      try { saved = JSON.parse(localStorage.getItem('patch-bg') || '{}') || {}; } catch (e) {}
      Object.keys(P).forEach((k) => { if (typeof saved[k] === 'number' && isFinite(saved[k])) P[k] = saved[k]; });
      P.pal = ((P.pal % 4) + 4) % 4; P.noiseT = ((P.noiseT | 0) % 3 + 3) % 3; P.ditherT = ((P.ditherT | 0) % 4 + 4) % 4;
      const s = Math.max(2, Math.min(6, Math.round(P.scale)));
      const pal = PALS[P.pal];
      const field = pal[0] + ' · ' + NOISE[P.noiseT] + ' · ' + DITH[P.ditherT] + ' · density ' + (+P.density).toFixed(2);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return { field };
      const W = 600, H = 320, FW = Math.ceil(W / s), FH = Math.ceil(H / s);
      const oc = document.createElement('canvas'); oc.width = FW; oc.height = FH;
      const octx = oc.getContext('2d'); if (!octx) return { field };
      const img = octx.createImageData(FW, FH), d = img.data;
      const h2 = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
      const [br, bgc, bb] = h2(pal[1]), [hr, hg, hb] = h2(pal[2]);
      const seed = (Date.now() / 1000) | 0;
      const hash = (x, y, z) => { let h = (x * 374761393 + y * 668265263 + z * 982451653) | 0; h = Math.imul(h ^ (h >>> 13), 1274126177); return ((h ^ (h >>> 16)) >>> 0) / 4294967296; };
      const sm = (t) => t * t * (3 - 2 * t);
      const vn = (x, y, z) => { const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi; const a = hash(xi, yi, z), b = hash(xi + 1, yi, z), c = hash(xi, yi + 1, z), e = hash(xi + 1, yi + 1, z); const u = sm(xf), v = sm(yf); return a + (b - a) * u + (c - a) * v + (a - b - c + e) * u * v; };
      const f1 = 0.012 * s, f2 = 0.027 * s, t = (seed % 1000) * 0.37;
      for (let gy = 0; gy < FH; gy++) for (let gx = 0; gx < FW; gx++) {
        const px = gx * s, py = gy * s; let n;
        if (P.noiseT === 2) { n = 0.5 + (Math.sin(px * 0.018 + t * 1.2) + Math.sin(py * 0.023 - t * 0.8) + Math.sin((px + py) * 0.011 + t * 0.5)) / 6; n = Math.max(0, (n - 0.35) * 1.6); }
        else { let n1 = vn(gx * f1 + t * 0.55, gy * f1 + t * 0.18, seed), n2 = vn(gx * f2 - t * 0.35 + 40.7, gy * f2 + 11.3, seed + 7); if (P.noiseT === 1) { n1 = 1 - Math.abs(2 * n1 - 1); n2 = 1 - Math.abs(2 * n2 - 1); n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.45) * 1.7); } else n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.32) * 1.55); }
        const L = n * P.density * 1.2; let th;
        if (P.ditherT === 1) th = (B2[gy & 1][gx & 1] + 0.5) / 4; else if (P.ditherT === 2) th = ((gy & 3) + 0.5) / 4.4; else if (P.ditherT === 3) { const hh = ((gx * 73856093) ^ (gy * 19349663)) >>> 0; th = ((hh >>> 8) & 1023) / 1024; } else th = (B4[gy & 3][gx & 3] + 0.5) / 16;
        const o = (gy * FW + gx) * 4;
        if (L > th) { const hot = L - 0.55 > th; d[o] = hot ? hr : br; d[o + 1] = hot ? hg : bgc; d[o + 2] = hot ? hb : bb; } else { d[o] = 10; d[o + 1] = 10; d[o + 2] = 11; }
        d[o + 3] = 255;
      }
      octx.putImageData(img, 0, 0);
      const c = document.createElement('canvas'); c.width = W; c.height = H;
      const ctx = c.getContext('2d'); if (!ctx) return { field };
      ctx.fillStyle = '#0a0a0b'; ctx.fillRect(0, 0, W, H); ctx.imageSmoothingEnabled = false;
      ctx.drawImage(oc, 0, 0, FW, FH, 0, 0, FW * s, FH * s);
      if (s > 2) { ctx.fillStyle = '#0a0a0b'; for (let x = s - 1; x < W; x += s) ctx.fillRect(x, 0, 1, H); for (let y = s - 1; y < H; y += s) ctx.fillRect(0, y, W, 1); }
      const b64 = c.toDataURL('image/png').split(',')[1] || '';
      return b64.length <= 90 * 1024 ? { field, bg: b64 } : { field };
    } catch (e) { return {}; }
  };

  const relay = N('ctRelay', { ins: { message: deliver } });
  const input = N('ctMsg', { outs: { message: 'object' } });

  input.listen(form, 'submit', (ev) => {
    ev.preventDefault();
    const fd = new FormData(form);
    const p = { name: String(fd.get('name') || '').trim(), email: String(fd.get('email') || '').trim(), message: String(fd.get('message') || '').trim(), website: String(fd.get('website') || '') };
    Object.assign(p, snapshot());
    /* client-side shape check mirrors the server so most mistakes never leave the page */
    const bad = !p.name ? ['name', 'name is empty']
      : !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(p.email) ? ['email', 'email does not look valid']
      : p.message.length < 10 ? ['message', 'message needs 10+ chars (' + p.message.length + ')']
      : null;
    if (bad) { const f = form.querySelector('[name="' + bad[0] + '"]'); f && f.classList.add('bad'); f && f.focus(); show([['state', 'blocked'], ['field', bad[0]], ['why', bad[1]]]); return; }
    if (LIVE) input.emit('message', p); else deliver(p);
  });
  if (again) input.listen(again, 'click', reset);
})();
</script>

<style>
  .ct-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 0.98;
    margin-bottom: 10px;
  }
  .ct-p { font-size: 13px; color: var(--text-muted); line-height: 1.65; max-width: 40ch; }
  .ct-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--signal);
    margin-top: 12px;
  }
  .ct-tag::after { content: '█'; animation: ct-blink 1.1s steps(1) infinite; margin-left: 3px; font-size: 10px; }
  @keyframes ct-blink { 50% { opacity: 0; } }

  .ct-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    text-decoration: none;
  }
  .ct-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  .ct-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
    transition: color var(--duration-fast);
    white-space: nowrap;
  }
  .ct-link:hover .ct-value { color: var(--signal); }

  /* send_message form */
  .ct-form { display: flex; flex-direction: column; gap: 10px; }
  .ct-f { display: flex; flex-direction: column; gap: 4px; }
  .ct-in {
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 7px 9px;
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
  }
  .ct-in:focus { outline: none; border-color: var(--signal); box-shadow: 0 0 0 2px var(--signal-dim); }
  .ct-in.bad { border-color: #ff5d5d; }
  .ct-ta { resize: vertical; min-height: 96px; line-height: 1.5; }
  .ct-hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .ct-row { display: flex; align-items: center; gap: 12px; margin-top: 2px; }
  .chip { border: 1px solid #2c2c30; padding: 4px 9px; border-radius: 4px; background: var(--bg-surface); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; }
  .ct-send { display: inline-flex; align-items: center; gap: 6px; }
  .ct-send:disabled { cursor: wait; opacity: 1; }
  .ct-spin {
    display: none; width: 9px; height: 9px; border-radius: 50%;
    border: 1.5px solid var(--signal-dim); border-top-color: var(--signal);
    animation: ct-spin 0.7s linear infinite;
  }
  .ct-form.busy .ct-spin { display: inline-block; }
  .ct-form.busy .ct-send-l { opacity: 0.6; }
  .ct-form.busy .ct-in { opacity: 0.55; }
  @keyframes ct-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ct-spin { animation: none; border-top-color: var(--signal-dim); } }

  .ct-stage { position: relative; }
  .ct-form.sent { visibility: hidden; }
  .ct-done {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; gap: 8px; align-items: flex-start; justify-content: center;
    background: var(--bg-elevated);
    animation: ct-in var(--duration-normal) var(--ease-out);
  }
  .ct-done[hidden] { display: none; }
  @keyframes ct-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ct-done { animation: none; } }
  .ct-done-h { font-family: var(--font-mono); font-size: 12px; color: var(--signal); }
  .ct-done-p { font-size: 13px; color: var(--text-muted); line-height: 1.6; max-width: 40ch; margin-bottom: 4px; }
  .ct-hint { font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); }

  /* resend_relay readout */
  .ct-log {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    color: var(--text-muted);
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 230px;
  }
  :global(#ctRelay.cooking) { border-color: var(--signal); box-shadow: 0 14px 50px rgba(61, 255, 136, 0.22); }
</style>
