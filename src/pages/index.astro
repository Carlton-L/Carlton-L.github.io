---
/**
 * Homepage — THE PATCH
 *
 * The homepage is a live dataflow network AND a working instrument:
 * clicking a row in work_index cooks that project's preview into the
 * VIEW operator (TouchDesigner select → viewer), the signal passing
 * through a post_fx SYS node that can INVERT the viewer's palette.
 * The dither background is generated by the visible bg_generator chain
 * with live DENSITY / SPEED / SCALE parameters.
 *
 * All patch scripts are inline vanilla JS — no React island needed here.
 */
import Base from '../layouts/Base.astro';
import { siteConfig, projects } from '../data/content.js';
import { getPersonJsonLd, getWebSiteJsonLd } from '../lib/seo.js';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';

// signal paths:
//  - bg chain: noise_src → feedback → dither → out (renders the field)
//  - content: hero → index → post_fx → viewer → readme
const links: [string, string][] = [
  ['opNoise', 'opFeedbk'],
  ['opFeedbk', 'opDither'],
  ['opDither', 'opOut'],
  ['opHero', 'opIndex'],
  ['opIndex', 'opFx'],
  ['opFx', 'opScape'],
  ['opScape', 'opRead'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [getPersonJsonLd(), getWebSiteJsonLd()],
};

// layout: fill mode — rows share the viewport-height field. The bg_generator
// chain (noise → fdbk → dith → out) arcs down-left around the hero via its
// row/col drift + nudges; the viewer holds the right block; index + readme
// anchor the bottom corners. ≥1600px the grid widens to 14 cols and everything
// gets more air. Nudges are art direction — tune by eye, not by math.
const layout = {
  mode: 'fill',
  padTop: 24,
  tiers: [
    {
      min: 0,
      cols: 12,
      areas: `
        hero  hero  hero  hero  .     noise noise view  view  view  view  view
        hero  hero  hero  hero  fdbk  fdbk  .     view  view  view  view  view
        .     .     dith  dith  .     .     .     view  view  view  view  view
        .     out   out   .     .     .     .     view  view  view  view  view
        index index index index .     fx    .     .     .     read  read  read
        index index index index .     .     .     .     .     read  read  read
      `,
    },
    {
      min: 1600,
      cols: 14,
      areas: `
        hero  hero  hero  hero  .     noise noise .     view  view  view  view  view  .
        hero  hero  hero  hero  fdbk  fdbk  .     .     view  view  view  view  view  .
        .     .     dith  dith  .     .     .     .     view  view  view  view  view  .
        .     out   out   .     .     .     .     .     view  view  view  view  view  .
        index index index index .     fx    .     .     .     .     read  read  read  .
        index index index index .     .     .     .     .     .     read  read  read  .
      `,
    },
  ],
};

const indexRows = projects
  .filter((p) => ['futurescaper', 'futurity-engine', 'fast', 'campus-ai'].includes(p.slug))
  .map((p) => ({
    slug: p.slug,
    href: `/projects/${p.slug}`,
    name: p.slug.replace(/-/g, '_'),
    meta: p.facts?.role?.toUpperCase() ?? p.category.toUpperCase(),
    year: (p.facts?.year ?? '').split('–').pop(),
  }));

// tiny operator-glyphs per project (currentColor → inherits the row accent)
const ICONS: Record<string, string> = {
  'futurescaper': '<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="6" stroke-dasharray="1.6 1.9"/><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/><circle cx="14" cy="8" r="1" fill="currentColor" stroke="none"/><circle cx="8" cy="2" r="1" fill="currentColor" stroke="none"/></svg>',
  'futurity-engine': '<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12l4-5 3 3 3-6"/><circle cx="3" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="7" cy="7" r="1.4" fill="currentColor" stroke="none"/><circle cx="10" cy="10" r="1.4" fill="currentColor" stroke="none"/><circle cx="13" cy="4" r="1.4" fill="currentColor" stroke="none"/></svg>',
  'fast': '<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" stroke="none"><circle cx="4" cy="4" r="1"/><circle cx="6.2" cy="3" r="1"/><circle cx="3" cy="6.2" r="1"/><circle cx="12" cy="4" r="1"/><circle cx="13" cy="6.2" r="1"/><circle cx="10" cy="4" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="3" cy="10" r="1"/><circle cx="6.2" cy="13" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="13" cy="10" r="1"/><circle cx="10" cy="12" r="1"/></svg>',
  'campus-ai': '<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" stroke="none"><rect x="2" y="3" width="8" height="2" rx="1"/><rect x="2" y="7" width="12" height="2" rx="1"/><rect x="2" y="11" width="6" height="2" rx="1"/></svg>',
};
---

<Base title={siteConfig.title} description={siteConfig.description} jsonLd={jsonLd}>
  <PatchField id="net" links={links} layout={layout}>
    <Operator id="opHero" name="hero_txt" type="txt" area="hero" nudge="0 24" ports="out">
      <h1 class="hero-h">
        Designer who <span class="grn">deploys</span>.
        <span class="ghost">Engineer who dreams.</span>
      </h1>
      <span class="hero-tag">&gt; I build what I design</span>
    </Operator>

    <!-- the work rack: viewer + index are one unit in READ mode (player/playlist);
         display:contents in PATCH mode so both ops stay free-floating on the canvas -->
    <div class="rack" data-rack="work">
      <Operator id="opScape" name="futurescaper_view · live_map" type="view" area="view" nudge="0 48" maxw={640}>
        <div class="viewer-wrap">
          <div class="viewer-stage">
            <svg class="viewer" id="viewerSvg" viewBox="0 0 420 240" role="img" aria-label="Futurescaper self-generating consequence map, live synthetic demo"></svg>
            <canvas class="viewer-dither" id="viewerDither" aria-hidden="true"></canvas>
          </div>
          <div class="vfoot">
            <span id="viewerFoot">SELF-GENERATING · STEEPLE · METRO EDGES</span>
            <a id="viewerOpen" href="/projects/futurescaper"><b>OPEN NETWORK →</b></a>
          </div>
        </div>
      </Operator>

      <Operator id="opIndex" name="work_index · preview · open" type="data" area="index">
        <div class="idx" id="workIndex">
          {indexRows.map((r, i) => (
            <a href={r.href} data-slug={r.slug} class:list={['idxrow', { sel: i === 0 }]} title="Preview in the viewer · select again to open the case study">
              <span class="idxnum">{String(i + 1).padStart(2, '0')}</span>
              <span class="idxicon" set:html={ICONS[r.slug]} />
              <span class="idxmain">
                <span class="idxname">{r.name}</span>
                <span class="idxmeta">{r.meta}</span>
              </span>
              <span class="idxyear">{r.year}</span>
              <span class="idxgo" aria-hidden="true">OPEN ↗</span>
            </a>
          ))}
        </div>
      </Operator>
    </div>

    <Operator id="opFx" name="post_fx" type="sys" area="fx" fit="auto" nudge="0 96">
      <div class="chain">
        <span class="chip">IN</span><span class="arr">▶</span>
        <button id="invertBtn" class="chip chipbtn" aria-pressed="false">INVERT</button>
        <span class="arr">▶</span><span class="chip">OUT</span>
      </div>
    </Operator>

    <Operator id="opRead" name="readme_txt" type="txt" area="read" nudge="0 12">
      <div class="readme">
        <span class="k">## about</span><br />
        10 yrs in hardware labs (incl. Apple Vision Pro) → Master's in interaction
        design, Barcelona → Design Engineer at Futurity Systems, building AI
        research instruments.<br />
        <span class="k">## wiring</span><br />
        Every case study here is itself a network. <a href="/about">Follow the cables.</a>
      </div>
    </Operator>

    <!-- the background generator: a tight, compact chain arcing around the
         hero card's bottom-right corner (01 top-right → 04 below-left) -->
    <Operator id="opNoise" name="bg_01 · noise_src" type="sys" area="noise" maxw={170} nudge="24 48" ports="out">
      <button class="chip chipbtn" data-cycle="noise" data-prefix="TYPE" title="Click: cycle noise type">TYPE ▸ RIDGE</button>
      <div class="prow">
        <span class="plab">SPEED</span>
        <input class="prange" type="range" data-param="speed" data-div="100" min="0" max="300" value="100" aria-label="Noise drift speed" />
        <b class="pval" data-out="speed">1.00</b>
      </div>
    </Operator>

    <Operator id="opFeedbk" name="bg_02 · feedback" type="sys" area="fdbk" maxw={160} nudge="0 24">
      <div class="prow">
        <span class="plab">FDBK</span>
        <input class="prange" type="range" data-param="feedback" data-div="100" min="0" max="95" value="78" aria-label="Feedback amount — higher leaves longer cursor trails" />
        <b class="pval" data-out="feedback">0.78</b>
      </div>
      <div class="genhint">CURSOR PAINTS THE FIELD ▚</div>
    </Operator>

    <Operator id="opDither" name="bg_03 · dither" type="sys" area="dith" maxw={180} nudge="12 24">
      <button class="chip chipbtn" data-cycle="dither" data-prefix="TYPE" title="Click: cycle dither pattern">TYPE ▸ BAYER2</button>
      <div class="prow">
        <span class="plab">DENS</span>
        <input class="prange" type="range" data-param="density" data-div="100" min="5" max="95" value="77" aria-label="Dither density" />
        <b class="pval" data-out="density">0.77</b>
      </div>
      <div class="prow">
        <span class="plab">SCALE</span>
        <input class="prange" type="range" data-param="scale" min="2" max="8" value="3" aria-label="Dither cell scale" />
        <b class="pval" data-out="scale">3</b>
      </div>
    </Operator>

    <Operator id="opOut" name="bg_04 · out" type="sys" area="out" maxw={160} nudge="0 -24" ports="in">
      <button class="chip chipbtn" data-cycle="palette" data-prefix="PAL" title="Click: cycle output palette">PAL ▸ GRN</button>
      <div class="genhint">RENDERS THE PAGE ▚</div>
    </Operator>
  </PatchField>
</Base>

<style>
  .hero-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 0.97;
    letter-spacing: -0.01em;
  }
  .hero-h .grn { color: var(--signal); }
  /* ghost line: signal outline (same hue as "deploys"), pitch-black fill */
  .hero-h .ghost { color: #000; -webkit-text-stroke: 1.3px var(--signal); }
  .hero-tag { font-family: var(--font-mono); font-size: 11.5px; color: var(--signal); margin-top: 12px; display: block; }
  .hero-tag::after { content: '█'; animation: blink 1.1s steps(1) infinite; margin-left: 3px; font-size: 10px; }
  @keyframes blink { 50% { opacity: 0; } }

  .viewer-wrap { margin: -12px -14px; }
  .viewer-stage { position: relative; font-size: 0; }
  .viewer { display: block; background: var(--paper); width: 100%; height: auto; transition: background 300ms var(--ease-out); }
  .viewer-dither { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; image-rendering: pixelated; }
  .vfoot {
    display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono); font-size: 9.5px; color: var(--text-dim);
  }
  .vfoot a { text-decoration: none; white-space: nowrap; }
  .vfoot b { color: var(--signal); font-weight: 400; }

  /* cook flash when a new preview lands in the viewer */
  :global(#opScape.cooking) { border-color: var(--signal); box-shadow: 0 14px 50px rgba(61, 255, 136, 0.22); }

  .idx { display: flex; flex-direction: column; gap: 4px; margin: -4px -6px; }
  .idxrow {
    display: flex; align-items: center; gap: 11px;
    padding: 9px 11px; border-radius: 7px;
    border: 1px solid transparent;
    text-decoration: none; color: var(--text);
    font-family: var(--font-mono);
    transition: background var(--duration-fast), border-color var(--duration-fast);
  }
  .idxnum { font-size: 9px; color: var(--text-dim); width: 15px; flex: none; letter-spacing: 0.04em; }
  .idxicon { display: inline-flex; color: var(--text-muted); flex: none; transition: color var(--duration-fast); }
  .idxmain { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .idxname { font-size: 13px; font-weight: 500; letter-spacing: 0.02em; white-space: nowrap; }
  .idxname::before { content: '▸ '; color: var(--signal-dim); }
  .idxmeta { font-size: 8.5px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: uppercase; letter-spacing: 0.06em; }
  .idxyear { font-size: 10px; color: var(--text-dim); flex: none; font-variant-numeric: tabular-nums; }
  .idxgo { font-size: 8px; letter-spacing: 0.09em; color: var(--signal); opacity: 0; flex: none; width: 40px; text-align: right; transition: opacity var(--duration-fast); }
  .idxrow:hover, .idxrow.sel { background: color-mix(in srgb, var(--signal) 7%, transparent); border-color: var(--border-color); }
  .idxrow:hover { border-color: var(--border-hover); }
  .idxrow:hover .idxname, .idxrow.sel .idxname { color: var(--signal); }
  .idxrow:hover .idxicon, .idxrow.sel .idxicon { color: var(--signal); }
  .idxrow:hover .idxgo { opacity: 1; }
  /* the selected row always shows its OPEN affordance — on touch it's the
     "tap again" cue, on hover devices it matches the hover reveal anyway */
  .idxrow.sel .idxgo { opacity: 1; }
  .idxrow.sel { box-shadow: inset 2px 0 0 var(--signal); }
  .idxrow:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }

  .readme { font-family: var(--font-mono); font-size: 11px; line-height: 1.8; color: var(--text-muted); }
  .readme .k { color: var(--signal); }
  .readme a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .readme a:hover { color: var(--signal); }

  /* READ mode: open up the dense mono blocks for actual reading */
  :global(body.perform) .readme { font-size: 13.5px; line-height: 1.9; max-width: 62ch; }
  :global(body.perform) .idx { font-size: 13px; }
  :global(body.perform) .hero-tag { font-size: 13px; }

  /* ---- the work rack ----
     PATCH mode: the wrapper doesn't exist layout-wise — both ops float free. */
  .rack { display: contents; }

  /* READ narrow (default): player/playlist. The viewer sticks under the nav
     as a chromed panel; the index scrolls beneath it, so a selection always
     cooks a viewer that's on screen. */
  :global(body.perform) .rack {
    display: block;
    max-width: 860px;
    margin: 0 auto 40px;
    text-align: left;
  }
  :global(body.perform) .rack :global(.op) { margin: 0 0 18px; max-width: none; }
  :global(body.perform) .rack :global(#opScape) {
    position: sticky !important;
    max-width: none;
    top: calc(var(--nav-height) + 10px);
    z-index: 40; /* above sibling ops, well under the nav (90) */
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.55);
  }
  :global(body.perform) .rack :global(#opScape .ohead) { padding: 6px 10px; margin-bottom: 0; }
  :global(body.perform) .rack :global(#opScape .obody) { padding: 0; }
  :global(body.perform) .rack .viewer-wrap { margin: 0; }

  /* READ wide (≥880px): two-up rack — index as a playlist column beside the
     viewer, both fully visible. Sticky no longer needed. */
  @media (min-width: 880px) {
    :global(body.perform) .rack {
      display: grid;
      grid-template-columns: minmax(300px, 340px) minmax(0, 1fr);
      gap: 18px;
      align-items: start;
      max-width: 1080px;
    }
    :global(body.perform) .rack :global(#opIndex) { grid-column: 1; grid-row: 1; margin: 0; }
    :global(body.perform) .rack :global(#opScape) { grid-column: 2; grid-row: 1; position: static !important; margin: 0; }
  }

  .chain { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9px; color: var(--text-muted); }
  .chip { border: 1px solid #2c2c30; padding: 3px 7px; border-radius: 4px; background: var(--bg-surface); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.04em; }
  .arr { color: var(--signal-dim); }

  .prow { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-family: var(--font-mono); min-width: 0; }
  .plab { font-size: 8.5px; color: var(--text-dim); width: 34px; flex: none; }
  .prow input { flex: 1; min-width: 0; width: 100%; }
  .pval { font-size: 8.5px; color: var(--signal); font-weight: 400; width: 26px; flex: none; text-align: right; }
  .genhint { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.12em; color: var(--text-dim); margin-top: 9px; white-space: nowrap; }

  /* bg_generator nodes are secondary instruments — keep them compact so the
     dither field reads through and the hero/viewer stay the focus */
  :global(#opNoise .obody), :global(#opFeedbk .obody),
  :global(#opDither .obody), :global(#opOut .obody) { padding: 8px 10px; }
  :global(#opNoise .ohead), :global(#opFeedbk .ohead),
  :global(#opDither .ohead), :global(#opOut .ohead) { padding: 4px 9px; font-size: 9px; }
  :global(#opNoise) .prow, :global(#opFeedbk) .prow,
  :global(#opDither) .prow, :global(#opOut) .prow { margin-top: 6px; }
</style>

<script is:inline data-astro-rerun>
(function () {
  const svg = document.getElementById('viewerSvg');
  if (!svg || svg.dataset.init) return;
  svg.dataset.init = '1';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEEP = ['#CC79A7', '#56B4E9', '#E69F00', '#009E73', '#D55E00', '#007CBF', '#F0E442'];
  const W = 420, H = 240;
  let seed = 99;
  const srnd = (s0) => { seed = s0; return () => (seed = (seed * 16807) % 2147483647) / 2147483647; };

  /* ---------- shared helpers: dither transition + octilinear edge ---------- */
  const TRANS = 0.44; // seconds — dithered dissolve when a new preview cooks in
  const BAYER = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]];
  const PAL_HOT = ['#3dff88', '#e8a317', '#56b4e9', '#9f9f98']; // GRN / AMB / CYN / MONO
  const PAL_BASE = ['#233b2c', '#3a2c14', '#15303d', '#26262a']; // quiet tone per palette (matches bg)
  let transSeed = 0.137; // re-rolled per transition so the grain is never identical
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function octi(sx, sy, tx, ty, stub) {
    stub = stub || 14;
    const ax = sx + stub, bx = tx - stub, dx = bx - ax, dy = ty - sy;
    const adx = Math.abs(dx), ady = Math.abs(dy), gx = Math.sign(dx) || 1, gy = Math.sign(dy) || 1;
    const pts = [[sx, sy], [ax, sy]];
    if (adx >= ady) pts.push([bx - gx * ady, sy]); else pts.push([ax + gx * adx, sy + gy * adx]);
    pts.push([bx, ty], [tx, ty]);
    return 'M ' + pts.map((p) => p[0] + ' ' + p[1]).join(' L ');
  }
  // read the visitor's live bg_generator settings so the transition matches
  function bgSettings() {
    let s = {};
    try { s = JSON.parse(localStorage.getItem('patch-bg') || '{}') || {}; } catch (e) {}
    return {
      pal: (((s.pal | 0) % 4) + 4) % 4,
      ditherT: (((s.ditherT | 0) % 4) + 4) % 4,
      noiseT: (typeof s.noiseT === 'number' ? (((s.noiseT % 3) + 3) % 3) : 1), // default RIDGE
      scale: (typeof s.scale === 'number' ? s.scale : 3),
    };
  }
  function hash01(x, y, s) { const h = ((x * 73856093) ^ (y * 19349663) ^ (((s * 1013) | 0) * 83492791)) >>> 0; return ((h >>> 8) & 1023) / 1024; }
  // same threshold families the bg dither engine uses (0 BAYER4 · 1 BAYER2 · 2 SCAN · 3 STATIC)
  function thresh(dt, gx, gy) {
    if (dt === 1) { const B2 = [[0, 2], [3, 1]]; return (B2[gy & 1][gx & 1] + 0.5) / 4; }
    if (dt === 2) return ((gy & 3) + 0.5) / 4.4;
    if (dt === 3) { const h = ((gx * 73856093) ^ (gy * 19349663)) >>> 0; return ((h >>> 8) & 1023) / 1024; }
    return (BAYER[gy & 3][gx & 3] + 0.5) / 16;
  }
  // compact value-noise so the dissolve SHAPE can follow the bg noise type
  const _perm = (function () {
    const p = new Uint8Array(512), a = []; for (let i = 0; i < 256; i++) a[i] = i;
    let sd = 1337; const r = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
    for (let i = 255; i > 0; i--) { const j = (r() * (i + 1)) | 0, t = a[i]; a[i] = a[j]; a[j] = t; }
    for (let i = 0; i < 512; i++) p[i] = a[i & 255]; return p;
  })();
  const _fade = (x) => x * x * (3 - 2 * x);
  function _vn(x, y) {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi, X = xi & 255, Y = yi & 255;
    const a = _perm[_perm[X] + Y] / 255, b = _perm[_perm[X + 1] + Y] / 255, c = _perm[_perm[X] + Y + 1] / 255, d = _perm[_perm[X + 1] + Y + 1] / 255;
    const u = _fade(xf), v = _fade(yf), l1 = a + (b - a) * u, l2 = c + (d - c) * u; return l1 + (l2 - l1) * v;
  }
  function noiseShape(nt, gx, gy) {
    const o = transSeed * 12; // shift the field each transition
    if (nt === 2) { const n = 0.5 + (Math.sin((gx + o) * 0.05) + Math.sin(gy * 0.06 - o) + Math.sin((gx + gy) * 0.03)) / 6; return Math.max(0, Math.min(1, (n - 0.2) * 1.5)); }
    let n1 = _vn(gx * 0.055 + o, gy * 0.055), n2 = _vn(gx * 0.12 - 7.7, gy * 0.12 + 3.1);
    if (nt === 1) { n1 = 1 - Math.abs(2 * n1 - 1); n2 = 1 - Math.abs(2 * n2 - 1); return Math.max(0, Math.min(1, (0.62 * n1 + 0.38 * n2 - 0.15) * 1.5)); }
    return Math.max(0, Math.min(1, (0.62 * n1 + 0.38 * n2) * 1.05));
  }
