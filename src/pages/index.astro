---
/**
 * Homepage — THE PATCH
 *
 * The homepage is a live dataflow network AND a working instrument:
 * clicking a row in work_index cooks that project's preview into the
 * VIEW operator (TouchDesigner select → viewer), the signal passing
 * through a post_fx SYS node that can INVERT the viewer's palette.
 * The dither background is generated by the visible bg_generator chain
 * with live DENSITY / SPEED / SCALE parameters.
 *
 * All patch scripts are inline vanilla JS — no React island needed here.
 */
import Base from '../layouts/Base.astro';
import { siteConfig, projects } from '../data/content.js';
import { getPersonJsonLd, getWebSiteJsonLd } from '../lib/seo.js';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';

// signal paths:
//  - bg chain: noise_src → feedback → dither → out (renders the field)
//  - content: hero → index → post_fx → viewer → readme
const links: [string, string][] = [
  ['opNoise', 'opFeedbk'],
  ['opFeedbk', 'opDither'],
  ['opDither', 'opOut'],
  ['opHero', 'opIndex'],
  ['opIndex', 'opFx'],
  ['opFx', 'opScape'],
  ['opScape', 'opRead'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [getPersonJsonLd(), getWebSiteJsonLd()],
};

const indexRows = projects
  .filter((p) => ['futurescaper', 'futurity-engine', 'fast', 'campus-ai'].includes(p.slug))
  .map((p) => ({
    slug: p.slug,
    href: `/projects/${p.slug}`,
    name: p.slug.replace(/-/g, '_'),
    meta: p.facts?.role?.toUpperCase() ?? p.category.toUpperCase(),
    year: (p.facts?.year ?? '').split('–').pop(),
  }));
---

<Base title={siteConfig.title} description={siteConfig.description} jsonLd={jsonLd}>
  <PatchField id="net" links={links}>
    <Operator id="opHero" name="hero_txt" type="txt" pos="left:5%; top:70px; width:min(460px,86vw);" ports="out">
      <h1 class="hero-h">
        Designer who <span class="grn">deploys</span>.
        <span class="ghost">Engineer who dreams.</span>
      </h1>
      <span class="hero-tag">&gt; I build what I design</span>
    </Operator>

    <Operator id="opRead" name="readme_txt" type="txt" pos="right:9%; bottom:40px; width:min(300px,86vw);">
      <div class="readme">
        <span class="k">## about</span><br />
        10 yrs in hardware labs (incl. Apple Vision Pro) → Master's in interaction
        design, Barcelona → Design Engineer at Futurity Systems, building AI
        research instruments.<br />
        <span class="k">## wiring</span><br />
        Every case study here is itself a network. <a href="/about">Follow the cables.</a>
      </div>
    </Operator>

    <Operator id="opIndex" name="work_index · click to preview" type="data" pos="left:7%; bottom:40px;">
      <table class="idx" id="workIndex">
        {indexRows.map((r, i) => (
          <tr data-slug={r.slug} class={i === 0 ? 'sel' : ''} title="Click: preview in viewer · name: open case study">
            <td><a href={r.href}>▸ {r.name}</a></td>
            <td class="dim">{r.meta}</td>
            <td class="dim">{r.year}</td>
          </tr>
        ))}
      </table>
    </Operator>

    <Operator id="opFx" name="post_fx" type="sys" pos="left:46%; bottom:60px; width:170px;">
      <div class="chain">
        <span class="chip">IN</span><span class="arr">▶</span>
        <button id="invertBtn" class="chip chipbtn" aria-pressed="false">INVERT</button>
        <span class="arr">▶</span><span class="chip">OUT</span>
      </div>
    </Operator>

    <Operator id="opScape" name="futurescaper_view · OCEAN_PLASTICS.scn" type="view" pos="right:4%; top:120px; width:clamp(420px,38vw,560px);">
      <div class="viewer-wrap">
        <svg class="viewer" id="viewerSvg" viewBox="0 0 420 240" role="img" aria-label="Futurescaper radial consequence map, live synthetic demo"></svg>
        <div class="vfoot">
          <span id="viewerFoot">RADIAL · 5 ORDERS · STEEPLE</span>
          <a id="viewerOpen" href="/projects/futurescaper"><b>OPEN NETWORK →</b></a>
        </div>
      </div>
    </Operator>

    <!-- the background generator: a chain of ops arcing around the
         hero card's bottom-right corner (01 top-right → 04 below-left) -->
    <Operator id="opNoise" name="bg_01 · noise_src" type="sys" pos="left:42%; top:70px; width:min(185px,86vw);" ports="out">
      <button class="chip chipbtn" data-cycle="noise" data-prefix="TYPE" title="Click: cycle noise type">TYPE ▸ RIDGE</button>
      <div class="prow">
        <span class="plab">SPEED</span>
        <input class="prange" type="range" data-param="speed" data-div="100" min="0" max="300" value="100" aria-label="Noise drift speed" />
        <b class="pval" data-out="speed">1.00</b>
      </div>
    </Operator>

    <Operator id="opFeedbk" name="bg_02 · feedback" type="sys" pos="left:43%; top:255px; width:min(175px,86vw);">
      <div class="prow">
        <span class="plab">FDBK</span>
        <input class="prange" type="range" data-param="feedback" data-div="100" min="0" max="95" value="78" aria-label="Feedback amount — higher leaves longer cursor trails" />
        <b class="pval" data-out="feedback">0.78</b>
      </div>
      <div class="genhint">CURSOR PAINTS THE FIELD ▚</div>
    </Operator>

    <Operator id="opDither" name="bg_03 · dither" type="sys" pos="left:33%; top:430px; width:min(195px,86vw);">
      <button class="chip chipbtn" data-cycle="dither" data-prefix="TYPE" title="Click: cycle dither pattern">TYPE ▸ BAYER2</button>
      <div class="prow">
        <span class="plab">DENS</span>
        <input class="prange" type="range" data-param="density" data-div="100" min="5" max="95" value="77" aria-label="Dither density" />
        <b class="pval" data-out="density">0.77</b>
      </div>
      <div class="prow">
        <span class="plab">SCALE</span>
        <input class="prange" type="range" data-param="scale" min="2" max="8" value="3" aria-label="Dither cell scale" />
        <b class="pval" data-out="scale">3</b>
      </div>
    </Operator>

    <Operator id="opOut" name="bg_04 · out" type="sys" pos="left:17%; top:455px; width:min(165px,86vw);" ports="in">
      <button class="chip chipbtn" data-cycle="palette" data-prefix="PAL" title="Click: cycle output palette">PAL ▸ GRN</button>
      <div class="genhint">RENDERS THE PAGE ▚</div>
    </Operator>
  </PatchField>
</Base>

<style>
  .hero-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 0.97;
    letter-spacing: -0.01em;
  }
  .hero-h .grn { color: var(--signal); }
  /* ghost line: signal outline (same hue as "deploys"), pitch-black fill */
  .hero-h .ghost { color: #000; -webkit-text-stroke: 1.3px var(--signal); }
  .hero-tag { font-family: var(--font-mono); font-size: 11.5px; color: var(--signal); margin-top: 12px; display: block; }
  .hero-tag::after { content: '█'; animation: blink 1.1s steps(1) infinite; margin-left: 3px; font-size: 10px; }
  @keyframes blink { 50% { opacity: 0; } }

  .viewer-wrap { margin: -12px -14px; }
  .viewer { display: block; background: var(--paper); width: 100%; height: auto; transition: background 300ms var(--ease-out); }
  .vfoot {
    display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono); font-size: 9.5px; color: var(--text-dim);
  }
  .vfoot a { text-decoration: none; white-space: nowrap; }
  .vfoot b { color: var(--signal); font-weight: 400; }

  /* cook flash when a new preview lands in the viewer */
  :global(#opScape.cooking) { border-color: var(--signal); box-shadow: 0 14px 50px rgba(61, 255, 136, 0.22); }

  .idx { border-collapse: collapse; font-family: var(--font-mono); font-size: 11px; margin: -6px -8px; }
  .idx td { padding: 6px 10px; border-bottom: 1px solid var(--border-color); color: var(--text); cursor: pointer; white-space: nowrap; }
  .idx td a { color: inherit; text-decoration: none; }
  .idx tr:hover td, .idx tr:hover td a { color: var(--signal); background: rgba(61, 255, 136, 0.03); }
  .idx tr.sel td:first-child { box-shadow: inset 2px 0 0 var(--signal); }
  .idx tr.sel td, .idx tr.sel td a { color: var(--signal); }
  .idx td.dim { color: var(--text-dim); }

  .readme { font-family: var(--font-mono); font-size: 11px; line-height: 1.8; color: var(--text-muted); }
  .readme .k { color: var(--signal); }
  .readme a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .readme a:hover { color: var(--signal); }

  /* READ mode: open up the dense mono blocks for actual reading */
  :global(body.perform) .readme { font-size: 13.5px; line-height: 1.9; max-width: 62ch; }
  :global(body.perform) .idx { font-size: 13px; }
  :global(body.perform) .hero-tag { font-size: 13px; }

  .chain { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9px; color: var(--text-muted); }
  .chip { border: 1px solid #2c2c30; padding: 3px 7px; border-radius: 4px; background: var(--bg-surface); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.04em; }
  .arr { color: var(--signal-dim); }

  .prow { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-family: var(--font-mono); min-width: 0; }
  .plab { font-size: 8.5px; color: var(--text-dim); width: 34px; flex: none; }
  .prow input { flex: 1; min-width: 0; width: 100%; }
  .pval { font-size: 8.5px; color: var(--signal); font-weight: 400; width: 26px; flex: none; text-align: right; }
  .genhint { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.12em; color: var(--text-dim); margin-top: 9px; white-space: nowrap; }
</style>

<script is:inline data-astro-rerun>
(function () {
  const svg = document.getElementById('viewerSvg');
  if (!svg || svg.dataset.init) return;
  svg.dataset.init = '1';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEEP = ['#CC79A7', '#56B4E9', '#E69F00', '#009E73', '#D55E00', '#007CBF', '#F0E442'];
  const W = 420, H = 240;
  let seed = 99;
  const srnd = (s0) => { seed = s0; return () => (seed = (seed * 16807) % 2147483647) / 2147483647; };

  /* ---------- viewer: futurescaper — radial consequence map ---------- */
  function scapeInit() {
    const r = srnd(99);
    return Array.from({ length: 120 }, () => ({ order: 1 + Math.floor(r() * 5), a: r() * Math.PI * 2, c: Math.floor(r() * 7), sz: 1.8 + r() * 2.2, j: r() * 0.5 + 0.75 }));
  }
  function scapeDraw(st, ft, inv) {
    const T = REDUCED ? 1 : Math.min(1, (ft % 6.5) / 4);
    const cx = W / 2, cy = H / 2 + 6, R = H * 0.46;
    const line = inv ? '#3a382f' : '#D2CABA';
    let o = '';
    for (let k = 1; k <= 5; k++) {
      o += `<circle cx="${cx}" cy="${cy}" r="${(R * k) / 5}" fill="none" stroke="${line}" stroke-dasharray="3 5" opacity="${0.9 - k * 0.1}"/>`;
    }
    for (const p of st) {
      const prog = Math.min(1, Math.max(0, T * 5 - (p.order - 1))); if (prog <= 0) continue;
      const rr = ((R * p.order) / 5) * p.j * prog + R * 0.08;
      o += `<circle cx="${cx + Math.cos(p.a) * rr * 1.5}" cy="${cy + Math.sin(p.a) * rr * 0.8}" r="${p.sz * prog}" fill="${STEEP[p.c]}" fill-opacity=".85"/>`;
    }
    const pulse = REDUCED ? 0 : 2.5 * Math.sin(ft * 4);
    o += `<circle cx="${cx}" cy="${cy}" r="${11 + pulse}" fill="#E8A317"/><circle cx="${cx}" cy="${cy}" r="17" fill="none" stroke="#E8A317" stroke-opacity=".5"/>`;
    return o;
  }

  /* ---------- viewer: futurity_engine — graph growing from an SSE stream ---------- */
  const ENG = ['#3dff88', '#56B4E9', '#E69F00', '#CC79A7', '#009E73', '#F0E442'];
  function engInit() {
    const r = srnd(1234);
    const nodes = [{ x: W / 2, y: H / 2, c: 0, p: -1, r: 5 }];
    for (let i = 1; i < 64; i++) {
      const p = Math.max(0, i - 1 - Math.floor(r() * 8));
      const a = r() * Math.PI * 2, d = 24 + r() * 34;
      nodes.push({
        x: Math.min(W - 14, Math.max(14, nodes[p].x + Math.cos(a) * d * 1.4)),
        y: Math.min(H - 14, Math.max(14, nodes[p].y + Math.sin(a) * d)),
        c: Math.floor(r() * 6), p, r: 2 + r() * 2.2,
      });
    }
    return nodes;
  }
  function engDraw(st, ft, inv) {
    const shown = REDUCED ? st.length : Math.min(st.length, ((ft % 9) * 10));
    const edge = inv ? 'rgba(21,20,15,.2)' : 'rgba(230,230,226,.14)';
    let o = '';
    for (let i = 1; i < shown; i++) {
      const n = st[i], m = st[n.p];
      o += `<line x1="${m.x}" y1="${m.y}" x2="${n.x}" y2="${n.y}" stroke="${edge}"/>`;
    }
    for (let i = 0; i < shown; i++) {
      const n = st[i], prog = Math.min(1, shown - i);
      o += `<circle cx="${n.x}" cy="${n.y}" r="${n.r * prog}" fill="${ENG[n.c]}" fill-opacity=".9"/>`;
    }
    if (!REDUCED && shown < st.length) {
      const n = st[Math.floor(shown)];
      o += `<circle cx="${n.x}" cy="${n.y}" r="8" fill="none" stroke="#3dff88" stroke-opacity=".6"/>`;
    }
    return o;
  }

  /* ---------- viewer: fast — clustered knowledge graph w/ filter sweep ---------- */
  const FCL = ['#56B4E9', '#3dff88', '#E69F00', '#CC79A7'];
  function fastInit() {
    const r = srnd(777);
    const centers = [[104, 78], [304, 66], [140, 178], [326, 170]];
    const dots = [];
    centers.forEach(([cx, cy], c) => {
      for (let i = 0; i < 22; i++) {
        const a = r() * Math.PI * 2, d = r() * r() * 52 + 8;
        dots.push({ x: cx + Math.cos(a) * d * 1.25, y: cy + Math.sin(a) * d, c, r: 1.6 + r() * 2, ph: r() * Math.PI * 2, cx, cy });
      }
    });
    return dots;
  }
  function fastDraw(st, ft, inv) {
    const cyc = REDUCED ? 5 : Math.floor(ft / 2.2) % 6;
    const edge = inv ? 'rgba(21,20,15,1)' : 'rgba(230,230,226,1)';
    let o = '';
    for (const d of st) {
      const hot = cyc >= 4 || d.c === cyc;
      const jx = REDUCED ? 0 : Math.sin(ft * 1.3 + d.ph) * 1.6, jy = REDUCED ? 0 : Math.cos(ft * 1.1 + d.ph) * 1.6;
      o += `<line x1="${d.cx}" y1="${d.cy}" x2="${d.x + jx}" y2="${d.y + jy}" stroke="${edge}" stroke-opacity="${hot ? 0.08 : 0.02}"/>`;
      o += `<circle cx="${d.x + jx}" cy="${d.y + jy}" r="${d.r}" fill="${FCL[d.c]}" fill-opacity="${hot ? 0.9 : 0.15}"/>`;
    }
    return o;
  }

  /* ---------- viewer: campus_ai — thematic coding over transcripts ---------- */
  const THEME = ['#CC79A7', '#56B4E9', '#E69F00', '#009E73'];
  function campInit() {
    const r = srnd(2024);
    const segs = [];
    for (let row = 0; row < 9; row++) {
      let x = 22;
      while (x < 360) {
        const w = 14 + r() * 34;
        segs.push({ x, w, y: 26 + row * 22, hl: r() < 0.24 ? Math.floor(r() * 4) : -1 });
        x += w + 7;
      }
    }
    let k = 0;
    segs.forEach((s) => { if (s.hl >= 0) s.k = k++; });
    segs.total = k;
    return segs;
  }
  function campDraw(st, ft, inv) {
    const kShow = REDUCED ? st.total : Math.floor((ft % ((st.total + 10) * 0.35)) / 0.35);
    const base = inv ? '#34322a' : '#DAD3C1';
    let o = '';
    for (const s of st) {
      const lit = s.hl >= 0 && s.k < kShow;
      o += `<rect x="${s.x}" y="${s.y}" width="${s.w}" height="9" rx="2" fill="${lit ? THEME[s.hl] : base}" fill-opacity="${lit ? 0.85 : 1}"/>`;
    }
    return o;
  }

  /* ---------- viewer registry (facts: 5 phases / 42 surveys / 8 interviews are verified) ---------- */
  const V = {
    'futurescaper': { name: 'futurescaper_view · OCEAN_PLASTICS.scn', foot: 'RADIAL · 5 ORDERS · STEEPLE', aria: 'Futurescaper radial consequence map, live synthetic demo', paper: true, init: scapeInit, draw: scapeDraw },
    'futurity-engine': { name: 'futurity_engine_view · BATTERIES.scn', foot: 'SSE REPLAY · LIVE GRAPH · 5 PHASES', aria: 'Futurity Engine growing knowledge graph, live synthetic demo', paper: false, init: engInit, draw: engDraw },
    'fast': { name: 'fast_view · SYNBIO.scn', foot: 'KNOWLEDGE GRAPH · SEMANTIC TYPES', aria: 'FAST clustered knowledge graph, live synthetic demo', paper: false, init: fastInit, draw: fastDraw },
    'campus-ai': { name: 'campus_ai_view · INTERVIEWS.scn', foot: 'THEMATIC CODING · 42 SURVEYS · 8 INTERVIEWS', aria: 'Campus AI research thematic coding, live synthetic demo', paper: true, init: campInit, draw: campDraw },
  };

  const op = document.getElementById('opScape');
  const nameEl = op && op.querySelector('.oname');
  const footEl = document.getElementById('viewerFoot');
  const openEl = document.getElementById('viewerOpen');
  const invBtn = document.getElementById('invertBtn');
  let cur = 'futurescaper', inv = false, ft = 0, state = V[cur].init();

  function bg() {
    const paper = inv ? !V[cur].paper : V[cur].paper;
    svg.style.background = paper ? '#F4F1EA' : '#15140F';
  }
  function select(slug) {
    cur = slug; ft = 0; state = V[cur].init();
    if (nameEl) nameEl.textContent = V[cur].name;
    if (footEl) footEl.textContent = V[cur].foot;
    if (openEl) openEl.href = '/projects/' + slug;
    svg.setAttribute('aria-label', V[cur].aria);
    bg();
    document.querySelectorAll('#workIndex tr').forEach((tr) => tr.classList.toggle('sel', tr.dataset.slug === slug));
    if (op) { op.classList.add('cooking'); setTimeout(() => op.classList.remove('cooking'), 450); }
    if (REDUCED) svg.innerHTML = V[cur].draw(state, ft, inv);
  }

  document.querySelectorAll('#workIndex tr').forEach((tr) => {
    tr.addEventListener('click', (e) => {
      if (e.target.closest('a')) return; // name link still navigates
      select(tr.dataset.slug);
    });
  });

  invBtn && invBtn.addEventListener('click', () => {
    inv = !inv;
    invBtn.setAttribute('aria-pressed', String(inv));
    bg();
    if (REDUCED) svg.innerHTML = V[cur].draw(state, ft, inv);
  });

  bg();
  if (REDUCED) {
    svg.innerHTML = V[cur].draw(state, ft, inv);
  } else {
    let vfc = 0;
    (function frame() {
      if (!svg.isConnected) return;
      ft += 1 / 60;
      if ((vfc++ & 1) === 0) svg.innerHTML = V[cur].draw(state, ft, inv); // 30fps is plenty
      requestAnimationFrame(frame);
    })();
  }
})();
</script>
