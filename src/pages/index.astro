---
/**
 * Homepage — THE PATCH
 *
 * The homepage is a live dataflow network. Content blocks are operators
 * (see Operator.astro); cables connect them with flowing signal pulses;
 * the dither background is generated by a visible SYS operator chain.
 * PERFORM mode (P key / toggle / mobile default) stacks operators into
 * a clean readable page.
 *
 * All patch scripts are inline vanilla JS — no React island needed here.
 */
import Base from '../layouts/Base.astro';
import { siteConfig, projects } from '../data/content.js';
import { getPersonJsonLd, getWebSiteJsonLd } from '../lib/seo.js';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';

const links: [string, string][] = [
  ['opGen', 'opHero'],
  ['opHero', 'opScape'],
  ['opHero', 'opIndex'],
  ['opIndex', 'opRead'],
  ['opScape', 'opRead'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [getPersonJsonLd(), getWebSiteJsonLd()],
};

const indexRows = projects
  .filter((p) => ['futurescaper', 'futurity-engine', 'fast', 'campus-ai'].includes(p.slug))
  .map((p) => ({
    href: `/projects/${p.slug}`,
    name: p.slug.replace(/-/g, '_'),
    meta: p.facts?.role?.toUpperCase() ?? p.category.toUpperCase(),
    year: (p.facts?.year ?? '').split('–').pop(),
  }));
---

<Base title={siteConfig.title} description={siteConfig.description} jsonLd={jsonLd}>
  <PatchField id="net" links={links}>
    <Operator id="opHero" name="hero_txt" type="txt" pos="left:5%; top:70px; width:min(460px,86vw);" ports="both">
      <h1 class="hero-h">
        Designer who <span class="grn">ships</span>,
        <span class="ghost">engineer who sketches.</span>
      </h1>
      <span class="hero-tag">&gt; I make AI systems make sense</span>
    </Operator>

    <Operator id="opScape" name="futurescaper_view · OCEAN_PLASTICS.scn" type="view" pos="right:4%; top:190px; width:min(450px,90vw);">
      <div class="viewer-wrap">
        <svg class="viewer" id="miniRadial" viewBox="0 0 420 240" role="img" aria-label="Futurescaper radial consequence map, live synthetic demo"></svg>
        <div class="vfoot">
          <span>RADIAL · 5 ORDERS · STEEPLE</span>
          <a href="/projects/futurescaper"><b>OPEN NETWORK →</b></a>
        </div>
      </div>
    </Operator>

    <Operator id="opIndex" name="work_index" type="data" pos="left:7%; bottom:130px;">
      <table class="idx">
        {indexRows.map((r) => (
          <tr onclick={`location.href='${r.href}'`}>
            <td><a href={r.href}>▸ {r.name}</a></td>
            <td class="dim">{r.meta}</td>
            <td class="dim">{r.year}</td>
          </tr>
        ))}
      </table>
    </Operator>

    <Operator id="opRead" name="readme_txt" type="txt" pos="right:9%; bottom:90px; width:min(300px,86vw);">
      <div class="readme">
        <span class="k">## about</span><br />
        10 yrs hardware labs (Apple, Valve) → MFA interaction design → AI research
        instruments in Barcelona.<br />
        <span class="k">## wiring</span><br />
        Every case study here is itself a network. <a href="/about">Follow the cables.</a>
      </div>
    </Operator>

    <Operator id="opGen" name="bg_generator" type="sys" pos="left:42%; top:44px; width:290px;" ports="out">
      <div class="chain">
        <span class="chip">NOISE</span><span class="arr">▶</span>
        <span class="chip">FEEDBK</span><span class="arr">▶</span>
        <span class="chip hot">DITHER 4×4</span><span class="arr">▶</span>
        <span class="chip">OUT</span>
      </div>
      <input type="range" data-density-control min="10" max="95" value="45" aria-label="Background dither density" />
      <div class="plabel"><span>DENSITY</span><span data-density-value>0.45</span></div>
    </Operator>
  </PatchField>
</Base>

<style>
  .hero-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 0.97;
    letter-spacing: -0.01em;
  }
  .hero-h .grn { color: var(--signal); }
  .hero-h .ghost { color: transparent; -webkit-text-stroke: 1.1px #4b4b4f; }
  .hero-tag { font-family: var(--font-mono); font-size: 11.5px; color: var(--signal); margin-top: 12px; display: block; }
  .hero-tag::after { content: '█'; animation: blink 1.1s steps(1) infinite; margin-left: 3px; font-size: 10px; }
  @keyframes blink { 50% { opacity: 0; } }

  .viewer-wrap { margin: -12px -14px; }
  .viewer { display: block; background: var(--paper); width: 100%; height: auto; }
  .vfoot {
    display: flex; justify-content: space-between; padding: 6px 10px;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono); font-size: 9.5px; color: var(--text-dim);
  }
  .vfoot a { text-decoration: none; }
  .vfoot b { color: var(--signal); font-weight: 400; }

  .idx { border-collapse: collapse; font-family: var(--font-mono); font-size: 11px; margin: -6px -8px; }
  .idx td { padding: 6px 10px; border-bottom: 1px solid var(--border-color); color: var(--text); cursor: pointer; white-space: nowrap; }
  .idx td a { color: inherit; text-decoration: none; }
  .idx tr:hover td, .idx tr:hover td a { color: var(--signal); background: rgba(61, 255, 136, 0.03); }
  .idx td.dim { color: var(--text-dim); }

  .readme { font-family: var(--font-mono); font-size: 11px; line-height: 1.8; color: var(--text-muted); }
  .readme .k { color: var(--signal); }
  .readme a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .readme a:hover { color: var(--signal); }

  .chain { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9px; color: var(--text-muted); }
  .chip { border: 1px solid #2c2c30; padding: 3px 7px; border-radius: 4px; background: var(--bg-surface); }
  .chip.hot { border-color: var(--signal); color: var(--signal); }
  .arr { color: var(--signal-dim); }
  .chain + input[type='range'] { width: 100%; margin-top: 10px; accent-color: var(--signal); height: 3px; }
  .plabel { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); margin-top: 6px; }
</style>

<script is:inline data-astro-rerun>
(function () {
  /* ---------- futurescaper mini radial (real product language) ---------- */
  const STEEP = ['#CC79A7','#56B4E9','#E69F00','#009E73','#D55E00','#007CBF','#d4c83a'];
  const mini = document.getElementById('miniRadial');
  if (!mini || mini.dataset.init) return;
  mini.dataset.init = '1';
  let seed = 99; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const RN = Array.from({ length: 120 }, () => ({ order: 1 + Math.floor(rnd() * 5), a: rnd() * Math.PI * 2, c: Math.floor(rnd() * 7), sz: 1.8 + rnd() * 2.2, j: rnd() * 0.5 + 0.75 }));
  let rt = 0;
  function drawRadial() {
    rt += 0.004; if (rt > 1.7) rt = 0;
    const T = Math.min(1, rt), Wv = 420, Hv = 240, cx = Wv / 2, cy = Hv / 2 + 6, R = Hv * 0.46;
    let o = '';
    for (let k = 1; k <= 5; k++) {
      const rr = (R * k) / 5;
      o += `<circle cx="${cx}" cy="${cy}" r="${rr}" fill="none" stroke="#D2CABA" stroke-width="1" stroke-dasharray="3 5" opacity="${0.9 - k * 0.1}"/>`;
    }
    for (const p of RN) {
      const prog = Math.min(1, Math.max(0, T * 5 - (p.order - 1))); if (prog <= 0) continue;
      const rr = (R * p.order / 5) * p.j * prog + R * 0.08;
      const x = cx + Math.cos(p.a) * rr * 1.5, y = cy + Math.sin(p.a) * rr * 0.8;
      o += `<circle cx="${x}" cy="${y}" r="${p.sz * prog}" fill="${STEEP[p.c]}" fill-opacity=".85"/>`;
    }
    o += `<circle cx="${cx}" cy="${cy}" r="${11 + 2.5 * Math.sin(rt * 9)}" fill="#E8A317"/><circle cx="${cx}" cy="${cy}" r="17" fill="none" stroke="#E8A317" stroke-opacity=".5"/>`;
    mini.innerHTML = o;
  }

  /* ---------- loop ---------- */
  (function frame() {
    if (!mini.isConnected) return;
    drawRadial();
    requestAnimationFrame(frame);
  })();
})();
</script>
