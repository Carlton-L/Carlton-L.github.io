---
/**
 * Homepage — THE PATCH
 *
 * The homepage is a live dataflow network AND a working instrument:
 * clicking a row in work_index cooks that project's preview into the
 * VIEW operator (TouchDesigner select → viewer), the signal passing
 * through a post_fx SYS node that can INVERT the viewer's palette.
 * The dither background is generated by the visible bg_generator chain
 * with live DENSITY / SPEED / SCALE parameters.
 *
 * PATCH RUNTIME (P1): the behaviors are four nodes registered on the
 * runtime PatchField inlines (src/lib/patch-runtime.js) —
 *   cycle_clock ─tick→ work_index ─selection→ post_fx (filter) → futurescaper_view
 * The cables ARE the subscriptions; every delivery pulses its wire.
 * cycle_clock is the auto-cycle made visible: a SYS op whose chip dims
 * whenever the cycle is inhibited (index hover/touch/focus, viewer
 * off-screen, hidden tab, reduced motion). ?nopatch=1 kills the runtime.
 *
 * All patch scripts are inline vanilla JS — no React island needed here.
 */
import Base from '../layouts/Base.astro';
import { siteConfig, projects } from '../data/content.js';
import { getPersonJsonLd, getWebSiteJsonLd } from '../lib/seo.js';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';
import PrevisEngine from '../components/PrevisEngine.astro';

// signal paths:
//  - bg chain: noise_src → feedback → dither → out (renders the field)
//  - content: hero → index → post_fx → viewer → readme
//  - clock: cycle_clock ─tick→ work_index (auto-advances the selection)
// Ported ends ('opId:channel') are REAL routes on the patch runtime: the
// cable is the subscription, and deliveries pulse it. Portless links stay
// visual (hero/readme) or carry the emitted channel through (opFx → opScape,
// where post_fx's filter annotates the selection with INVERT).
const links: [string, string][] = [
  ['opNoise', 'opFeedbk'],
  ['opFeedbk', 'opDither'],
  ['opDither', 'opOut'],
  ['opHero', 'opIndex'],
  ['opClock:tick', 'opIndex'],
  ['opIndex:selection', 'opFx'],
  ['opFx', 'opScape'],
  ['opScape', 'opRead'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [getPersonJsonLd(), getWebSiteJsonLd()],
};

// layout: fill mode — rows share the viewport-height field. The bg_generator
// chain (noise → fdbk → dith → out) arcs down-left around the hero via its
// row/col drift + nudges; the viewer holds the right block; index + readme
// anchor the bottom corners. ≥1600px the grid widens to 14 cols and everything
// gets more air. Nudges are art direction — tune by eye, not by math.
const layout = {
  mode: 'fill',
  padTop: 24,
  tiers: [
    {
      min: 0,
      cols: 12,
      areas: `
        hero  hero  hero  hero  .     noise noise view  view  view  view  view
        hero  hero  hero  hero  fdbk  fdbk  .     view  view  view  view  view
        .     .     dith  dith  .     .     .     view  view  view  view  view
        .     out   out   .     clock .     .     view  view  view  view  view
        index index index index .     fx    .     .     .     read  read  read
        index index index index .     .     .     .     .     read  read  read
      `,
    },
    {
      min: 1600,
      cols: 14,
      areas: `
        hero  hero  hero  hero  .     noise noise .     view  view  view  view  view  .
        hero  hero  hero  hero  fdbk  fdbk  .     .     view  view  view  view  view  .
        .     .     dith  dith  .     .     .     .     view  view  view  view  view  .
        .     out   out   .     .     clock .     .     view  view  view  view  view  .
        index index index index .     fx    .     .     .     .     read  read  read  .
        index index index index .     .     .     .     .     .     read  read  read  .
      `,
    },
  ],
};

// Explicit narrative order (content.js array order is NOT the display order —
// relying on filter() once put fast first while the viewer cooked futurescaper)
const ORDER_SLUGS = ['futurescaper', 'futurity-engine', 'carlton-dev', 'fast', 'campus-ai'];
const indexRows = ORDER_SLUGS
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter(Boolean)
  .map((p) => ({
    slug: p.slug,
    href: `/projects/${p.slug}`,
    name: p.slug.replace(/-/g, '_'),
    meta: p.facts?.role?.toUpperCase() ?? p.category.toUpperCase(),
    year: (p.facts?.year ?? '').split('–').pop(),
  }));

// the index shows the 5 featured networks; the rest live at /projects
const moreCount = projects.length - indexRows.length;

// tiny operator-glyphs per project (currentColor → inherits the row accent)
const ICONS: Record<string, string> = {
  'futurescaper': '<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="6" stroke-dasharray="1.6 1.9"/><circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/><circle cx="14" cy="8" r="1" fill="currentColor" stroke="none"/><circle cx="8" cy="2" r="1" fill="currentColor" stroke="none"/></svg>',
  'futurity-engine': '<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12l4-5 3 3 3-6"/><circle cx="3" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="7" cy="7" r="1.4" fill="currentColor" stroke="none"/><circle cx="10" cy="10" r="1.4" fill="currentColor" stroke="none"/><circle cx="13" cy="4" r="1.4" fill="currentColor" stroke="none"/></svg>',
  'fast': '<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" stroke="none"><circle cx="4" cy="4" r="1"/><circle cx="6.2" cy="3" r="1"/><circle cx="3" cy="6.2" r="1"/><circle cx="12" cy="4" r="1"/><circle cx="13" cy="6.2" r="1"/><circle cx="10" cy="4" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="3" cy="10" r="1"/><circle cx="6.2" cy="13" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="13" cy="10" r="1"/><circle cx="10" cy="12" r="1"/></svg>',
  'campus-ai': '<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" stroke="none"><rect x="2" y="3" width="8" height="2" rx="1"/><rect x="2" y="7" width="12" height="2" rx="1"/><rect x="2" y="11" width="6" height="2" rx="1"/></svg>',
  'carlton-dev': '<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1.5" y="2.5" width="6" height="4.5" rx="1"/><rect x="8.5" y="9" width="6" height="4.5" rx="1"/><path d="M7.5 4.8h2.2q1.3 0 1.3 1.3V9"/><circle cx="7.5" cy="4.8" r="1" fill="currentColor" stroke="none"/><circle cx="11" cy="9" r="1" fill="currentColor" stroke="none"/></svg>',
};
---

<Base title={siteConfig.title} description={siteConfig.description} jsonLd={jsonLd}>
  <PatchField id="net" links={links} layout={layout}>
    <Operator id="opHero" name="hero_txt" type="txt" area="hero" nudge="0 24" ports="out">
      <h1 class="hero-h">
        Designer who <span class="grn">deploys</span>.
        <span class="ghost">Engineer who dreams.</span>
      </h1>
      <span class="hero-tag">&gt; I build what I design</span>
    </Operator>

    <!-- the work rack: viewer + index are one unit in READ mode (player/playlist);
         display:contents in PATCH mode so both ops stay free-floating on the canvas -->
    <div class="rack" data-rack="work">
      <Operator id="opScape" name="futurescaper_view · live_map" type="view" area="view" nudge="0 48" maxw={640}>
        <div class="viewer-wrap">
          <div class="viewer-stage">
            <svg class="viewer" id="viewerSvg" viewBox="0 0 420 240" role="img" aria-label="Futurescaper self-generating consequence map, live synthetic demo"></svg>
            <canvas class="viewer-dither" id="viewerDither" aria-hidden="true"></canvas>
          </div>
          <div class="vfoot">
            <span id="viewerFoot">SELF-GENERATING · STEEPLE · METRO EDGES</span>
            <a id="viewerOpen" href="/projects/futurescaper"><b>OPEN NETWORK →</b></a>
          </div>
        </div>
      </Operator>

      <Operator id="opIndex" name="work_index · preview · open" type="data" area="index">
        <div class="idx" id="workIndex">
          {indexRows.map((r, i) => (
            <a href={r.href} data-slug={r.slug} class:list={['idxrow', { sel: i === 0 }]} title="Preview in the viewer · select again to open the case study">
              <span class="idxnum">{String(i + 1).padStart(2, '0')}</span>
              <span class="idxicon" set:html={ICONS[r.slug]} />
              <span class="idxmain">
                <span class="idxname">{r.name}</span>
                <span class="idxmeta">{r.meta}</span>
              </span>
              <span class="idxyear">{r.year}</span>
              <span class="idxgo" aria-hidden="true">OPEN ↗</span>
            </a>
          ))}
          <a href="/projects" class="idxmore" title="The full project index — every network">
            <span class="idxnum">+{String(moreCount).padStart(2, '0')}</span>
            <span class="idxmorename">MORE ▸ FULL_INDEX</span>
            <span class="idxgo idxmorego" aria-hidden="true">/projects ↗</span>
          </a>
        </div>
      </Operator>
    </div>

    <!-- cycle_clock: the auto-cycle made visible — an LFO ticking the index.
         Hover/touch/focus on the index (or the viewer leaving the screen)
         inhibits it: the chip dims and the dot stops pulsing. -->
    <Operator id="opClock" name="cycle_clock · 7.2s" type="sys" area="clock" fit="auto" nudge="0 24" ports="out">
      <div class="chain">
        <span class="chip chipclk idle" id="clockChip"><span class="clkdot" aria-hidden="true"></span>AUTO ▸ CYCLE</span>
      </div>
    </Operator>

    <Operator id="opFx" name="post_fx" type="sys" area="fx" fit="auto" nudge="0 96">
      <div class="chain">
        <span class="chip">IN</span><span class="arr">▶</span>
        <button id="invertBtn" class="chip chipbtn" aria-pressed="false">INVERT</button>
        <span class="arr">▶</span><span class="chip">OUT</span>
      </div>
    </Operator>

    <Operator id="opRead" name="readme_txt" type="txt" area="read" nudge="0 12">
      <div class="readme">
        <span class="k">## about</span><br />
        10 yrs in hardware labs (incl. Apple Vision Pro) → Master's in interaction
        design, Barcelona → Design Engineer at Futurity Systems, building AI
        research instruments.<br />
        <span class="k">## wiring</span><br />
        Every case study here is itself a network. <a href="/about">Follow the cables.</a>
      </div>
    </Operator>

    <!-- the background generator: a tight, compact chain arcing around the
         hero card's bottom-right corner (01 top-right → 04 below-left) -->
    <Operator id="opNoise" name="bg_01 · noise_src" type="sys" area="noise" maxw={170} nudge="24 48" ports="out">
      <button class="chip chipbtn" data-cycle="noise" data-prefix="TYPE" title="Click: cycle noise type">TYPE ▸ RIDGE</button>
      <div class="prow">
        <span class="plab">SPEED</span>
        <input class="prange" type="range" data-param="speed" data-div="100" min="0" max="300" value="100" aria-label="Noise drift speed" />
        <b class="pval" data-out="speed">1.00</b>
      </div>
    </Operator>

    <Operator id="opFeedbk" name="bg_02 · feedback" type="sys" area="fdbk" maxw={160} nudge="0 24">
      <div class="prow">
        <span class="plab">FDBK</span>
        <input class="prange" type="range" data-param="feedback" data-div="100" min="0" max="95" value="78" aria-label="Feedback amount — higher leaves longer cursor trails" />
        <b class="pval" data-out="feedback">0.78</b>
      </div>
      <button class="chip chipbtn wanderchip" data-cycle="wander" data-prefix="AUTO" title="Tap: toggle the idle ghost painter">AUTO ▸ ON</button>
      <div class="genhint"><span class="hint-fine">CURSOR PAINTS THE FIELD ▚</span><span class="hint-coarse">TOUCH PAINTS THE FIELD ▚</span></div>
    </Operator>

    <Operator id="opDither" name="bg_03 · dither" type="sys" area="dith" maxw={180} nudge="12 24">
      <button class="chip chipbtn" data-cycle="dither" data-prefix="TYPE" title="Click: cycle dither pattern">TYPE ▸ BAYER2</button>
      <div class="prow">
        <span class="plab">DENS</span>
        <input class="prange" type="range" data-param="density" data-div="100" min="5" max="95" value="77" aria-label="Dither density" />
        <b class="pval" data-out="density">0.77</b>
      </div>
      <div class="prow">
        <span class="plab">SCALE</span>
        <input class="prange" type="range" data-param="scale" min="2" max="8" value="3" aria-label="Dither cell scale" />
        <b class="pval" data-out="scale">3</b>
      </div>
    </Operator>

    <Operator id="opOut" name="bg_04 · out" type="sys" area="out" maxw={160} nudge="0 -24" ports="in">
      <button class="chip chipbtn" data-cycle="palette" data-prefix="PAL" title="Click: cycle output palette">PAL ▸ GRN</button>
      <div class="genhint">RENDERS THE PAGE ▚</div>
    </Operator>
  </PatchField>
  <PrevisEngine />
</Base>

<style>
  .hero-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 0.97;
    letter-spacing: -0.01em;
  }
  .hero-h .grn { color: var(--signal); }
  /* input-aware bg_02: ghost-painter chip + hint copy exist only where they're
     true — coarse pointers get AUTO + "TOUCH", fine pointers get "CURSOR" */
  .wanderchip, .hint-coarse { display: none; }
  /* READ mode: the two compact chain ops (cycle_clock + post_fx) sit side by
     side — the 230px sys-strip min-width forces a wrap on phones, drop it */
  :global(body.perform #opClock), :global(body.perform #opFx) { min-width: 0; }
  @media (hover: none) and (pointer: coarse) {
    .wanderchip { display: inline-block; margin-top: 6px; }
    .hint-fine { display: none; }
    .hint-coarse { display: inline; }
  }
  /* ghost line: signal outline (same hue as "deploys"), pitch-black fill */
  .hero-h .ghost { color: #000; -webkit-text-stroke: 1.3px var(--signal); }
  .hero-tag { font-family: var(--font-mono); font-size: 11.5px; color: var(--signal); margin-top: 12px; display: block; }
  .hero-tag::after { content: '█'; animation: blink 1.1s steps(1) infinite; margin-left: 3px; font-size: 10px; }
  @keyframes blink { 50% { opacity: 0; } }

  .viewer-wrap { margin: -12px -14px; }
  .viewer-stage { position: relative; font-size: 0; }
  .viewer { display: block; background: var(--paper); width: 100%; height: auto; transition: background 300ms var(--ease-out); }
  .viewer-dither { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; image-rendering: pixelated; }
  .vfoot {
    display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono); font-size: 9.5px; color: var(--text-dim);
  }
  .vfoot a { text-decoration: none; white-space: nowrap; }
  .vfoot b { color: var(--signal); font-weight: 400; }

  /* cook flash when a new preview lands in the viewer */
  :global(#opScape.cooking) { border-color: var(--signal); box-shadow: 0 14px 50px rgba(61, 255, 136, 0.22); }

  /* compact single-line rows (matches /projects — Carlton prefers this) */
  .idx { display: flex; flex-direction: column; gap: 2px; margin: -4px -6px; }
  .idxrow {
    display: flex; align-items: center; gap: 9px;
    padding: 4px 11px; border-radius: 6px;
    border: 1px solid transparent;
    text-decoration: none; color: var(--text);
    font-family: var(--font-mono);
    transition: background var(--duration-fast), border-color var(--duration-fast);
  }
  .idxnum { font-size: 9px; color: var(--text-dim); width: 15px; flex: none; letter-spacing: 0.04em; }
  .idxicon { display: inline-flex; color: var(--text-muted); flex: none; transition: color var(--duration-fast); }
  .idxmain { display: flex; flex-direction: row; align-items: baseline; gap: 9px; min-width: 0; flex: 1; }
  .idxname { font-size: 12px; font-weight: 500; letter-spacing: 0.02em; white-space: nowrap; flex: none; }
  .idxname::before { content: '▸ '; color: var(--signal-dim); }
  .idxmeta { font-size: 8.5px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; text-transform: uppercase; letter-spacing: 0.06em; }
  @media (max-width: 560px) {
    .idxmeta { display: none; }
  }
  .idxyear { font-size: 10px; color: var(--text-dim); flex: none; font-variant-numeric: tabular-nums; }
  .idxgo { font-size: 8px; letter-spacing: 0.09em; color: var(--signal); opacity: 0; flex: none; width: 40px; text-align: right; transition: opacity var(--duration-fast); }
  .idxrow:hover, .idxrow.sel { background: color-mix(in srgb, var(--signal) 7%, transparent); border-color: var(--border-color); }
  .idxrow:hover { border-color: var(--border-hover); }
  .idxrow:hover .idxname, .idxrow.sel .idxname { color: var(--signal); }
  .idxrow:hover .idxicon, .idxrow.sel .idxicon { color: var(--signal); }
  .idxrow:hover .idxgo { opacity: 1; }
  /* the selected row always shows its OPEN affordance — on touch it's the
     "tap again" cue, on hover devices it matches the hover reveal anyway */
  .idxrow.sel .idxgo { opacity: 1; }
  .idxrow.sel { box-shadow: inset 2px 0 0 var(--signal); }
  .idxrow:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }

  /* the see-more row: same rack, quieter voice — lights up signal on hover */
  .idxmore {
    display: flex; align-items: center; gap: 9px;
    margin-top: 2px; padding: 5px 11px;
    border-top: 1px dashed var(--border-color);
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em;
    color: var(--text-muted); text-decoration: none;
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .idxmore .idxnum { color: var(--signal-dim); }
  .idxmorename { flex: 1; }
  .idxmorego { width: auto; }
  .idxmore:hover { color: var(--signal); background: color-mix(in srgb, var(--signal) 5%, transparent); border-radius: 0 0 7px 7px; }
  .idxmore:hover .idxnum { color: var(--signal); }
  .idxmore:hover .idxgo { opacity: 1; }
  .idxmore:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }

  .readme { font-family: var(--font-mono); font-size: 11px; line-height: 1.8; color: var(--text-muted); }
  .readme .k { color: var(--signal); }
  .readme a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .readme a:hover { color: var(--signal); }

  /* READ mode: open up the dense mono blocks for actual reading */
  :global(body.perform) .readme { font-size: 13.5px; line-height: 1.9; max-width: 62ch; }
  :global(body.perform) .idx { font-size: 13px; }
  :global(body.perform) .hero-tag { font-size: 13px; }

  /* ---- the work rack ----
     PATCH mode: the wrapper doesn't exist layout-wise — both ops float free. */
  .rack { display: contents; }

  /* READ narrow (default): player/playlist. The viewer sticks under the nav
     as a chromed panel; the index scrolls beneath it, so a selection always
     cooks a viewer that's on screen. */
  :global(body.perform) .rack {
    display: block;
    max-width: 860px;
    margin: 0 auto 40px;
    text-align: left;
  }
  :global(body.perform) .rack :global(.op) { margin: 0 0 18px; max-width: none; }
  :global(body.perform) .rack :global(#opScape) {
    position: sticky !important;
    max-width: none;
    top: calc(var(--nav-height) + 10px);
    z-index: 40; /* above sibling ops, well under the nav (90) */
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.55);
  }
  :global(body.perform) .rack :global(#opScape .ohead) { padding: 6px 10px; margin-bottom: 0; }
  :global(body.perform) .rack :global(#opScape .obody) { padding: 0; }
  :global(body.perform) .rack .viewer-wrap { margin: 0; }

  /* READ wide (≥880px): two-up rack — index as a playlist column beside the
     viewer, both fully visible. Sticky no longer needed. */
  @media (min-width: 880px) {
    :global(body.perform) .rack {
      display: grid;
      grid-template-columns: minmax(300px, 340px) minmax(0, 1fr);
      gap: 18px;
      align-items: start;
      max-width: 1080px;
    }
    :global(body.perform) .rack :global(#opIndex) { grid-column: 1; grid-row: 1; margin: 0; }
    :global(body.perform) .rack :global(#opScape) { grid-column: 2; grid-row: 1; position: static !important; margin: 0; }
  }

  .chain { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9px; color: var(--text-muted); }
  .chip { border: 1px solid #2c2c30; padding: 3px 7px; border-radius: 4px; background: var(--bg-surface); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.04em; }
  .arr { color: var(--signal-dim); }

  /* cycle_clock chip: armed = signal dot pulsing; inhibited = dimmed, dot still.
     Static (non-clickable) chip — stays gray per the chip affordance rule. */
  .chipclk { display: inline-flex; align-items: center; transition: opacity var(--duration-fast), color var(--duration-fast); }
  .clkdot { width: 6px; height: 6px; border-radius: 50%; background: var(--signal); display: inline-block; margin-right: 6px; animation: clkpulse 1.2s steps(2) infinite; }
  .chipclk.idle { color: var(--text-dim); opacity: 0.55; }
  .chipclk.idle .clkdot { animation: none; background: var(--text-dim); }
  @keyframes clkpulse { 50% { opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) { .clkdot { animation: none; } }

  .prow { display: flex; align-items: center; gap: 6px; margin-top: 8px; font-family: var(--font-mono); min-width: 0; }
  .plab { font-size: 8.5px; color: var(--text-dim); width: 34px; flex: none; }
  .prow input { flex: 1; min-width: 0; width: 100%; }
  .pval { font-size: 8.5px; color: var(--signal); font-weight: 400; width: 26px; flex: none; text-align: right; }
  .genhint { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.12em; color: var(--text-dim); margin-top: 9px; white-space: nowrap; }

  /* bg_generator nodes are secondary instruments — keep them compact so the
     dither field reads through and the hero/viewer stay the focus */
  :global(#opNoise .obody), :global(#opFeedbk .obody),
  :global(#opDither .obody), :global(#opOut .obody), :global(#opClock .obody) { padding: 8px 10px; }
  :global(#opNoise .ohead), :global(#opFeedbk .ohead),
  :global(#opDither .ohead), :global(#opOut .ohead), :global(#opClock .ohead) { padding: 4px 9px; font-size: 9px; }
  :global(#opNoise) .prow, :global(#opFeedbk) .prow,
  :global(#opDither) .prow, :global(#opOut) .prow { margin-top: 6px; }
</style>

<script is:inline data-astro-rerun>
(function () {
  const svg = document.getElementById('viewerSvg');
  if (!svg || svg.dataset.init) return;
  svg.dataset.init = '1';

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ================= the network: four registered nodes =================
     cycle_clock ─tick→ work_index ─selection→ post_fx (filter: +INVERT) → futurescaper_view
     Registered on the patch runtime (inlined by PatchField, which runs first
     in DOM order). Every delivery pulses its cable; all timers/listeners/
     observers below ride the runtime lifecycle and die on astro:before-swap.
     Under ?nopatch=1 (or a missing runtime) N() hands out inert stubs: the
     viewer still renders its default scene and rows stay plain links.
     The previews themselves live in window.Previs (PrevisEngine inlines
     src/lib/previs.js right after the patch field). */
  const op = document.getElementById('opScape');
  const nameEl = op && op.querySelector('.oname');
  const footEl = document.getElementById('viewerFoot');
  const openEl = document.getElementById('viewerOpen');
  const invBtn = document.getElementById('invertBtn');
  const idxEl = document.getElementById('workIndex');
  // closured rows only — a live document query later would let a stale
  // instance (pre view-transition) repaint the NEW page's rows out of sync
  const idxRows = Array.prototype.slice.call(document.querySelectorAll('#workIndex [data-slug]'));
  const ORDER = idxRows.map((r) => r.dataset.slug);

  // the shared preview engine owns the svg internals (scenes, dissolve, loop)
  const eng = window.Previs.engine({ svg, dither: document.getElementById('viewerDither') });

  // initial selection = the row the markup marked .sel (keeps highlight and
  // viewer in lockstep no matter how the index is reordered)
  const selRow = idxRows.filter((r) => r.classList.contains('sel'))[0];
  const cur0 = (selRow && eng.has(selRow.dataset.slug)) ? selRow.dataset.slug : 'futurescaper';

  const net = window.Patch ? window.Patch.field('net') : null;
  const LIVE = !!(net && !net.stub);
  const NOOP = function () {};
  const N = (id, spec) => (net ? net.node(id, spec) : { el: null, emit: NOOP, every: NOOP, timeout: NOOP, observe: NOOP, listen: NOOP, cleanup: NOOP });

  /* ---- futurescaper_view: ins.selection → cook (engine owns the dissolve);
          this node just re-labels the operator chrome when the scene changes ---- */
  const view = N('opScape', {
    ins: {
      selection: (m) => {
        const changed = eng.select(m.slug, !!m.invert);
        if (changed) {
          const meta = eng.meta(eng.current());
          if (nameEl) nameEl.textContent = meta.name;
          if (footEl) footEl.textContent = meta.foot;
          if (openEl) openEl.href = '/projects/' + eng.current();
          if (op) {
            op.classList.add('cooking');
            view.timeout(450, () => op.classList.remove('cooking'));
          }
        }
      },
    },
  });

  /* ---- post_fx: filter annotates {slug} → {slug, invert} on the way through;
          the INVERT button re-emits the last selection with the new state ---- */
  let fxInv = false, fxLast = cur0;
  const fx = N('opFx', {
    outs: { selection: 'object' },
    filter: { selection: (m) => { fxLast = m.slug; return { slug: m.slug, invert: fxInv }; } },
  });
  if (invBtn) fx.listen(invBtn, 'click', () => {
    fxInv = !fxInv;
    invBtn.setAttribute('aria-pressed', String(fxInv));
    fx.emit('selection', { slug: fxLast, invert: fxInv });
  });

  /* ---- work_index: emits selection on hover / tap / focus / tick.
          Selection grammar unchanged: hover previews (mouse), tap previews
          (touch), and a second activation opens. Rows stay real links
          (SEO / middle-click / ⌘-click); we only intercept a plain primary
          click on a row that isn't current yet. ---- */
  let sel = cur0;
  const idx = N('opIndex', {
    outs: { selection: 'object' },
    ins: { tick: () => { const i = ORDER.indexOf(sel); pick(ORDER[(i + 1) % ORDER.length]); } },
  });
  function pick(slug) {
    if (!slug || slug === sel) return;
    sel = slug;
    idxRows.forEach((row) => row.classList.toggle('sel', row.dataset.slug === slug));
    idx.emit('selection', { slug });
  }
  idxRows.forEach((row) => {
    idx.listen(row, 'pointerenter', (e) => { if (e.pointerType === 'mouse') pick(row.dataset.slug); });
    idx.listen(row, 'focus', () => pick(row.dataset.slug));
    idx.listen(row, 'click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (row.dataset.slug !== sel) { e.preventDefault(); pick(row.dataset.slug); }
      // already the current selection → the link navigates ("tap again to open")
    });
  });

  /* ---- cycle_clock: the visible SYS op that owns the interval + ALL gating.
          Inhibitors (chip dims, pulse stops): index hover (mouse), any touch
          (permanent — no hover means no "disengaged" signal to resume on),
          focus/click on the index, viewer off-screen, hidden tab, reduced
          motion. Mouse leave re-arms after RESUME_MS idle. ---- */
  const clockChip = document.getElementById('clockChip');
  const CYCLE_MS = 7200, RESUME_MS = 30000;
  const clock = N('opClock', { outs: { tick: 'null' } });
  let cycling = false, hovering = false, touched = false, viewerSeen = true;
  let cycleTimer = null, idleTimer = null;
  const clockUi = () => { if (clockChip) clockChip.classList.toggle('idle', !cycling); };
  function startCycle() {
    if (!LIVE || REDUCED || cycling || hovering || touched || !viewerSeen || ORDER.length < 2) { clockUi(); return; }
    cycling = true;
    cycleTimer = clock.every(CYCLE_MS, () => {
      // never tick against a dead DOM (post view-transition — belt + braces,
      // the runtime already clears this interval on swap) or a hidden tab:
      // rAF is paused there, so ticking would move the index without the viewer
      if (!svg.isConnected) { stopCycle(); return; }
      if (document.hidden) return;
      clock.emit('tick', null);
    });
    clockUi();
  }
  function stopCycle() {
    cycling = false;
    if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = null; }
    if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    clockUi();
  }
  // Mouse only: touch fires synthetic enter events we must not treat as hover.
  if (idxEl) {
    clock.listen(idxEl, 'pointerenter', (e) => { if (e.pointerType === 'mouse') { hovering = true; stopCycle(); } });
    clock.listen(idxEl, 'pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      hovering = false;
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = clock.timeout(RESUME_MS, () => { idleTimer = null; startCycle(); });
    });
    clock.listen(idxEl, 'pointerdown', (e) => { if (e.pointerType !== 'mouse') { touched = true; stopCycle(); } }, { passive: true });
    clock.listen(idxEl, 'focusin', stopCycle);
    clock.listen(idxEl, 'click', stopCycle);
  }
  // Cycle only while the viewer can actually respond on screen (READ mode can
  // scroll it away; in PATCH mode the field fills the viewport so this stays true).
  if (op && typeof IntersectionObserver !== 'undefined') {
    clock.observe(op, { threshold: 0.3 }, (es) => {
      viewerSeen = es[es.length - 1].isIntersecting;
      if (viewerSeen) startCycle(); else stopCycle();
    });
  }
  startCycle();

  /* ---- boot the viewer: first cook + rAF loop live in the engine ---- */
  eng.boot(cur0);
})();
</script>
