        const pp = { s: n.s, cat: n.cat, x: SC_D1X, cy, w: SC_W1, h: SC_PH, sx: SC_SEEDX + SC_SEEDW, sy: SC_CY, tx: SC_D1X, ty: cy, ed, nd };
        nodes.push(pp); byId[n.id] = pp;
