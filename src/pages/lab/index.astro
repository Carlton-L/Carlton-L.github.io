---
/**
 * Lab — a small network (converted from PatchDoc so the dither cooks here too).
 *
 * lab_txt → experiments_index → PRESENCE (sim-first build) → EYE (CAD study,
 * parked) → queue. Experiments are separated by full-width divider bars
 * (labDiv ops — black, glowing border) that work in both modes.
 *
 * GRID graduated to /projects/grid-lamp (2026-07-06). BEAM PLANT pulled
 * 2026-07-06 (too early for the page — sim runtime retained at
 * public/js/plant-lab.js for when it matures).
 *
 * Sims: public/js/presence-lab.js (A* click-anywhere pathfinding) +
 * public/js/eye-lab.js — vanilla canvas, no CDN deps, lazy-loaded by the
 * bootstrap below only when their ops approach the viewport.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import { getBreadcrumbJsonLd } from '../../lib/seo.js';

const experiments = [
  {
    title: 'PRESENCE — CV home lighting',
    description:
      'Computer vision presence detection driving home lighting at fixture level: light follows people instead of switches. Sim running below; hardware phase next.',
    href: '#hlConcept',
    tags: ['Computer Vision', 'Python', 'Home'],
    status: 'sim',
  },
  {
    title: 'EYE — biomimetic mechanism',
    description:
      'An animatronic eye designed in SolidWorks: four servos, ball linkages, eyelids that follow the gaze. The eyeball got printed; the rig is parked.',
    href: '#eyeConcept',
    tags: ['SolidWorks', 'Servos', 'Arduino'],
    status: 'parked',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Lab' },
    ]),
  ],
};

const links: [string, string][] = [
  ['labIntro', 'labIndex'],
  ['labIndex', 'labDiv1'],
  ['labDiv1', 'hlConcept'],
  ['hlConcept', 'plView'],
  ['plView', 'labDiv2'],
  ['labDiv2', 'eyeConcept'],
  ['eyeConcept', 'eyeHero'],
  ['eyeHero', 'eyeRenders'],
  ['eyeRenders', 'eyeLed'],
  ['eyeRenders', 'eyeSim'],
  ['eyeSim', 'eyeOut'],
  ['eyeOut', 'labDiv3'],
  ['labDiv3', 'labCook'],
];

// layout: content mode — concept text left, artifact (sim / renders) right,
// per experiment. div rows are the full-width section bars.
const layout = {
  mode: 'content',
  padTop: 24,
  tiers: [{
    min: 0,
    cols: 12,
    areas: `
      intro intro intro intro intro .     .     .     index index index index
      .     .     .     .     .     .     .     .     .     .     .     .
      div1  div1  div1  div1  div1  div1  div1  div1  div1  div1  div1  div1
      .     .     .     .     .     .     .     .     .     .     .     .
      hlc   hlc   hlc   hlc   hlc   .     plv   plv   plv   plv   plv   plv
      .     .     .     .     .     .     .     .     .     .     .     .
      div2  div2  div2  div2  div2  div2  div2  div2  div2  div2  div2  div2
      .     .     .     .     .     .     .     .     .     .     .     .
      econc econc econc econc econc .     ehero ehero ehero ehero ehero ehero
      .     erend erend erend erend erend erend .     eled  eled  eled  .
      esim  esim  esim  esim  esim  esim  .     eout  eout  eout  eout  .
      .     .     .     .     .     .     .     .     .     .     .     .
      div3  div3  div3  div3  div3  div3  div3  div3  div3  div3  div3  div3
      .     .     .     .     .     .     .     .     .     .     .     .
      .     .     .     .     cook  cook  cook  cook  .     .     .     .
    `,
  }],
};
---

<Base
  title="Lab — Carlton Lindsay"
  description="Interactive experiments, generative sketches, and technical explorations."
  jsonLd={jsonLd}
>
  <PatchField id="labNet" links={links} density={0.3} height="2660px" layout={layout} label="Lab network — press P for reading mode">
    <Operator id="labIntro" name="input · lab_txt" type="txt" area="intro" ports="out">
      <h1 class="pd-h">Lab</h1>
      <p class="pd-p">
        Experiments and explorations: things I'm building, testing, or just
        curious about. Each one says what's real and what isn't yet.
      </p>
    </Operator>

    <Operator id="labIndex" name="experiments_index" type="data" area="index" nudge="0 24">
      <div class="pd-exps">
        {experiments.map((exp) => (
          <a href={exp.href} class="pd-exp">
            <span class="pd-status" data-live={exp.status === 'live'} data-st={exp.status}>● {exp.status.toUpperCase()}</span>
            <span class="pd-title">{exp.title}</span>
            <span class="pd-desc">{exp.description}</span>
            <span class="pd-tags">{exp.tags.join(' · ')}</span>
          </a>
        ))}
      </div>
    </Operator>

    <!-- section bar · bus node: cables enter top, leave bottom -->
    <Operator id="labDiv1" name="sys · break" type="sys" area="div1" ports="both" flow="vertical">
      <span class="ldiv-label">▚ EXPERIMENT 001</span>
    </Operator>

    <!-- ============ EXPERIMENT 001 · PRESENCE (sim-first build) ============ -->
    <Operator id="hlConcept" name="input · presence_txt" type="txt" area="hlc">
      <p class="gl-meta">EXPERIMENT 001 · SIM-FIRST BUILD IN PROGRESS · NO HARDWARE INSTALLED YET</p>
      <h2 class="gl-h">Lighting you never <span class="sig">operate</span></h2>
      <p class="pd-p">
        The plan is presence-aware lighting for my flat: a camera and some
        Python deciding which lights should be on, fixture by fixture, based
        on where people actually are. Motion sensors can't do this. They
        treat stillness as absence, which is why they go dark on anyone
        reading a book. Presence detection tracks the person, not the
        movement, so the lights nearest to you stay with you.
      </p>
      <p class="pd-p">
        The sim on the right runs the argument. Both detector models are
        computed at once, so you can watch them disagree.
      </p>
      <ul class="gl-help">
        <li><b>TAP</b> anywhere on the plan · the person pathfinds there, around walls and furniture</li>
        <li><b>READING</b> makes them sit still · under the <b>MOTION</b> policy, watch the room count down and go dark on them</li>
        <li><b>PRESENCE</b> keeps the nearby fixtures lit no matter how still · <b>CUT / FADE</b> + <b>LINGER</b> shape how light leaves an empty spot</li>
      </ul>
      <h3 class="gl-h3">The build, so far</h3>
      <p class="pd-p">
        The sim is the first step of the build, same approach as GRID: work
        out the behavior on screen before buying hardware. Whatever linger
        and fade settings feel right here are what the real system will run.
      </p>
      <ul class="gl-help">
        <li><b>DETECTION</b> · person detection on every frame (OpenCV, a small YOLO-class model) on a box in the closet. 1–2 fps is plenty for knowing where someone is</li>
        <li><b>LOCAL ONLY</b> · no frames leave the machine. Rooms where a camera would feel wrong don't get one</li>
        <li><b>CONTROL PATH</b> · probably Home Assistant with zigbee2mqtt. Wall switches always win, and if the camera or the process dies the lights fail on</li>
        <li><b>FIRST POC</b> · one camera, one room, one lamp. Log every time a motion sensor would have gotten it wrong</li>
      </ul>
      <p class="gl-spec">STILL OPEN: CAMERA PLACEMENT VS PRIVACY PER ROOM · FRIGATE VS HAND-ROLLED PIPELINE · WHICH ROOM GOES FIRST</p>
    </Operator>

    <Operator id="plView" name="presence_view · floorplan_sim" type="view" area="plv">
      <div class="simlab">
        <canvas id="plCv" class="sl-cv" aria-label="Interactive floorplan simulation comparing motion sensing to presence detection: click anywhere and the person pathfinds there around walls and furniture; toggle reading mode to make them still"></canvas>
        <div class="sl-row">
          <span class="sl-k">POLICY</span>
          <button id="plPolicyMotion" class="sl-chip">MOTION</button>
          <button id="plPolicyPresence" class="sl-chip on">PRESENCE</button>
          <button id="plReading" class="sl-chip sl-chip-amber">READING</button>
        </div>
        <div class="sl-row">
          <span class="sl-k">DECAY</span>
          <button id="plCut" class="sl-chip">CUT</button>
          <button id="plFade" class="sl-chip on">FADE</button>
          <span class="sl-k sl-k2">LINGER</span>
          <input id="plLinger" class="sl-range" type="range" min="0" max="100" value="10" aria-label="Linger time before lights decay" />
        </div>
        <div class="sl-tel">
          <span>ROOM</span><b id="plTelRoom">—</b>
          <span>STILLNESS</span><b id="plTelStill">—</b>
          <span>MOTION SAYS</span><b id="plTelMotion">—</b>
          <span>PRESENCE SAYS</span><b id="plTelPresence">—</b>
        </div>
      </div>
    </Operator>

    <!-- section bar · bus node -->
    <Operator id="labDiv2" name="sys · break" type="sys" area="div2" ports="both" flow="vertical">
      <span class="ldiv-label">▚ EXPERIMENT 002</span>
    </Operator>

    <!-- ============ EXPERIMENT 002 · EYE ============ -->
    <Operator id="eyeConcept" name="input · eye_txt" type="txt" area="econc">
      <p class="gl-meta">EXPERIMENT 002 · ANIMATRONIC MECHANISM · DESIGNED IN CAD, BUILD PARKED</p>
      <h2 class="gl-h">EYE — a machine that <span class="sig">looks</span></h2>
      <p class="pd-p">
        Pure exploration, started after falling down the rabbit hole of Will
        Cogley's animatronics videos. An eye that only rotates reads as a
        camera on a gimbal. The parts around the rotation are what make it a
        look: lids that follow the gaze, an iris that catches the light.
      </p>
      <p class="pd-p">
        The design runs on four servos. Two point the eyeball through ball
        linkages. The other two run the eyelids: one slides a carriage along
        two rods, moving both lids toward or away from the eye to close and
        open them, and one tilts a straight horn with a lid coupled to each
        end, so when the eye points down the top lid follows it down, the way
        yours does. Control is an Arduino and a joystick.
      </p>
      <p class="pd-p">
        The eyeball itself is a three-part printed assembly. The iris clicks
        into the eyeball shell on cantilever snaps, a transparent pupil seats
        in front of an RGB LED breakout, and the shell carries molded-in
        mounting datums for the little board plus channels that route its
        wires out the back.
      </p>
      <p class="gl-spec">4 SERVOS · BALL LINKAGES · LID CARRIAGE + TILT HORN · CANTILEVER SNAPS · 3D PRINT · SOLIDWORKS · ARDUINO</p>
    </Operator>

    <Operator id="eyeHero" name="eye_cad · full_assembly" type="view" area="ehero" ports="in">
      <figure class="eye-hero">
        <img src="/images/lab/biomimetic-eye/full-assembly.png" alt="CAD render of the complete single-eye mechanism: eyeball assembly with iris and pupil, separate eyelid shells, the eyelid carriage on two rods, four servos with linkages, all on a printed base" loading="lazy" />
        <figcaption>FULL SINGLE-EYE MECHANISM · EXISTS IN CAD ONLY</figcaption>
      </figure>
    </Operator>

    <Operator id="eyeRenders" name="eye_cad · parts" type="view" area="erend" ports="in">
      <div class="eye-grid">
        <figure><img src="/images/lab/biomimetic-eye/eyeball.png" alt="CAD render of the assembled eyeball from the front: iris snapped in, RGB LED board visible through the transparent pupil" loading="lazy" /><figcaption>EYEBALL ASSEMBLY · LED THROUGH THE PUPIL</figcaption></figure>
        <figure><img src="/images/lab/biomimetic-eye/iris.png" alt="CAD render of the iris with its cutout pattern and cantilever snap arms" loading="lazy" /><figcaption>IRIS · CANTILEVER SNAPS</figcaption></figure>
        <figure><img src="/images/lab/biomimetic-eye/pupil.png" alt="CAD render of the transparent pupil lens" loading="lazy" /><figcaption>PUPIL · TRANSPARENT</figcaption></figure>
        <figure><img src="/images/lab/biomimetic-eye/section.png" alt="3D section view of the assembled eye showing how the snaps seat in their receptacles and the wire channels feeding the LED board" loading="lazy" /><figcaption>SECTION · SNAPS + WIRE CHANNELS</figcaption></figure>
        <figure><img src="/images/lab/biomimetic-eye/eyelids-closed.png" alt="CAD render of the two eyelid shells shown closed" loading="lazy" /><figcaption>EYELIDS · CLOSED</figcaption></figure>
        <figure><img src="/images/lab/biomimetic-eye/assembly-front.png" alt="CAD render of the eyeball mounted in its frame with the eyelid shells wrapped around it" loading="lazy" /><figcaption>IN THE FRAME · EYELIDS AROUND THE EYE</figcaption></figure>
      </div>
      <p class="eye-gridnote">CAD RENDERS · THE EYEBALL ASSEMBLY IS THE PART THAT GOT PRINTED</p>
    </Operator>

    <Operator id="eyeLed" name="eye_part · the_led" type="view" area="eled" maxw={320} ports="in">
      <figure class="eye-photo">
        <img src="/images/lab/biomimetic-eye/led-pcba.jpeg" alt="The RGB LED used in the pupil: a 5050 package held in tweezers above its Adafruit carrier board" loading="lazy" />
        <figcaption>THE LED · 5050 ON AN ADAFRUIT CARRIER · PHOTO: ADAFRUIT</figcaption>
      </figure>
    </Operator>

    <Operator id="eyeSim" name="eye_sim · design_intent" type="view" area="esim">
      <div class="simlab">
        <canvas id="eyCv" class="sl-cv sl-cv-tall" aria-label="Animated simulation of the eye mechanism's design intent: the eye saccades and blinks in a front view while a side schematic shows the eyelid carriage sliding and the tilt horn rotating in sync. Move the pointer to steer the gaze, click to blink"></canvas>
        <div class="sl-row">
          <span class="sl-k">MODE</span>
          <button id="eyAuto" class="sl-chip on">AUTO</button>
          <span class="sl-note">POINTER STEERS THE GAZE · CLICK TO BLINK</span>
        </div>
        <div class="sl-tel">
          <span>GAZE</span><b id="eyTelGaze">—</b>
          <span>CARRIAGE</span><b id="eyTelCarriage">—</b>
          <span>TILT HORN</span><b id="eyTelHorn">—</b>
          <span>LIDS</span><b id="eyTelLids">—</b>
        </div>
        <p class="eye-gridnote">SIMULATED FROM THE CAD · DESIGN INTENT, NOT HARDWARE · ONLY THE EYEBALL WAS PRINTED</p>
      </div>
    </Operator>

    <Operator id="eyeOut" name="out · parked" type="txt" area="eout" ports="in">
      <p class="pd-p">
        The full single-eye mechanism is modeled, base, carriage, servos and
        all. Only the eyeball assembly ever got printed; the budget ran out
        before the servos and linkages did. There's no working rig, and
        everything past the eyeball exists in CAD and nowhere else.
      </p>
      <p class="pd-p">
        It stays in the lab because the design still holds up. The eyelid
        carriage is my favorite part of it, one degree of freedom doing two
        jobs, and the build is waiting on a parts budget, nothing else.
      </p>
      <p class="gl-outnext">▸ NEXT · SERVOS AND LINKAGES, WHEN THE PARTS BUDGET RETURNS</p>
    </Operator>

    <!-- section bar · bus node: the queue, collapsed into the bar itself -->
    <Operator id="labDiv3" name="sys · break" type="sys" area="div3" ports="both" flow="vertical">
      <span class="ldiv-label">MORE COOKING<i class="gl-cursor">▮</i></span>
    </Operator>

    <!-- the next experiment, cooking: mini dither-cook (campus-ai grammar, lab scene) -->
    <Operator id="labCook" name="queue · exp_003" type="sys" area="cook" maxw={324} ports="in">
      <div class="lq-wrap">
        <canvas id="lqCv" width="288" height="132" aria-label="The next lab experiment cooking into view through a dither pattern; it never quite finishes. Cursor heat resolves it locally"></canvas>
        <span class="lq-sub">NEXT EXPERIMENT LANDS HERE · COOK <b id="lqPct">0%</b></span>
      </div>
    </Operator>
  </PatchField>

  <!-- Lazy bootstrap: each sim's runtime loads only when its op nears the
       viewport. No CDN deps — both are self-contained vanilla canvas.
       Re-nav safe: globals persist, init() re-binds to fresh DOM. -->
  <script is:inline data-astro-rerun>
  (function () {
    var SIMS = [
      ['plView', 'PresenceLab', '/js/presence-lab.js'],
      ['eyeSim', 'EyeLab', '/js/eye-lab.js'],
    ];
    SIMS.forEach(function (sim) {
      var op = document.getElementById(sim[0]);
      if (!op || op.dataset.slBoot) return;
      op.dataset.slBoot = '1';
      function start() {
        if (window[sim[1]]) { window[sim[1]].init(); return; }
        var s = document.createElement('script');
        s.src = sim[2];
        s.onload = function () { window[sim[1]] && window[sim[1]].init(); };
        s.onerror = function () { console.warn('LAB: failed to load ' + sim[2]); };
        document.head.appendChild(s);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); start(); }
        }, { rootMargin: '600px' });
        io.observe(op);
      } else {
        start();
      }
    });
  })();
  </script>

  <!-- queue cook — the next experiment resolving through a Bayer threshold,
       looping without ever finishing (it's a queue, not a promise). Same
       dither grammar as the campus-ai under-construction node, lab scene. -->
  <script is:inline data-astro-rerun>
  (() => {
    const cv = document.getElementById('lqCv');
    if (!cv || cv.dataset.booted) return;
    cv.dataset.booted = '1';
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CW = 96, CH = 44, CELL = 3;
    const ctx = cv.getContext('2d');
    ctx.imageSmoothingEnabled = false;

    /* target scene at cell resolution: a flask on the bench, contents unknown */
    const off = document.createElement('canvas');
    off.width = CW; off.height = CH;
    const oc = off.getContext('2d');
    oc.fillStyle = '#15140f'; oc.fillRect(0, 0, CW, CH);
    oc.strokeStyle = '#3dff88'; oc.lineWidth = 1;
    oc.beginPath();                       // erlenmeyer: neck + shoulders + base
    oc.moveTo(14, 8); oc.lineTo(14, 16); oc.lineTo(7, 32); oc.lineTo(25, 32); oc.lineTo(18, 16); oc.lineTo(18, 8);
    oc.closePath(); oc.stroke();
    oc.fillStyle = 'rgba(61,255,136,0.35)';
    oc.fillRect(9, 26, 14, 5);            // the brew
    oc.fillStyle = '#3dff88';
    oc.fillRect(13, 22, 2, 2); oc.fillRect(17, 19, 2, 2); oc.fillRect(15, 13, 2, 2);  // bubbles
    oc.fillRect(4, 34, 24, 1);            // bench
    oc.fillStyle = '#e6e6e2';
    oc.font = '900 10px monospace';
    oc.fillText('EXP_003', 36, 20);
    oc.fillStyle = '#3dff88';
    oc.font = '700 6px monospace';
    oc.fillText('CONTENTS UNKNOWN', 36, 29);
    oc.fillText('STILL COOKING', 36, 37);
    const scene = oc.getImageData(0, 0, CW, CH);

    const B4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
    const out = ctx.createImageData(CW, CH);
    const heat = new Float32Array(CW * CH);
    const pct = document.getElementById('lqPct');

    let t0 = performance.now();
    /* cook loops and never lands: up to 92%, simmer back, try again */
    function cookLevel(now) {
      const t = ((now - t0) / 1000) % 9;
      if (t < 3.6) return (t / 3.6) * 0.92;
      if (t < 5.2) return 0.92;
      return 0.92 - ((t - 5.2) / 3.8) * 0.72;
    }
    cv.addEventListener('pointermove', (e) => {
      const r = cv.getBoundingClientRect();
      const mx = (e.clientX - r.left) / r.width * CW, my = (e.clientY - r.top) / r.height * CH;
      for (let dy = -7; dy <= 7; dy++) for (let dx = -7; dx <= 7; dx++) {
        const x = Math.round(mx + dx), y = Math.round(my + dy);
        if (x < 0 || y < 0 || x >= CW || y >= CH) continue;
        const d2 = dx * dx + dy * dy;
        if (d2 < 49) heat[y * CW + x] = Math.min(1, heat[y * CW + x] + 0.1 * (1 - d2 / 49));
      }
    }, { passive: true });

    function render(p) {
      const sd = scene.data, od = out.data;
      for (let y = 0; y < CH; y++) {
        for (let x = 0; x < CW; x++) {
          const i = y * CW + x, i4 = i * 4;
          const local = Math.min(1, p + heat[i]);
          const th = (B4[(y & 3) * 4 + (x & 3)] + 0.5) / 16;
          if (local > th) { od[i4] = sd[i4]; od[i4 + 1] = sd[i4 + 1]; od[i4 + 2] = sd[i4 + 2]; }
          else { od[i4] = 21; od[i4 + 1] = 20; od[i4 + 2] = 15; }
          od[i4 + 3] = 255;
          if (!REDUCED) heat[i] *= 0.98;
        }
      }
      const tmp = document.createElement('canvas');
      tmp.width = CW; tmp.height = CH;
      tmp.getContext('2d').putImageData(out, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.drawImage(tmp, 0, 0, CW, CH, 0, 0, CW * CELL, CH * CELL);
    }

    if (REDUCED) { render(0.85); if (pct) pct.textContent = '85%'; return; }
    let fc = 0;
    (function frame(now) {
      if (!cv.isConnected) return;
      if ((fc++ & 1) === 0) {
        const p = cookLevel(now);
        render(p);
        if (pct) pct.textContent = Math.round(p * 100) + '%';
      }
      requestAnimationFrame(frame);
    })(performance.now());
  })();
  </script>
</Base>

<style>
  .pd-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .pd-p { font-size: 13px; color: var(--text-muted); line-height: 1.65; margin-bottom: 8px; }
  .pd-p:last-of-type { margin-bottom: 0; }

  .pd-exps { display: flex; flex-direction: column; }
  .pd-exp { display: block; padding: 14px 4px; border-bottom: 1px solid var(--border-color); text-decoration: none; }
  .pd-exp:last-child { border-bottom: none; }
  .pd-status { display: block; font-family: var(--font-mono); font-size: 9.5px; color: #e8c34a; margin-bottom: 4px; }
  .pd-status[data-live='true'] { color: var(--signal); }
  .pd-status[data-st='parked'] { color: var(--text-dim); }
  .pd-title { display: block; font-size: 15px; font-weight: 500; color: var(--text); margin-bottom: 4px; transition: color var(--duration-fast); }
  .pd-exp:hover .pd-title { color: var(--signal); }
  .pd-desc { display: block; font-size: 12.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 6px; }
  .pd-tags { display: block; font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); }

  .gl-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .gl-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 0.98;
    margin-bottom: 10px;
  }
  .gl-h .sig { color: var(--signal); }
  .gl-h3 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 15px;
    margin: 18px 0 8px;
  }
  .gl-spec {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-top: 12px;
    line-height: 1.7;
  }

  .gl-help {
