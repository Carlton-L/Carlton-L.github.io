---
/**
 * Lab — a small network (converted from PatchDoc so the dither cooks here too).
 *
 * lab_txt → experiments_index → GRID experiment:
 * grid concept TXT → controller VIEW (the app sim) → studio VIEW (live 3D).
 * The cable between the two VIEW ops is literal: one shared state drives
 * both — sculpt on the controller, the lamp responds in the studio.
 *
 * GRID demo: prototype code kept verbatim (public/js/grid-lab.js), three.js
 * r128 + postprocessing from CDN, all lazy-loaded by the bootstrap script
 * below only when the experiment ops approach the viewport. The homepage
 * and lab-above-the-fold ship none of it.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import { getBreadcrumbJsonLd } from '../../lib/seo.js';

const experiments = [
  {
    title: 'GRID — kinetic light',
    description:
      'A lamp you sculpt by touch: sixteen motorized cylinders, one shared state, two live views. Sim for a hardware build in progress.',
    href: '#gridConcept',
    tags: ['Three.js', 'Hardware', 'Kinetic light'],
    status: 'building',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Lab' },
    ]),
  ],
};

const links: [string, string][] = [
  ['labIntro', 'labIndex'],
  ['labIndex', 'gridConcept'],
  ['gridConcept', 'gridPhoto'],
  ['gridConcept', 'ctrlHelp'],
  ['gridConcept', 'studioHelp'],
  ['ctrlHelp', 'gridApp'],
  ['studioHelp', 'gridView'],
  ['gridApp', 'gridView'],
  ['gridApp', 'gridTelemetry'],
  ['gridView', 'controlDesign'],
  ['controlDesign', 'gridOut'],
  ['gridOut', 'labSoon'],
];

// layout: content mode — row heights measure the ops (the GRID app/studio row
// is ~800px tall on its own), field height is computed (was a hardcoded
// 2660px), and gridView's old `calc(94vw - 440px)` width is just "7 columns".
const layout = {
  mode: 'content',
  padTop: 24,
  tiers: [{
    min: 0,
    cols: 12,
    areas: `
      intro intro intro intro intro .     .     .     index index index index
      conc  conc  conc  conc  conc  conc  .     .     photo photo photo photo
      chelp chelp chelp chelp .     .     .     .     shelp shelp shelp shelp
      app   app   app   app   .     gview gview gview gview gview gview gview
      .     .     .     .     .     .     .     .     .     tel   tel   tel
      cdes  cdes  cdes  cdes  cdes  cdes  .     gout  gout  gout  gout  .
      .     .     .     .     soon  soon  soon  soon  .     .     .     .
    `,
  }],
};
---

<Base
  title="Lab — Carlton Lindsay"
  description="Interactive experiments, generative sketches, and technical explorations."
  jsonLd={jsonLd}
>
  <PatchField id="labNet" links={links} density={0.3} height="2660px" layout={layout} label="Lab network — press P for reading mode">
    <Operator id="labIntro" name="input · lab_txt" type="txt" area="intro" ports="out">
      <h1 class="pd-h">Lab</h1>
      <p class="pd-p">
        Interactive experiments and technical explorations: things I'm
        building, testing, or just curious about.
      </p>
    </Operator>

    <Operator id="labIndex" name="experiments_index" type="data" area="index" nudge="0 24">
      <div class="pd-exps">
        {experiments.map((exp) => (
          <a href={exp.href} class="pd-exp">
            <span class="pd-status" data-live={exp.status === 'live'}>● {exp.status.toUpperCase()}</span>
            <span class="pd-title">{exp.title}</span>
            <span class="pd-desc">{exp.description}</span>
            <span class="pd-tags">{exp.tags.join(' · ')}</span>
          </a>
        ))}
      </div>
    </Operator>

    <!-- ============ EXPERIMENT 001 · GRID ============ -->
    <Operator id="gridConcept" name="input · grid_txt" type="txt" area="conc">
      <p class="gl-meta">EXPERIMENT 001 · KINETIC LIGHT · SIM FOR A HARDWARE BUILD IN PROGRESS</p>
      <h2 class="gl-h">GRID — a lamp you <span class="sig">sculpt</span></h2>
      <p class="pd-p">
        GRID is a lamp: sixteen frosted cylinders in a 4×4 bed, each on its
        own lead screw with its own tunable-white LEDs. Hold a cylinder, in
        the app or straight in the 3D scene, and it rises. Hold it again
        quickly and it lowers. Each cylinder is one number: height, brightness
        and color temperature all come from it. Low cylinders glow like a
        1800&nbsp;K ember; the light only cools toward the slider's ceiling as
        they rise.
      </p>
      <p class="pd-p">
        There are static set-points (Full, Night, Off, plus anything you
        sculpt and save) and four motion patterns: wave, ripple, fireplace,
        noise. The motors are simulated too, 28BYJ-48 steppers with
        trapezoidal ramps, so everything on screen moves at the speed the
        real lamp would.
      </p>
      <p class="pd-p">
        Both views below run off the same state. Change something in the app
        and the lamp follows. Works the other way too.
      </p>
      <p class="gl-spec">16 PTS · Ø50MM COLUMNS · 60MM PITCH · TRAVEL 60/110MM · 1800–6500K</p>
    </Operator>

    <!-- reserved slot: photo of the physical build, once it exists -->
    <Operator id="gridPhoto" name="grid_photo · build_log" type="view" area="photo" maxw={360} ports="in">
      <div class="gl-photoslot">
        <span>// BUILD PHOTO PENDING</span>
        <span class="gl-photosub">HARDWARE IN PROGRESS · SLOT RESERVED</span>
      </div>
    </Operator>

    <!-- how-to nodes sit on the cable feeding each surface -->
    <Operator id="ctrlHelp" name="help · ctrl_howto" type="txt" area="chelp">
      <ul class="gl-help">
        <li><b>TAP</b> a pad and its cylinder steps 10 mm · <b>HOLD</b> and it travels until you release</li>
        <li><b>RE-HOLD</b> quickly to reverse and lower</li>
        <li><b>FULL / NIGHT / OFF</b> are set-points · sculpt something and <b>SAVE</b> it as P1–P3</li>
        <li><b>MOTION</b> runs patterns (the grid becomes read-only) · <b>TEMP</b> sets the white-point ceiling · <b>RANGE</b> clamps travel</li>
      </ul>
    </Operator>

    <!-- app + studio share one viewport band: sculpt on the left,
         watch the lamp respond on the right -->
    <Operator id="gridApp" name="grid_ctrl · app_sim" type="view" area="app">
      <div class="gridlab glctr">
        <!-- .glduo carries .gridlab so the demo's vars/selectors travel with it into the dock -->
        <div class="gridlab glduo" data-duo="grid" data-duo-name="grid_ctrl">
        <div class="phone">
          <div class="bar">
            <span class="lampname">Studio</span>
            <div class="status"><span class="led"></span>connected</div>
          </div>

          <div class="core">
            <div class="seg" id="seg">
              <button data-fam="static" class="active">Static</button>
              <button data-fam="motion">Motion</button>
            </div>

            <div class="setpoints" id="setpoints">
              <button data-set="Full">Full</button>
              <button data-set="Night">Night</button>
              <button data-set="Off">Off</button>
              <button data-set="Custom" class="custom">Custom</button>
            </div>
            <div class="setpoints presetrow" id="presets">
              <button id="saveBtn" class="custom dim">Save</button>
            </div>

            <div class="modewrap" id="modewrap" style="display:none;">
              <select class="mode-select" id="mode" aria-label="Motion pattern"></select>
              <span class="chev">&#9662;</span>
            </div>

            <div class="device-frame">
              <span class="tick tl"></span><span class="tick tr"></span>
              <span class="tick bl"></span><span class="tick br"></span>
              <span class="notch"></span>
              <div class="device" id="device"></div>
            </div>
            <div class="holdhint" id="holdhint">Tap steps 10 mm &middot; hold to jog &middot; quick re-hold reverses</div>

            <div class="speed" id="speed">
              <span class="k">Speed</span>
              <div class="strack" id="spdTrack"><div class="sfill" id="spdFill"></div><div class="sknob" id="spdKnob"></div></div>
            </div>

            <div class="speed show" id="tempRow">
              <span class="k">Temp</span>
              <div class="strack temptrack" id="tmpTrack"><div class="sknob" id="tmpKnob"></div></div>
              <b class="kval" id="tempK">2700k</b>
            </div>

            <div class="limit">
              <div class="lab"><span>Range</span><b><span id="lfloor">0</span> &ndash; <span id="lceil">100</span></b></div>
              <div class="rtrack" id="rtrack">
                <div class="rspan" id="rspan"></div>
                <div class="rhandle" id="hfloor"></div>
                <div class="rhandle" id="hceil"></div>
              </div>
            </div>
          </div>

          <div class="foot">
            <span>16 pts</span>
            <span id="avg">avg 0%</span>
            <span id="ctemp">1800k</span>
          </div>
        </div>
        </div>
      </div>
    </Operator>

    <Operator id="studioHelp" name="help · studio_howto" type="txt" area="shelp">
      <ul class="gl-help">
        <li><b>DRAG</b> to orbit · <b>SCROLL</b> to zoom · <b>DOUBLE-CLICK</b> returns to the hero cam</li>
        <li><b>TAP / HOLD</b> a cylinder in the scene for the same steps and jogs as the app</li>
        <li><b>HERO / TOP / LOW</b> camera presets · <b>AUTO-ORBIT</b> spins the scene slowly</li>
        <li><b>60 / 110&nbsp;MM</b> switches the build-plan travel · stroke time updates live</li>
      </ul>
    </Operator>

    <Operator
      id="gridView"
      name="grid_view · studio_3d"
      type="view"
      area="gview"
    >
      <div class="gridlab glviewwrap" data-duo="grid" data-duo-name="grid_view">
        <div class="viewcard" id="viewcard">
          <canvas id="gl"></canvas>
          <div class="vignette"></div>
          <span class="vtick tl"></span><span class="vtick tr"></span>
          <span class="vtick bl"></span><span class="vtick br"></span>
          <div class="vtop"><span>Studio &middot; live</span></div>
          <div class="vctrl">
            <div class="vgroup">
              <button class="vbtn on" data-view="hero">Hero</button>
              <button class="vbtn" data-view="top">Top</button>
              <button class="vbtn" data-view="low">Low</button>
            </div>
            <div class="vgroup">
              <button class="vbtn" id="orbitBtn">Auto-orbit</button>
            </div>
            <div class="vgroup">
              <button class="vbtn" data-travel="6">60 mm</button>
              <button class="vbtn on" data-travel="11">110 mm</button>
            </div>
            <div class="vnote" id="travelNote"></div>
          </div>
          <div class="vhud"><span id="vhint">Drag to orbit &middot; scroll to zoom &middot; hold a cylinder to raise it</span></div>
          <div class="glposter" id="glposter">COOKING SIM &middot; THREE.JS LOADS ON APPROACH&hellip;</div>
        </div>
      </div>
    </Operator>

    <!-- SYS: live readout tapped off the shared state (hidden on small screens) -->
    <Operator id="gridTelemetry" name="sys · telemetry" type="sys" area="tel" maxw={260} ports="in">
      <div class="gl-tel">
        <span>AVG LEVEL</span><b id="telAvg">0%</b>
        <span>AVG COLOR</span><b id="telK">1800K</b>
        <span>IN TRANSIT</span><b id="telMove">0 / 16</b>
        <span>MODE</span><b id="telMode">STATIC · OFF</b>
      </div>
    </Operator>

    <!-- PROCESS: why the controls work the way they do — read after playing -->
    <Operator id="controlDesign" name="process · control_design" type="txt" area="cdes">
      <h3 class="gl-h3">Why the controls work this way</h3>
      <p class="pd-p">
        <b>Jog, not slider.</b> Hold means keep moving; release means stop.
        And the app draws where each cylinder actually is, not where you told
        it to go: anything still traveling gets a pulsing rim. I didn't want
        a screen showing a lamp that doesn't exist yet.
      </p>
      <p class="pd-p">
        <b>One number per cylinder.</b> Height, brightness and color are
        locked together on purpose. Dim light is always warm; there's no way
        to build a low, cold scene, and I consider that a feature. Night mode
        caps the ceiling at 2700&nbsp;K, and the cap eases in rather than
        snapping, the way firmware would fade it.
      </p>
      <p class="pd-p">
        <b>The motors set the rules.</b> Range clamps travel for everything:
        set-points, patterns, your fingers. And the patterns run through the
        same motor model as manual holds, so a fireplace flicker can only
        ever move as fast as a lead screw turns.
      </p>
    </Operator>

    <!-- OUT: what the sim settles, and what only hardware can answer -->
    <Operator id="gridOut" name="out · the_build" type="txt" area="gout" ports="in">
      <p class="pd-p">
        The sim exists so the hardware decisions get made cheaply. Jog feel,
        60 vs 110&nbsp;mm of travel, the shape of the warm-to-cool ramp,
        whether the patterns still read at real motor speed: all decided
        here, before committing to parts.
      </p>
      <p class="pd-p">
        Some questions only the build can answer. How loud are sixteen
        steppers in a quiet room? Does real frosted plastic scatter anything
        like the shader? How low can the LEDs dim before the ember falls
        apart?
      </p>
      <p class="gl-outnext">▸ NEXT · BUILD PHOTOS LAND IN grid_photo AS THE HARDWARE COMES TOGETHER</p>
    </Operator>

    <!-- placeholder for the next experiment -->
    <Operator id="labSoon" name="queue · exp_002" type="sys" area="soon" maxw={300} ports="in">
      <div class="gl-soon">
        <span class="gl-soonline">MORE COOKING<i class="gl-cursor">▮</i></span>
        <span class="gl-soonsub">NEXT EXPERIMENT LANDS HERE</span>
      </div>
    </Operator>
  </PatchField>

  <!-- Lazy bootstrap: nothing GRID-related loads until an experiment op nears
       the viewport; then three r128 → postprocessing → grid-lab.js, in order.
       Re-nav safe: CDN globals persist, GridLab.init() re-binds to fresh DOM. -->
  <script is:inline data-astro-rerun>
  (function () {
    var view = document.getElementById('gridView');
    var app = document.getElementById('gridApp');
    if (!view || view.dataset.glBoot) return;
    view.dataset.glBoot = '1';

    var STEPS = [
      // [global, url, required] — optional steps fail soft (grid-lab.js
      // falls back to sprite halos when POSTPROCESSING is absent)
      ['THREE', 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js', true],
      ['POSTPROCESSING', 'https://cdn.jsdelivr.net/npm/postprocessing@6.22.2/build/postprocessing.min.js', false],
      ['GridLab', '/js/grid-lab.js', true],
    ];
    function loadStep(i) {
      if (i >= STEPS.length) { window.GridLab && window.GridLab.init(); return; }
      if (window[STEPS[i][0]]) { loadStep(i + 1); return; }
      var s = document.createElement('script');
      s.src = STEPS[i][1];
      s.onload = function () { loadStep(i + 1); };
      s.onerror = function () {
        if (STEPS[i][2]) { console.warn('GRID: failed to load ' + STEPS[i][1]); return; }
        loadStep(i + 1);
      };
      document.head.appendChild(s);
    }
    var started = false;
    function start() { if (started) return; started = true; loadStep(0); }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); start(); }
      }, { rootMargin: '900px' });
      io.observe(view);
      if (app) io.observe(app);
    } else {
      start();
    }
  })();
  </script>
</Base>

<style>
  .pd-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .pd-p { font-size: 13px; color: var(--text-muted); line-height: 1.65; margin-bottom: 8px; }
  .pd-p:last-of-type { margin-bottom: 0; }

  .pd-exps { display: flex; flex-direction: column; }
  .pd-exp { display: block; padding: 14px 4px; border-bottom: 1px solid var(--border-color); text-decoration: none; }
  .pd-exp:last-child { border-bottom: none; }
  .pd-status { display: block; font-family: var(--font-mono); font-size: 9.5px; color: #e8c34a; margin-bottom: 4px; }
  .pd-status[data-live='true'] { color: var(--signal); }
  .pd-title { display: block; font-size: 15px; font-weight: 500; color: var(--text); margin-bottom: 4px; transition: color var(--duration-fast); }
  .pd-exp:hover .pd-title { color: var(--signal); }
  .pd-desc { display: block; font-size: 12.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 6px; }
  .pd-tags { display: block; font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); }

  .gl-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 8px;
    line-height: 1.6;
  }
  .gl-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 0.98;
    margin-bottom: 10px;
  }
  .gl-h .sig { color: var(--signal); }
  .gl-spec {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-top: 12px;
    line-height: 1.7;
  }

  /* reserved build-photo slot — swap the placeholder for an <img> when it lands */
  .gl-photoslot {
    aspect-ratio: 4 / 3;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }
  .gl-photoslot .gl-photosub { font-size: 8.5px; color: var(--text-dim); opacity: 0.7; }

  .gl-help {
    list-style: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .gl-help li { padding-left: 14px; position: relative; margin-bottom: 7px; }
  .gl-help li:last-child { margin-bottom: 0; }
  .gl-help li::before { content: '▸'; position: absolute; left: 0; color: var(--signal); }
  .gl-help b { color: var(--text); font-weight: 600; }

  .gl-h3 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 16px;
    margin-bottom: 10px;
  }
  .pd-p b { color: var(--text); font-weight: 600; }

  .gl-tel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 5px 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }
  .gl-tel b { color: var(--signal); font-weight: 400; text-align: right; }

  .gl-outnext {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--signal);
    margin-top: 12px;
    line-height: 1.7;
  }

  .gl-soon {
    display: grid;
    gap: 5px;
    justify-items: center;
    padding: 10px 4px;
    border: 1px dashed var(--border-color);
    border-radius: 4px;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-align: center;
  }
  .gl-soonline { font-size: 10.5px; color: var(--text-muted); }
  .gl-soonsub { font-size: 8.5px; color: var(--text-dim); }
  .gl-cursor { font-style: normal; color: var(--signal); animation: gl-blink 1.1s steps(1) infinite; }
  @keyframes gl-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .gl-cursor { animation: none; }
  }

  /* telemetry is patch garnish — drop it on small screens to keep READ quiet */
  @media (max-width: 767px) {
    :global(#gridTelemetry) { display: none !important; }
  }
</style>

<!-- GRID demo interiors — the experiment's own visual language, scoped under
     .gridlab (its DOM is partly JS-generated, so these can't be Astro-scoped).
     Palette is the prototype's warm studio gray; fonts map to site tokens. -->
<style is:global>
  .gridlab {
    --bg: #46433e; --line: #726c63; --line-soft: #5b5650;
    --ink: #e2ded6; --ink-dim: #a09a90; --ink-faint: #767066;
  }
  .glctr { display: flex; justify-content: center; }
  .glduo { width: min(360px, 100%); }

  /* ---------- controller ---------- */
  .gridlab .phone {
    width: min(360px, 100%); height: 740px; background: var(--bg); border-radius: 36px;
    overflow: hidden; position: relative; display: flex; flex-direction: column;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, .75); border: 1px solid #2e2b27;
  }
  .gridlab .bar { display: flex; align-items: center; justify-content: space-between; padding: 20px 26px 0; }
  .gridlab .lampname { font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink); }
  .gridlab .status { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em; color: var(--ink-faint); display: flex; align-items: center; gap: 6px; text-transform: uppercase; }
  .gridlab .status .led { width: 5px; height: 5px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 5px var(--ink); }

  .gridlab .core { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 13px; padding: 0 24px; }

  .gridlab .seg { display: flex; width: 100%; max-width: 300px; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
  .gridlab .seg button { flex: 1; background: transparent; border: none; color: var(--ink-dim); font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; padding: 9px 0; cursor: pointer; transition: all .2s; }
  .gridlab .seg button + button { border-left: 1px solid var(--line); }
  .gridlab .seg button.active { background: rgba(255, 255, 255, .08); color: var(--ink); }

  .gridlab .modewrap { position: relative; width: 100%; max-width: 300px; }
  .gridlab .mode-select { width: 100%; appearance: none; -webkit-appearance: none; background: transparent; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; padding: 10px 38px 10px 15px; cursor: pointer; text-align: center; }
  .gridlab .mode-select:focus { outline: none; border-color: var(--ink-dim); }
  .gridlab .modewrap .chev { position: absolute; right: 15px; top: 50%; transform: translateY(-32%); pointer-events: none; color: var(--ink-dim); font-size: 10px; }
  .gridlab .mode-select option { background: #34383a; color: var(--ink); }

  .gridlab .setpoints { display: flex; width: 100%; max-width: 300px; gap: 8px; }
  .gridlab .setpoints button { flex: 1; background: transparent; border: 1px solid var(--line-soft); border-radius: 7px; color: var(--ink-dim); font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; padding: 10px 0; cursor: pointer; transition: all .2s; }
  .gridlab .setpoints button:hover { border-color: var(--line); color: var(--ink); }
