---
/**
 * About — a small network.
 * bio_txt → experience_data → skills_data, wired left to right.
 * PERFORM stacks them in reading order (DOM order below).
 */
import Base from '../layouts/Base.astro';
import Operator from '../components/Operator.astro';
import PatchField from '../components/PatchField.astro';
import { aboutContent } from '../data/content.js';
import { getPersonJsonLd, getBreadcrumbJsonLd } from '../lib/seo.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getPersonJsonLd(),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'About' },
    ]),
  ],
};

const links: [string, string][] = [
  ['abBio', 'abXp'],
  ['abXp', 'abSkills'],
  ['abBio', 'abSkills'],
];
---

<Base
  title="About — Carlton Lindsay"
  description={aboutContent.intro}
  jsonLd={jsonLd}
>
  <PatchField id="aboutNet" links={links} density={0.3} height="920px" label="About network — press P for reading mode">
    <Operator id="abBio" name="input · bio_txt" type="txt" pos="left:4%; top:56px; width:min(500px,88vw);" ports="out">
      <h1 class="ab-h">About</h1>
      <p class="ab-intro">{aboutContent.intro}</p>
      <div class="ab-bio">
        {aboutContent.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Operator>

    <Operator id="abXp" name="experience_data" type="data" pos="right:5%; top:80px; width:min(430px,90vw);">
      <table class="ab-xp">
        {aboutContent.experience.map((entry) => (
          <tr>
            <td>
              <span class="ab-role">{entry.role}</span><br />
              <span class="dim">{entry.company}</span>
            </td>
            <td class="dim ab-dates">{entry.dates}</td>
          </tr>
        ))}
      </table>
    </Operator>

    <Operator id="abSkills" name="skills_data" type="data" pos="right:8%; bottom:64px; width:min(430px,90vw);" ports="in">
      <div class="ab-skills">
        {aboutContent.skills.map((skill) => <span class="ab-chip">{skill}</span>)}
      </div>
    </Operator>
  </PatchField>
</Base>

<style>
  .ab-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .ab-intro {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--signal);
    margin-bottom: 14px;
  }
  .ab-bio p {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 10px;
  }
  .ab-bio p:last-child { margin-bottom: 0; }

  .ab-xp { border-collapse: collapse; font-size: 12px; width: 100%; }
  .ab-xp td { padding: 8px 6px; border-bottom: 1px solid var(--border-color); vertical-align: top; }
  .ab-xp tr:last-child td { border-bottom: none; }
  .ab-role { font-weight: 500; }
  .ab-dates { font-family: var(--font-mono); font-size: 10.5px; white-space: nowrap; text-align: right; }
  .dim { color: var(--text-dim); font-size: 11.5px; }

  .ab-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .ab-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 9px;
    border-radius: 99px;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
