---
/**
 * Blog — patch document.
 * One TXT intro operator wired into a writing_index DATA operator.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchDoc from '../../components/PatchDoc.astro';
import { blogPosts } from '../../data/content.js';

const sortedPosts = [...blogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<Base
  title="Blog — Carlton Lindsay"
  description="Writing about design technology, AI tools, creative engineering, and the space between hardware and software."
>
  <PatchDoc meta={`${sortedPosts.length} POSTS COOKED`}>
    <Operator id="blogIntro" name="input · writing_txt" type="txt" ports="none">
      <h1 class="pd-h">Blog</h1>
      <p class="pd-p">Notes on building things at the edges of what's possible.</p>
    </Operator>

    <div class="oplink" aria-hidden="true"></div>

    <Operator id="blogIndex" name="writing_index" type="data" ports="none">
      {sortedPosts.length === 0 ? (
        <p class="pd-empty">0 POSTS COOKED — THE QUEUE IS WIRED, CHECK BACK.</p>
      ) : (
        <div class="pd-posts">
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="pd-post">
              <span class="pd-date">{post.date}</span>
              <span class="pd-title">{post.title}</span>
              <span class="pd-excerpt">{post.excerpt}</span>
            </a>
          ))}
        </div>
      )}
    </Operator>
  </PatchDoc>
</Base>

<style>
  .pd-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .pd-p { font-size: 13px; color: var(--text-muted); line-height: 1.65; }
  .pd-empty { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); letter-spacing: 0.08em; }

  .pd-posts { display: flex; flex-direction: column; }
  .pd-post {
    display: block;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
  }
  .pd-post:last-child { border-bottom: none; }
  .pd-date { display: block; font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); margin-bottom: 4px; }
  .pd-title { display: block; font-size: 15px; font-weight: 500; color: var(--text); margin-bottom: 4px; transition: color var(--duration-fast); }
  .pd-post:hover .pd-title { color: var(--signal); }
  .pd-excerpt { display: block; font-size: 12.5px; color: var(--text-muted); line-height: 1.6; }
</style>
