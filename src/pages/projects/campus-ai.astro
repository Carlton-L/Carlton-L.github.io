<script is:inline data-astro-rerun define:vars={{ CA }}>
/* coded_transcripts viewer. Quotes render as engine-style agent cards:
   theme badge + participant name + shift meta in the card head, verbatim
   quote as the body, Dovetail tag pills in the foot. The evidence map is
   a bipartite svg of the real coding matrix. Interaction-driven only. */
(() => {
  const wrap = document.getElementById('caVwrap');
  if (!wrap || wrap.dataset.booted) return;
  wrap.dataset.booted = '1';
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const svg = document.getElementById('caMap');
  const exEl = document.getElementById('caExcerpts');
  const countEl = document.getElementById('caVCount');
  const titleEl = document.getElementById('caVTheme');
  const featQ = document.getElementById('caFeatQ');
  const featB = document.getElementById('caFeatB');
  const featN = document.getElementById('caFeatN');
  const featM = document.getElementById('caFeatM');
  const feat = document.getElementById('caFeat');
  const resetBtn = document.getElementById('caReset');

  const P = Object.fromEntries(CA.participants.map((p) => [p.id, p]));
  const T = Object.fromEntries(CA.themes.map((t) => [t.id, t]));
  const SHORT = {
    discovery: 'DISCOVERY', transfer: 'SKILLS × INTEREST', proxy: 'PROXY COMMUNITIES',
    roadmap: 'ROADMAP', artifacts: 'ARTIFACTS', human: 'HUMAN CONTACT', time: 'TIME',
  };
  const tint = (hex, a) => {
    const n = parseInt(hex.slice(1), 16);
    return 'rgba(' + (n >> 16) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
  };
  const shiftOf = (p) => (p.from || '') + ' → ' + (p.to || '?') + (p.country ? ' · ' + p.country : '');

  let sel = { mode: 'all', id: null };

  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };

  /* ---- excerpt card (engine agent-card grammar) ---- */
  function card(theme, x) {
    const p = P[x.p] || {};
    const c = el('article', 'ca-x');
    c.style.borderColor = tint(theme.wong, 0.45);
    const head = el('div', 'ca-xhead');
    const badge = el('span', 'ca-xbadge', x.voice === 'researcher-summary' ? 'RESEARCHER NOTE' : SHORT[theme.id]);
    badge.style.color = theme.wong;
    badge.style.background = tint(theme.wong, 0.12);
    head.appendChild(badge);
    head.appendChild(el('b', 'ca-xname', p.name || '?'));
    head.appendChild(el('span', 'ca-xmeta', shiftOf(p)));
    c.appendChild(head);
    const body = el('div', 'ca-xbody');
    const q = el('p', 'ca-xq' + (x.voice === 'researcher-summary' ? ' rs' : ''), x.voice === 'researcher-summary' ? x.text : '“' + x.text + '”');
    body.appendChild(q);
    const tr = el('div', 'ca-xtags');
    (x.tags || []).forEach((t) => tr.appendChild(el('span', 'ca-xtag', t)));
    body.appendChild(tr);
    c.appendChild(body);
    return c;
  }

  /* ---- featured quote (same grammar, promoted) ---- */
  function feature(theme, x, label) {
    const p = P[x.p] || {};
    featB.textContent = label || SHORT[theme.id];
    featB.style.color = theme.wong;
    featB.style.background = tint(theme.wong, 0.12);
    featN.textContent = p.name || '?';
    featM.textContent = shiftOf(p);
    featQ.textContent = x.voice === 'researcher-summary' ? x.text : '“' + x.text + '”';
    feat.style.borderColor = tint(theme.wong, 0.45);
    /* fit the quote inside the FIXED-height box (op height must never
       change — a resized op re-resolves the layout and re-cooks the
       background dither) */
    const sizes = [17, 15, 13.5, 12, 10.5];
    for (let i = 0; i < sizes.length; i++) {
      featQ.style.fontSize = sizes[i] + 'px';
      if (featQ.scrollHeight <= featQ.clientHeight + 2) break;
    }
  }

  /* ---- stream ---- */
  function render() {
    exEl.textContent = '';
    let items = [];
    if (sel.mode === 'theme') {
      const t = T[sel.id];
      exEl.appendChild(el('p', 'ca-tnote', t.note + ' (' + t.taggedMoments + ' tagged moments, ' + t.participantCount + ' of 8 interviews.)'));
      items = t.excerpts.map((x) => [t, x]);
      titleEl.textContent = SHORT[sel.id];
      const star = t.excerpts.filter((x) => x.star)[0] || t.excerpts[0];
      feature(t, star, SHORT[sel.id] + ' · STAR');
    } else if (sel.mode === 'p') {
      const p = P[sel.id];
      CA.themes.forEach((t) => t.excerpts.forEach((x) => { if (x.p === sel.id) items.push([t, x]); }));
      titleEl.textContent = (p.name || '?').toUpperCase();
      if (items.length) feature(items[0][0], items[0][1], items[0][0] && SHORT[items[0][0].id]);
    } else {
      CA.themes.forEach((t) => {
        const star = t.excerpts.filter((x) => x.star)[0];
        if (star) items.push([t, star]);
      });
      titleEl.textContent = 'STAR QUOTES · ALL THEMES';
      feature(T.discovery, T.discovery.excerpts[0], 'DISCOVERY · STAR');
    }
    items.forEach(([t, x]) => exEl.appendChild(card(t, x)));
    countEl.textContent = items.length + ' EXCERPT' + (items.length === 1 ? '' : 'S') +
      (sel.mode === 'all' ? ' · ONE STAR PER THEME · CLICK THE MAP FOR MORE' : '');
    resetBtn.hidden = sel.mode === 'all';
    paintMap();
    if (!REDUCED) exEl.scrollTop = 0;
  }

  function doSelect(next) {
    if (next.mode === sel.mode && next.id === sel.id) return;
    sel = next;
    render();
  }

  /* ---- evidence map ---- */
  const NS = 'http://www.w3.org/2000/svg';
  const S = (tag, attrs) => {
    const n = document.createElementNS(NS, tag);
    for (const k in attrs) n.setAttribute(k, attrs[k]);
    return n;
  };
  const TX = 160, PX = 330;
  const themeY = {}, partY = {};
  CA.themes.forEach((t, i) => { themeY[t.id] = 52 + i * 58; });
  CA.participants.forEach((p, i) => { partY[p.id] = 42 + i * 54; });
  let maxW = 1;
  CA.themes.forEach((t) => Object.values(t.by || {}).forEach((v) => { if (v > maxW) maxW = v; }));

  const edges = [];
  CA.themes.forEach((t) => {
    Object.entries(t.by || {}).forEach(([pid, w]) => {
      const e = S('path', {
        d: 'M' + (TX + 10) + ' ' + themeY[t.id] + ' C ' + (TX + 70) + ' ' + themeY[t.id] + ', ' + (PX - 70) + ' ' + partY[pid] + ', ' + (PX - 12) + ' ' + partY[pid],
        fill: 'none',
        stroke: t.wong,
        'stroke-width': (0.6 + 2.6 * (w / maxW)).toFixed(2),
        opacity: '0.3',
        'data-t': t.id,
        'data-p': pid,
      });
      svg.appendChild(e);
      edges.push(e);
    });
  });

  const nodeGs = [];
  CA.themes.forEach((t) => {
    const g = S('g', { role: 'button', tabindex: '0', cursor: 'pointer', 'data-t': t.id, 'aria-label': 'Show theme: ' + t.title });
    g.appendChild(S('circle', { cx: TX, cy: themeY[t.id], r: 7, fill: t.wong }));
    const lab = S('text', { x: TX - 14, y: themeY[t.id] + 3, 'text-anchor': 'end', 'font-size': '8', fill: 'currentColor' });
    lab.textContent = SHORT[t.id] + ' · ' + t.taggedMoments;
    g.appendChild(lab);
    const act = () => doSelect({ mode: 'theme', id: t.id });
    g.addEventListener('click', act);
    g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
    svg.appendChild(g);
    nodeGs.push(g);
  });
  CA.participants.forEach((p) => {
    const g = S('g', { role: 'button', tabindex: '0', cursor: 'pointer', 'data-p': p.id, 'aria-label': 'Show participant: ' + p.name });
    g.appendChild(S('circle', { cx: PX, cy: partY[p.id], r: 9, fill: 'none', stroke: 'currentColor', 'stroke-width': '1' }));
    const ini = S('text', { x: PX, y: partY[p.id] + 3, 'text-anchor': 'middle', 'font-size': '8.5', fill: 'currentColor' });
    ini.textContent = p.name[0];
    g.appendChild(ini);
    const lab = S('text', { x: PX + 16, y: partY[p.id] + 3, 'font-size': '8.5', fill: 'currentColor' });
    lab.textContent = p.name.toUpperCase();
    g.appendChild(lab);
    const act = () => doSelect({ mode: 'p', id: p.id });
    g.addEventListener('click', act);
    g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
    svg.appendChild(g);
    nodeGs.push(g);
  });

  function paintMap() {
    edges.forEach((e) => {
      const on = sel.mode === 'all' ||
        (sel.mode === 'theme' && e.dataset.t === sel.id) ||
        (sel.mode === 'p' && e.dataset.p === sel.id);
      e.setAttribute('opacity', on ? (sel.mode === 'all' ? '0.3' : '0.75') : '0.06');
    });
    nodeGs.forEach((g) => {
      const on = sel.mode === 'all' ||
        (sel.mode === 'theme' && g.dataset.t === sel.id) ||
        (sel.mode === 'p' && g.dataset.p === sel.id) ||
        (sel.mode === 'theme' && g.dataset.p && T[sel.id].by[g.dataset.p]) ||
        (sel.mode === 'p' && g.dataset.t && T[g.dataset.t].by[sel.id]);
      g.setAttribute('opacity', on ? '1' : '0.28');
    });
  }

  resetBtn.addEventListener('click', () => doSelect({ mode: 'all', id: null }));
  render();

  /* ---- patch bus ---- */
  const net = window.Patch ? window.Patch.field('caNet') : null;
  const NOOP = function () {};
  const N = (id, spec) => (net ? net.node(id, spec) : { el: null, emit: NOOP, listen: NOOP, timeout: NOOP });

  const view = N('caViewer', {
    ins: {
      selection: (m) => {
        doSelect({ mode: 'theme', id: m.theme });
        const op = view.el;
        if (op) {
          op.classList.add('cooking');
          view.timeout(450, () => op.classList.remove('cooking'));
        }
      },
    },
  });

  document.querySelectorAll('.ca-evbtn').forEach((btn) => {
    const nid = btn.dataset.node;
    const theme = btn.dataset.theme;
    const node = N(nid, { outs: { selection: 'object' } });
    node.listen(btn, 'click', () => {
      node.emit('selection', { theme });
      if (!net || net.stub) doSelect({ mode: 'theme', id: theme });
      wrap.scrollIntoView({ behavior: REDUCED ? 'auto' : 'smooth', block: 'center' });
    });
  });
})();

/* FUNNEL.scn animator — template SVG, attribute mutations only (op height
   never changes). 9s loop, half-rate frames, self-terminating. */
(() => {
  const svg = document.getElementById('caFun');
  if (!svg || svg.dataset.booted) return;
  svg.dataset.booted = '1';
  const R = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dots = Array.from(svg.querySelectorAll('.cafdot'));
  const seats = Array.from(svg.querySelectorAll('.cafseat'));
  const bars = Array.from(svg.querySelectorAll('.cafbar'));
  const recs = Array.from(svg.querySelectorAll('.cafrec'));
  const cnt = document.getElementById('caFunCnt');
  if (R) {
    dots.forEach((d) => d.setAttribute('opacity', '0.18'));
    seats.forEach((s) => s.setAttribute('stroke', '#3dff88'));
    bars.forEach((b) => b.setAttribute('width', b.dataset.w));
    recs.forEach((r) => r.setAttribute('opacity', '1'));
    return;
  }
  const t0 = performance.now();
  let fc = 0;
  (function frame(now) {
    if (!svg.isConnected) return;
    if ((fc++ & 1) === 0) {
      const t = ((now - t0) / 1000) % 9;
      dots.forEach((d, i) => d.setAttribute('opacity', t > 0.4 + i * 0.028 ? '0.18' : '0.85'));
      seats.forEach((s, i) => s.setAttribute('stroke', t > 1.7 + i * 0.14 ? '#3dff88' : 'rgba(61,255,136,0.15)'));
      const n = Math.max(0, Math.min(1, (t - 3.1) / 2.4));
      cnt.textContent = Math.floor(n * 1117).toLocaleString();
      bars.forEach((b, i) => {
        const p = Math.max(0, Math.min(1, (t - 5.6 - i * 0.14) / 0.5));
        b.setAttribute('width', (p * b.dataset.w).toFixed(1));
      });
      recs.forEach((r, i) => r.setAttribute('opacity', t > 7.1 + i * 0.3 ? '1' : '0.12'));
    }
    requestAnimationFrame(frame);
  })(t0);
})();
</script>

<style>
  .sig { color: var(--signal); }
  .ca-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .ca-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    margin-bottom: 12px;
  }
  .ca-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .ca-h2 {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: 10px;
  }
  .ca-p { font-size: 13.5px; color: var(--text-muted); line-height: 1.7; margin-bottom: 10px; }
  .ca-p:last-of-type { margin-bottom: 0; }

  .ca-facts { display: grid; grid-template-columns: 1fr; gap: 10px; }
  .ca-facts dt { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; color: var(--text-dim); margin-bottom: 2px; }
  .ca-facts dd { font-size: 12px; color: var(--text); }

  /* ── chapter 01: research questions ── */
  .ca-rqs { display: grid; gap: 12px; }
  .ca-rq { display: flex; gap: 12px; align-items: flex-start; }
  .ca-rqn {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--signal);
    border: 1px solid var(--signal-dim);
    border-radius: 3px;
    padding: 3px 6px;
    flex: none;
    margin-top: 1px;
  }
  .ca-rqq { font-size: 13px; color: var(--text); line-height: 1.5; margin: 0 0 3px; }
  .ca-rqsub { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin: 0; }

  /* ── chapter 01: protocol waterfall ── */
  .ca-proto { margin-top: 14px; }
  .ca-prow { display: grid; grid-template-columns: 150px 1fr 30px; align-items: center; gap: 10px; padding: 3px 0; }
  .ca-plab { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.08em; color: var(--text-muted); text-align: right; }
  .ca-pbar { height: 10px; background: rgba(255, 255, 255, 0.04); border-radius: 2px; overflow: hidden; }
  .ca-pbar i { display: block; height: 100%; background: var(--signal); opacity: 0.75; border-radius: 2px; }
  .ca-pbar i[data-alt] { opacity: 0.4; }
  .ca-pmin { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); }
  .ca-ptotal { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.08em; color: var(--text-dim); margin-top: 8px; }
