---
/**
 * Campus AI — case-study network v2.1 (2026-07-06).
 *
 * Four chapters: 01 THE STUDY (methodology: research questions → screener
 * quotas → protocol waterfall → analysis pipeline) → 02 THE EVIDENCE
 * (coded_transcripts viewer: featured star quote + bipartite EVIDENCE MAP
 * + excerpt cards) → 03 WHAT WE FOUND (seven insight cards with SVG
 * vignettes) → 04 WHAT WE RECOMMENDED (four recs with recreated deck
 * diagrams).
 *
 * v2.1: quotes presented as engine-style agent cards (theme badge + name +
 * shift meta in a header strip, quote as card body — Carlton's call);
 * ALL styles for script-built DOM use the `.parent :global(.child)` idiom
 * (Astro scoping does NOT reach createElement'd nodes — v2 shipped
 * unstyled cards because of this); SVG text never sets font-family as an
 * attribute (presentation attributes can't resolve var()) — CSS does it.
 *
 * Signature move unchanged: insight ─selection→ viewer over the patch bus.
 * Data: src/data/demos/campus-ai/coded-excerpts.json (sanitized; README).
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';
import CA from '../../data/demos/campus-ai/coded-excerpts.json';

const project = projects.find((p) => p.slug === 'campus-ai');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects' },
      { name: 'Campus AI — Learning Research' },
    ]),
  ],
};

const RQS = [
  ['What must shifters know before the learning starts?', 'path choice · investigation · what to learn'],
  ['How do they prefer to learn, and how do they judge each method?', 'structure · tools · value of artifacts'],
  ['How do they maintain motivation over months of self-directed work?', 'life factors · learning factors'],
  ['Which tools and strategies worked, and which wasted their time?', 'challenges · pain points · dead ends'],
];

/* the 90-minute protocol, in order (minutes) */
const PROTO = [
  ['INTRO + SETUP', 10],
  ['GET TO KNOW', 14],
  ['RESEARCHING THE SHIFT', 12],
  ['LEARNING METHODS', 12],
  ['CHALLENGES', 10],
  ['QUALITY OF LEARNING', 14],
  ['AFTER THE SHIFT', 8],
  ['STAKEHOLDER Q&A', 8],
];
const PROTO_MAX = Math.max(...PROTO.map((s) => s[1]));

const INSIGHTS = [
  { id: 'caIns1', num: '01', theme: 'discovery', heading: 'Shifts start with people, not job boards', chips: ['11 MOMENTS · 7 OF 8', 'NAMED STUDY INSIGHT'], vig: 'discovery' },
  { id: 'caIns2', num: '02', theme: 'transfer', heading: 'Transferable skills point, personal interest pulls', chips: ['44 MOMENTS · 8 OF 8'], vig: 'transfer' },
  { id: 'caIns3', num: '03', theme: 'proxy', heading: 'Proxy communities do the validating', chips: ['77 MOMENTS · 8 OF 8 · DENSEST THEME'], vig: 'proxy' },
  { id: 'caIns4', num: '04', theme: 'roadmap', heading: 'They want a playbook for the whole shift', chips: ['17 MOMENTS · 5 OF 8'], vig: 'roadmap' },
  { id: 'caIns5', num: '05', theme: 'artifacts', heading: 'Progress is something you can show', chips: ['41 MOMENTS · 7 OF 8', 'CERTS: 11 OF 1,117'], vig: 'artifacts' },
  { id: 'caIns6', num: '06', theme: 'human', heading: 'Human contact: most valued, least supplied', chips: ['72 MOMENTS · 7 OF 8'], vig: 'human' },
  { id: 'caIns7', num: '07', theme: 'time', heading: 'Time is the currency of the shift', chips: ['41 MOMENTS · 8 OF 8'], vig: 'time' },
];

const RECS = [
  { id: 'caRec1', num: '01', heading: 'Give the AI a human face', ev: 'FROM ▸ CREDIBILITY + INSTRUCTOR-EXPERIENCE TAGS · INSIGHTS 03 + 06', vig: 'persona' },
  { id: 'caRec2', num: '02', heading: 'Proxy feedback in the peer gap', ev: 'FROM ▸ LACK-OF-PEERS + FEEDBACK-LOOP TAGS · INSIGHT 06', vig: 'loop' },
  { id: 'caRec3', num: '03', heading: 'Destination on screen from day one', ev: 'FROM ▸ ROADMAP + TIME THEMES · INSIGHTS 04 + 07', vig: 'gps' },
  { id: 'caRec4', num: '04', heading: 'Build the roadmap against the live job market', ev: 'FROM ▸ JOB-DESCRIPTION SELF-ASSESSMENT · INSIGHTS 04 + 05', vig: 'market' },
];

/* SVG vignettes — deck diagrams recreated in site grammar. Text nodes carry
   NO font-family attribute (attrs can't resolve var()); .ca-vig CSS sets it. */
const VIGS = {
  discovery: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="26" cy="30" r="9" fill="none" stroke="#CC79A7" stroke-width="1.5"/><circle cx="26" cy="23" r="4" fill="#CC79A7"/><path d="M44 30 H118" stroke="var(--text-dim)" stroke-dasharray="3 4"/><path d="M112 26 l8 4 -8 4z" fill="var(--text-dim)"/><g stroke="var(--text-dim)" fill="none"><circle cx="146" cy="18" r="6"/><circle cx="168" cy="32" r="6"/><circle cx="146" cy="46" r="6"/></g><text x="26" y="58" text-anchor="middle" font-size="7" fill="var(--text-dim)">A PERSON</text><text x="157" y="60" text-anchor="middle" font-size="7" fill="var(--text-dim)">THE PATHS</text></svg>`,
  transfer: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="80" cy="30" r="20" fill="none" stroke="var(--text-dim)"/><circle cx="116" cy="30" r="20" fill="none" stroke="#F0E442"/><path d="M98 13 a20 20 0 0 1 0 34 a20 20 0 0 1 0 -34z" fill="#F0E442" opacity="0.25"/><text x="52" y="60" font-size="6.5" fill="var(--text-dim)">WHAT CARRIES</text><text x="106" y="60" font-size="6.5" fill="#F0E442">WHAT PULLS</text></svg>`,
  proxy: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="30" cy="30" r="8" fill="none" stroke="#56B4E9" stroke-width="1.5"/><g stroke="#56B4E9" stroke-dasharray="2 4" fill="none"><path d="M38 26 C 80 8, 120 8, 158 16"/><path d="M38 30 H150"/><path d="M38 34 C 80 52, 120 52, 158 44"/></g><g fill="none" stroke="var(--text-dim)"><circle cx="166" cy="14" r="5"/><circle cx="158" cy="30" r="5"/><circle cx="166" cy="46" r="5"/></g><text x="30" y="54" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">LEARNER</text><text x="130" y="62" font-size="6.5" fill="var(--text-dim)">STRANGERS AHEAD</text></svg>`,
  roadmap: `<svg viewBox="0 0 200 64" aria-hidden="true"><path d="M14 44 C 60 44, 60 20, 104 20 S 168 32, 186 28" fill="none" stroke="#E69F00" stroke-width="1.5"/><g fill="#E69F00"><circle cx="14" cy="44" r="3.5"/><circle cx="66" cy="29" r="3.5"/><circle cx="120" cy="20" r="3.5"/><circle cx="186" cy="28" r="3.5"/></g><g font-size="6.5" fill="var(--text-dim)"><text x="8" y="57">BREAK OUT</text><text x="50" y="14">LEARN · BUILD</text><text x="134" y="48">LAND THE JOB</text></g></svg>`,
  artifacts: `<svg viewBox="0 0 200 64" aria-hidden="true"><g fill="none" stroke="#009E73" stroke-width="1.5"><rect x="24" y="36" width="44" height="12" rx="2"/><rect x="30" y="22" width="38" height="12" rx="2"/><rect x="36" y="8" width="30" height="12" rx="2"/></g><path d="M50 52 l5 5 9 -10" fill="none" stroke="#009E73" stroke-width="1.5"/><rect x="128" y="16" width="48" height="28" rx="3" fill="none" stroke="var(--text-dim)" stroke-dasharray="3 3"/><text x="152" y="33" text-anchor="middle" font-size="7.5" fill="var(--text-dim)">CERT</text><text x="46" y="63" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">THINGS BUILT</text><text x="152" y="57" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">DOOR PASS ONLY</text></svg>`,
  human: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="46" cy="30" r="12" fill="none" stroke="#0072B2" stroke-width="1.5"/><circle cx="154" cy="30" r="12" fill="#0072B2" opacity="0.28"/><circle cx="154" cy="30" r="12" fill="none" stroke="#0072B2" stroke-width="1.5"/><path d="M62 22 C 90 10, 116 10, 140 20" fill="none" stroke="var(--text-dim)"/><path d="M134 16 l8 4 -9 3z" fill="var(--text-dim)"/><path d="M138 40 C 112 50, 88 50, 64 40" fill="none" stroke="var(--text-dim)"/><path d="M70 44 l-8 -4 9 -3z" fill="var(--text-dim)"/><g font-size="6.5" fill="var(--text-dim)"><text x="46" y="58" text-anchor="middle">MENTOR · PEER</text><text x="154" y="58" text-anchor="middle">LEARNER</text></g></svg>`,
  time: `<svg viewBox="0 0 200 64" aria-hidden="true"><g stroke="var(--text-dim)" fill="none"><rect x="30" y="8" width="140" height="42" rx="3"/><path d="M30 20 H170"/><path d="M58 20 V50 M86 20 V50 M114 20 V50 M142 20 V50"/></g><g fill="var(--text-dim)" opacity="0.55"><rect x="33" y="23" width="22" height="12"/><rect x="61" y="23" width="22" height="24"/><rect x="89" y="23" width="22" height="18"/><rect x="117" y="23" width="22" height="24"/><rect x="145" y="23" width="22" height="14"/></g><g fill="#D55E00"><rect x="33" y="37" width="22" height="10"/><rect x="89" y="44" width="22" height="3"/><rect x="145" y="40" width="22" height="7"/></g><text x="100" y="61" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">LEARNING LIVES IN THE MARGINS</text></svg>`,
  persona: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="44" cy="24" r="12" fill="none" stroke="var(--signal)" stroke-width="1.5"/><circle cx="44" cy="19" r="4" fill="var(--signal)"/><path d="M36 30 a8 6 0 0 1 16 0" fill="var(--signal)"/><rect x="14" y="42" width="60" height="12" rx="6" fill="none" stroke="var(--signal)"/><text x="44" y="50.5" text-anchor="middle" font-size="6" fill="var(--signal)">PROFESSOR AI</text><g fill="none" stroke="var(--text-dim)"><rect x="96" y="10" width="86" height="12" rx="3"/><rect x="96" y="26" width="86" height="12" rx="3"/><rect x="96" y="42" width="60" height="12" rx="3"/></g><text x="96" y="63" font-size="6" fill="var(--text-dim)">PINNED TO A FACE</text></svg>`,
  loop: `<svg viewBox="0 0 200 64" aria-hidden="true"><circle cx="44" cy="30" r="12" fill="var(--signal)" opacity="0.22"/><circle cx="44" cy="30" r="12" fill="none" stroke="var(--signal)" stroke-width="1.5"/><text x="44" y="33" text-anchor="middle" font-size="8" fill="var(--signal)">AI</text><circle cx="156" cy="30" r="12" fill="none" stroke="var(--text-dim)" stroke-width="1.5"/><path d="M58 22 C 88 10, 114 10, 142 20" fill="none" stroke="var(--text-dim)"/><path d="M136 16 l8 4 -9 3z" fill="var(--text-dim)"/><text x="100" y="9" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">FEEDBACK</text><path d="M142 40 C 114 50, 88 50, 62 40" fill="none" stroke="var(--text-dim)"/><path d="M68 44 l-8 -4 9 -3z" fill="var(--text-dim)"/><text x="100" y="61" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">QUESTIONS · ARTIFACTS</text><text x="156" y="52" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">LEARNER</text></svg>`,
  gps: `<svg viewBox="0 0 200 64" aria-hidden="true"><path d="M14 48 C 50 48, 60 20, 96 20 S 160 28, 178 20" fill="none" stroke="var(--signal)" stroke-width="1.5"/><path d="M60 34 C 74 46, 96 50, 116 42 C 130 36, 138 26, 148 23" fill="none" stroke="var(--text-dim)" stroke-dasharray="3 3"/><circle cx="60" cy="34" r="3" fill="var(--text-dim)"/><path d="M178 20 v-11 h9 l-3 3 3 3 h-6" fill="none" stroke="var(--signal)" stroke-width="1.5"/><text x="60" y="60" text-anchor="middle" font-size="6.5" fill="var(--text-dim)">WRONG TURN → RE-ROUTE</text><text x="150" y="49" text-anchor="middle" font-size="6.5" fill="var(--signal)">SAME DESTINATION</text></svg>`,
  market: `<svg viewBox="0 0 200 64" aria-hidden="true"><g fill="none" stroke="var(--text-dim)"><rect x="10" y="8" width="58" height="12" rx="6"/><rect x="10" y="25" width="62" height="12" rx="6"/><rect x="10" y="42" width="46" height="12" rx="6"/></g><g font-size="6.5" fill="var(--text-dim)"><text x="16" y="16.5">REACT · 1.2K</text><text x="16" y="33.5">FIGMA · 2.4K</text><text x="16" y="50.5">SQL · 890</text></g><path d="M82 31 H120" stroke="var(--text-dim)"/><path d="M114 27 l8 4 -8 4z" fill="var(--text-dim)"/><path d="M134 42 C 148 42, 148 18, 164 18 S 186 28, 192 26" fill="none" stroke="var(--signal)" stroke-width="1.5"/><g fill="var(--signal)"><circle cx="134" cy="42" r="3"/><circle cx="164" cy="18" r="3"/></g><text x="104" y="61" font-size="6" fill="var(--text-dim)">LIVE POSTINGS → WAYPOINTS</text></svg>`,
};

/* FUNNEL.scn — the same scene as the homepage previs preview, hosted at the
   top of the page. Static SVG in the template (scoped CSS reaches it);
   the script only mutates attributes. Real study numbers. */
const FUN = {
  stages: [['SCREENED', 46], ['SEATS', 132], ['HIGHLIGHTS', 214], ['THEMES', 300], ['RECS', 376]],
  arrows: [88, 172, 256, 338],
  dots: Array.from({ length: 42 }, (_, d) => [24 + (d % 6) * 9, 104 + Math.floor(d / 6) * 9]),
  seats: Array.from({ length: 8 }, (_, s) => [118 + (s % 2) * 26, 90 + Math.floor(s / 2) * 22]),
  bars: [
    ['#CC79A7', 11], ['#F0E442', 44], ['#56B4E9', 77], ['#E69F00', 17],
    ['#009E73', 41], ['#0072B2', 72], ['#D55E00', 41],
  ],
  recs: ['HUMAN FACE', 'PROXY FEEDBK', 'GPS ROUTE', 'JOB MARKET'],
};

const links: [string, string][] = [
  ['caTitle', 'caFacts'],
  ['caTitle', 'caFunView'],
  ['caFunView', 'caBreak1'],
  ['caBreak1', 'caQ'],
  ['caQ', 'caBuilt'],
  ['caBuilt', 'caProto'],
  ['caProto', 'caScreen'],
  ['caScreen', 'caPipe'],
  ['caPipe', 'caBreak2'],
  ['caBreak2', 'caMethod'],
  ['caMethod', 'caViewer'],
  ['caViewer', 'caBreak3'],
  ['caBreak3', 'caIns1'],
  ['caIns1', 'caIns2'],
  ['caIns2', 'caIns3'],
  ['caIns3', 'caIns4'],
  ['caIns4', 'caIns5'],
  ['caIns5', 'caIns6'],
  ['caIns6', 'caIns7'],
  ['caIns1:selection', 'caViewer'],
  ['caIns2:selection', 'caViewer'],
  ['caIns3:selection', 'caViewer'],
  ['caIns4:selection', 'caViewer'],
  ['caIns5:selection', 'caViewer'],
  ['caIns6:selection', 'caViewer'],
  ['caIns7:selection', 'caViewer'],
  ['caIns7', 'caBreak4'],
  ['caBreak4', 'caRec1'],
  ['caRec1', 'caRec2'],
  ['caRec2', 'caRec3'],
  ['caRec3', 'caRec4'],
  ['caRec4', 'caOutc'],
  ['caOutc', 'caOut'],
];

const layout = {
  mode: 'content',
  padTop: 48,
  tiers: [{
    min: 0,
    cols: 12,
    areas: `
      title title title title title .     .     .     .     facts facts facts
      .     .     fv    fv    fv    fv    fv    fv    fv    fv    .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     .     br1   br1   br1   br1   br1   br1   br1   br1   .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     q     q     q     q     .     .     built built built built .
      .     proto proto proto proto proto .     scr   scr   scr   scr   .
      .     .     .     pipe  pipe  pipe  pipe  pipe  pipe  .     .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     .     br2   br2   br2   br2   br2   br2   br2   br2   .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     meth  meth  meth  meth  .     .     .     .     .     .     .
      .     view  view  view  view  view  view  view  view  view  view  .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     .     br3   br3   br3   br3   br3   br3   br3   br3   .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     i1    i1    i1    .     i2    i2    i2    .     i3    i3    i3
      .     i4    i4    i4    .     i5    i5    i5    .     i6    i6    i6
      .     .     .     .     i7    i7    i7    i7    .     .     .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     .     br4   br4   br4   br4   br4   br4   br4   br4   .     .
      .     .     .     .     .     .     .     .     .     .     .     .
      .     r1    r1    r1    r1    .     .     r2    r2    r2    r2    .
      .     r3    r3    r3    r3    .     .     r4    r4    r4    r4    .
      outc  outc  outc  outc  outc  .     .     .     .     out   out   out
    `,
  }],
};

const AREA_INS = ['i1', 'i2', 'i3', 'i4', 'i5', 'i6', 'i7'];
const AREA_REC = ['r1', 'r2', 'r3', 'r4'];
---

<Base
  title="Campus AI — Claims With Receipts | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="caNet" links={links} density={0.3} height="7900px" layout={layout} label="Campus AI case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="caTitle" name="input · the_brief" type="txt" area="title" ports="out">
      <p class="ca-meta">{project.meta}</p>
      <h1 class="ca-h">Claims with <span class="sig">receipts</span></h1>
      <p class="ca-sub">// 42 SURVEYED · 8 INTERVIEWED · 1,117 CODED MOMENTS. PICK ANY CLAIM AND WALK TO THE EVIDENCE IT STANDS ON.</p>
      {cs['The question'].map((p) => <p class="ca-p">{p}</p>)}
    </Operator>

    <Operator id="caFacts" name="facts_data" type="data" area="facts" maxw={300}>
      <dl class="ca-facts">
        <div><dt>ROLE</dt><dd>{project.facts.role}</dd></div>
        <div><dt>YEAR</dt><dd>{project.facts.year}</dd></div>
        <div><dt>METHOD</dt><dd>{project.facts.stack}</dd></div>
        <div><dt>CONTEXT</dt><dd>{project.facts.company}</dd></div>
      </dl>
    </Operator>

    <!-- VIEW: FUNNEL.scn — the pipeline cooking (same scene as the homepage preview) -->
    <Operator id="caFunView" name="campus_ai_view · FUNNEL.scn" type="view" area="fv" maxw={680}>
      <div class="ca-funwrap">
        <svg id="caFun" viewBox="0 0 420 240" aria-label="The research pipeline animated: 42 screened become 8 interviews, 1,117 coded moments, 7 themes and 4 recommendations">
          {FUN.stages.map(([lab, x]) => <text x={x} y="26" text-anchor="middle" font-size="7" letter-spacing="1" fill="#6b6b66">{lab}</text>)}
          {FUN.arrows.map((x) => <text x={x} y="128" text-anchor="middle" font-size="9" fill="#3dff88">─▸</text>)}
          {FUN.dots.map(([cx, cy]) => <circle class="cafdot" cx={cx} cy={cy} r="2.6" fill="#9f9f98" opacity="0.85" />)}
          {FUN.seats.map(([cx, cy]) => <circle class="cafseat" cx={cx} cy={cy} r="7" fill="none" stroke="rgba(61,255,136,0.15)" />)}
          <text id="caFunCnt" x="214" y="124" text-anchor="middle" font-size="20" font-weight="700" fill="#e6e6e2">1,117</text>
          <text x="214" y="140" text-anchor="middle" font-size="6" letter-spacing="1" fill="#6b6b66">CODED MOMENTS</text>
          {FUN.bars.map(([col, n], i) => (
            <g>
              <rect x="282" y={66 + i * 15} width="40" height="8" rx="2" fill="rgba(255,255,255,0.06)" />
              <rect class="cafbar" x="282" y={66 + i * 15} width="0" height="8" rx="2" fill={col} data-w={(n / 77) * 40} />
            </g>
          ))}
          {FUN.recs.map((lab, i) => (
            <g class="cafrec" opacity="0.12">
              <rect x="346" y={62 + i * 26} width="62" height="16" rx="3" fill="none" stroke="#3dff88" />
              <text x="377" y={72.5 + i * 26} text-anchor="middle" font-size="6" letter-spacing="0.5" fill="#3dff88">{lab}</text>
            </g>
          ))}
        </svg>
        <p class="ca-funfoot">42 SCREENED → 8 INTERVIEWED → 1,117 CODED → 7 THEMES → 4 RECOMMENDATIONS · REAL STUDY NUMBERS</p>
      </div>
    </Operator>

    <!-- CHAPTER 01 · THE STUDY -->
    <Operator id="caBreak1" name="section_break" type="sys" area="br1" ports="both">
      <div class="ca-break">
        <span class="ca-break-num">01</span>
        <span class="ca-break-rule" aria-hidden="true"></span>
        <span class="ca-break-label">THE STUDY</span>
        <span class="ca-break-rule" aria-hidden="true"></span>
      </div>
    </Operator>

    <Operator id="caQ" name="process · research_questions" type="txt" area="q">
      <h2 class="ca-h2">Four research questions</h2>
      <div class="ca-rqs">
        {RQS.map(([q, sub], i) => (
          <div class="ca-rq">
            <span class="ca-rqn">RQ{i + 1}</span>
            <div>
              <p class="ca-rqq">{q}</p>
              <p class="ca-rqsub">{sub}</p>
            </div>
          </div>
        ))}
      </div>
    </Operator>

    <Operator id="caBuilt" name="process · how_it_was_built" type="txt" area="built" nudge="0 40">
      <h2 class="ca-h2">How the study was built</h2>
      {cs['How the study was built'].map((p) => <p class="ca-p">{p}</p>)}
    </Operator>

    <Operator id="caProto" name="process · how_a_session_ran" type="txt" area="proto" maxw={620}>
      <h2 class="ca-h2">How a session ran</h2>
      {cs['How a session ran'].map((p) => <p class="ca-p">{p}</p>)}
      <div class="ca-proto" role="img" aria-label="The 90-minute interview protocol: eight movements from intro to stakeholder questions, sized by minutes">
        {PROTO.map(([label, min], i) => (
          <div class="ca-prow">
            <span class="ca-plab">{label}</span>
            <span class="ca-pbar"><i style={`width:${Math.round((min / PROTO_MAX) * 100)}%`} data-alt={i % 2 ? '1' : undefined}></i></span>
            <span class="ca-pmin">{min}′</span>
          </div>
        ))}
        <p class="ca-ptotal">Σ 88′ IN THE GUIDE · 90′ ON THE CALENDAR — THE BUFFER WAS REAL</p>
