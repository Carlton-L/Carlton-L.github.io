---
/**
 * FAST: case-study network (rev 2, 2026-11-14).
 *
 * Title + ownership → self-playing subject page → what it is →
 * 01 THE NETWORK (subject page, traversal demo, three decisions) →
 * 02 SETTING UP A WORKSPACE WITH AI (Lab Builder: decisions tagged by trust-triangle corner,
 *    the Lab Builder demo, then the by-hand path and the gather board) →
 * outcome → next case.
 *
 * Accepted prototype: docs/prototypes/fast-case-study-restructure.html (#hl=b&hd=a).
 * Prose comes from src/data/content.js. FAST is recreation-only. Do not embellish.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import DecisionCard from '../../components/case/DecisionCard.astro';
import NextCase from '../../components/case/NextCase.astro';
import OwnershipMeter from '../../components/case/OwnershipMeter.astro';
import SectionBreak from '../../components/case/SectionBreak.astro';
import ViewSlot from '../../components/ViewSlot.astro';
import PatchField from '../../components/PatchField.astro';
import FastHero from '../../components/react/demos/fast/FastHero.jsx';
import FastGraphDemo from '../../components/react/demos/fast/FastGraphDemo.jsx';
import FastGatherDemo from '../../components/react/demos/fast/FastGatherDemo.jsx';
import FastLabBuilderDemo from '../../components/react/demos/fast/FastLabBuilderDemo.jsx';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'fast');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));
// Decision titles that are also content.js headings, used in both places.
const D1 = 'Move through the network';
const D4 = 'Name every wait';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects/' },
      { name: 'FAST' },
    ]),
  ],
};

const links: [string, string][] = [
  ['fastTitle', 'fastHero'],
  ['fastTitle', 'fastOwn'],
  ['fastHero', 'fastWhat'],
  ['fastWhat', 'fastFacts'],
  ['fastWhat', 'fastBreak1'],
  ['fastBreak1', 'fastSubjSect'],
  ['fastSubjSect', 'fastSubjTxt'],
  ['fastSubjTxt', 'fastSubjView'],
  ['fastSubjView', 'fastD1'],
  ['fastD1', 'fastD2'],
  ['fastD2', 'fastD3'],
  ['fastD3', 'fastBreak2'],
  ['fastBreak2', 'fastLbSect'],
  ['fastLbSect', 'fastLbTxt'],
  ['fastLbTxt', 'fastLbAsk'],
  ['fastLbAsk', 'fastD4'],
  ['fastD4', 'fastD5'],
  ['fastD5', 'fastD6'],
  ['fastD6', 'fastLbTry'],
  ['fastLbTry', 'fastLabBuilder'],
  ['fastLabBuilder', 'fastHand'],
  ['fastHand', 'fastLabView'],
  ['fastLabView', 'fastOutcome'],
  ['fastOutcome', 'fastOut'],
];

// Flex layout: the page is a column of rows. Words: flexLayout in src/lib/patch-field.js.
// 'area:w' is a card w twelfths wide. inset is side padding in columns. gap and mt are grid units (26px).
const layout = {
  mode: 'flex',
  padTop: 48,
  gap: 2,
  rows: [
    { row: ['title:5', 'own:3'], justify: 'between' },
    { row: ['hero:10'], justify: 'center' },
    { row: ['what:6', 'facts:3'], justify: 'center' },
    { row: ['br1:8'], justify: 'center', mt: 1 },
    { row: ['ssect:4', 'subj:4'], justify: 'center', gap: 8, mt: 1 },
    { row: ['sview:10'], justify: 'center' },
    { row: ['d1:3', { op: 'd2', w: 3, mt: 1.5 }, { op: 'd3', w: 3, mt: 3 }], justify: 'between', inset: 1 },
    { row: ['br2:8'], justify: 'center', mt: 1 },
    { row: ['lsect:4', 'ltxt:4'], justify: 'center', gap: 8, mt: 1 },
    { row: ['lask:4'], justify: 'center' },
    { row: ['d4:3', { op: 'd5', w: 3, mt: 1.5 }, { op: 'd6', w: 3, mt: 3 }], justify: 'between', inset: 1 },
    { row: ['ltry:4'], justify: 'center' },
    { row: ['lbview:10'], justify: 'center' },
    { row: ['hand:5'], justify: 'center' },
    { row: ['lview:10'], justify: 'center' },
    { row: ['outc:5', 'out:4'], justify: 'between' },
  ],
};
---

<Base
  title="FAST — A Knowledge Network You Can Walk Through | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="fastNet" links={links} height="6200px" layout={layout} label="FAST case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="fastTitle" name="input · the_problem" type="txt" area="title" ports="out">
      <p class="fs-meta">{project.meta}</p>
      <h1 class="fs-h">A knowledge network you can <span class="amb">walk through</span></h1>
      <p class="fs-sub">{"// SUBJECTS, ORGANIZATIONS, PRESS, PATENTS, PAPERS, BOOKS. ONE GRAPH, AND AN AI THAT HELPS YOU FIND YOUR WAY THROUGH IT."}</p>
    </Operator>

    <!-- OWNERSHIP (honest; only verified numbers get bars) -->
    <OwnershipMeter
      id="fastOwn"
      rows={[['UX/UI DESIGN', 100], ['FRONTEND', 100], ['AI FEATURES', 100]]}
      note="EVERY SCREEN DESIGNED AND BUILT BY ME. LAB BUILDER BUILT BY ME FROM A CLAUDE SKILL, ON AN ON-PREM MODEL A TEAMMATE SET UP."
    />

    <!-- VIEW (opener): the subject page, composed and self-playing -->
    <Operator id="fastHero" name="subject_view · live_hero" type="view" area="hero" maxw={900}>
      <div class="fs-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · SELF-PLAYING SUBJECT PAGE…" bg="#111111">
          <FastHero client:settled />
        </ViewSlot>
      </div>
    </Operator>

    <Operator id="fastWhat" name="txt · what_it_is" type="txt" area="what">
      {cs['What it is'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <Operator id="fastFacts" name="facts_data" type="data" area="facts">
      <dl class="fs-facts">
        <div><dt>ROLE</dt><dd>{project.facts.role}</dd></div>
        <div><dt>YEAR</dt><dd>{project.facts.year}</dd></div>
        <div><dt>STACK</dt><dd>{project.facts.stack}</dd></div>
        <div><dt>CONTEXT</dt><dd>{project.facts.company}</dd></div>
      </dl>
    </Operator>

    <!-- SECTION BREAK 01 -->
    <SectionBreak id="fastBreak1" area="br1" num={1} label="THE NETWORK" />

    <Operator id="fastSubjSect" name="process · the_hero_surface" type="txt" area="ssect">
      <p class="fs-meta">PROCESS · THE SUBJECT PAGE</p>
      <h2 class="fs-h2">The subject page is a <span class="amb">portal</span></h2>
      <p class="fs-sub">The live graph underneath, identity above, analytics below.</p>
    </Operator>

    <Operator id="fastSubjTxt" name="txt · the_page_in_layers" type="txt" area="subj">
      {cs['The subject page'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <!-- VIEW: the interactive graph: click a node, traverse to its subject -->
    <Operator id="fastSubjView" demo="fastSubjView" name="subject_view · knowledge_graph" type="view" area="sview" maxw={900}>
      <div class="fs-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · SUBJECT PAGE · CLICK TO TRAVERSE…" bg="#111111">
          <FastGraphDemo client:settled={{ rootMargin: '600px' }} />
        </ViewSlot>
      </div>
    </Operator>

    <DecisionCard id="fastD1" area="d1" num={1} slug="traversal" title={D1}>
      {cs[D1].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <DecisionCard id="fastD2" area="d2" num={2} slug="honest_waiting" title="Honest waiting">
      {cs['Honest waiting'].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <DecisionCard id="fastD3" area="d3" num={3} slug="one_click_deep" title="Overview to detail in one click">
      {cs['Overview to detail in one click'].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <!-- SECTION BREAK 02 -->
    <SectionBreak id="fastBreak2" area="br2" num={2} label="SETTING UP A WORKSPACE WITH AI" />

    <Operator id="fastLbSect" name="process · lab_builder" type="txt" area="lsect">
      <p class="fs-meta">PROCESS · FROM A CLAUDE SKILL TO AN INTERFACE</p>
      <h2 class="fs-h2">Describe the work, get the <span class="amb">workspace</span></h2>
      <p class="fs-sub">Answer a few questions. Lab Builder drafts the goals, finds the subjects and sorts them. Then you change anything you want, in your own words.</p>
    </Operator>

    <Operator id="fastLbTxt" name="txt · skill_to_interface" type="txt" area="ltxt">
      {cs['Skill to interface'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <Operator id="fastLbAsk" name="txt · one_question" type="txt" area="lask">
      <h3 class="cs-dh">One question at a time</h3>
      {cs['One question at a time'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <DecisionCard id="fastD4" area="d4" num={4} slug="name_every_wait" title={D4} corner="observability">
      {cs[D4].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <DecisionCard id="fastD5" area="d5" num={5} slug="show_where" title="Show where it came from" corner="traceability">
      {cs['Show where it came from'].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <DecisionCard id="fastD6" area="d6" num={6} slug="revise" title="Change it in your own words" corner="steerability">
      {cs['Change it in your own words'].map((p) => <p class="cs-p">{p}</p>)}
    </DecisionCard>

    <Operator id="fastLbTry" name="txt · try_it" type="txt" area="ltry">
      <h3 class="cs-dh">Try it</h3>
      {cs['Try it'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <!-- VIEW: Lab Builder, self-playing until you take over. --lbd-h is its fixed height per width. -->
    <Operator id="fastLabBuilder" demo="fastLabBuilder" name="lab_view · lab_builder" type="view" area="lbview" maxw={900}>
      <div class="fs-viewerwrap fs-lbhost">
        <ViewSlot poster="COOKING VIEWER · LAB BUILDER…" bg="#151514">
          <FastLabBuilderDemo client:settled={{ rootMargin: '600px' }} />
        </ViewSlot>
      </div>
    </Operator>

    <Operator id="fastHand" name="txt · by_hand" type="txt" area="hand">
      <h3 class="cs-dh">By hand still feels good</h3>
      {cs['By hand still feels good'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <!-- VIEW: the gather board: drag subjects, remove for an undo toast -->
    <Operator id="fastLabView" demo="fastLabView" name="lab_view · gather_board" type="view" area="lview" maxw={900}>
      <div class="fs-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · GATHER BOARD · DRAG TO ORGANIZE…" bg="#111111">
          <FastGatherDemo client:settled={{ rootMargin: '600px' }} />
        </ViewSlot>
      </div>
    </Operator>

    <!-- OUT -->
    <Operator id="fastOutcome" name="out · outcome" type="txt" area="outc" ports="in">
      {cs['Outcome'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <NextCase id="fastOut" from="fast" tagline="THE PAGE IS A PLACE IN THE GRAPH." />
  </PatchField>
</Base>

<style>
  .fs-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .fs-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 16ch;
  }
  .fs-h .amb { color: var(--signal); }
  .fs-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 42ch;
  }

  .fs-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .fs-h2 .amb { color: var(--signal); }

  .fs-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
  .fs-facts dt { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; color: var(--text-dim); margin-bottom: 2px; }
  .fs-facts dd { font-size: 12.5px; color: var(--text); }
  @media (max-width: 560px) { .fs-facts { grid-template-columns: 1fr; } }

  /* viewer islands sit flush to the operator edges (DemoFrame owns inner chrome) */
  .fs-viewerwrap { margin: -12px -14px; }

  /* Lab Builder: one fixed height per width, so no state of the demo moves the page.
     The demo stacks its columns when the card is under 600px wide (a container query inside it),
     which happens below about 640 wide. Stacked needs more room, so 680px starts at 700 to cover it. */
  .fs-lbhost { --lbd-h: 600px; }
  @media (max-width: 700px) { .fs-lbhost { --lbd-h: 680px; } }
</style>
