---
/**
 * carlton.dev — the site as its own case study.
 *
 * INPUT (the claim) → PROCESS (grammar and its parts, how the background cooks, patch runtime, and a
 * side branch: the page-change clock and what it took to make a click answer) →
 * VIEW (you're inside it: there is no demo embed, the page IS the demo) →
 * OUT (next: containers + signal monitor). Wired through the runtime it describes.
 *
 * Copy rules: facts only (stack, budgets, modes are all verifiable in the
 * repo); no embellished roles or numbers. Solo project, so 100% meters are
 * honest.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import LinkButton from '../../components/LinkButton.astro';
import SourceButton from '../../components/SourceButton.astro';
import CodeExcerpt from '../../components/case/CodeExcerpt.astro';
import PatchField from '../../components/PatchField.astro';
import { projects, nextCase } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'carlton-dev');
const next = nextCase('carlton-dev');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects/' },
      { name: 'carlton.dev' },
    ]),
  ],
};

// Lines from src/lib/page-clock.js. The loop is trimmed to the lines that do the work.
const clockExcerpt = `// FRAME_CAP is 34ms. MS is 580ms.
var t = now();
el += Math.min(FRAME_CAP, t - last); last = t;
nav.f = Math.min(1, el / MS);
find().forEach((a) => {
  a.currentTime = nav.f * MS;
});`;

const links: [string, string][] = [
  ['cdTitle', 'cdView'],
  ['cdTitle', 'cdStack'],
  ['cdView', 'cdGrammar'],
  ['cdGrammar', 'cdDither'],
  ['cdDither', 'cdRuntime'],
  ['cdRuntime', 'cdClock'],
  ['cdClock', 'cdSpeed'],
  ['cdSpeed', 'cdOut'],
  ['cdBgNoise', 'cdBgFdbk'],
  ['cdBgFdbk', 'cdBgDith'],
  ['cdBgDith', 'cdBgOut'],
];

// Flex layout: the page is a column of rows. Words: flexLayout in src/lib/patch-field.js.
// 'area:w' is a card w twelfths wide. inset is side padding in columns. gap and mt are grid units (26px).
const layout = {
  mode: 'flex',
  padTop: 48,
  gap: 2,
  rows: [
    { row: ['title:5', 'stack:3'], justify: 'between' },
    { row: ['view:6'], justify: 'center' },
    { row: ['bgn', 'bgf', 'bgd', 'bgo'], justify: 'center', gap: 6 },
    { row: ['gram:5', 'dith:4'], justify: 'center', gap: 6 },
    { row: ['rt:5'], justify: 'center' },
    { row: ['clock:4', 'speed:4'], justify: 'center', gap: 8 },
    { row: ['out:4'], justify: 'center' },
  ],
};
---

<Base
  title="carlton.dev — This Site Is a Patch | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="cdNet" links={links} height="1900px" layout={layout} label="carlton.dev case-study network — press P for reading mode">
    <Operator id="cdTitle" name="input · the_claim" type="txt" area="title" ports="out">
      <p class="cd-meta">{project.meta}</p>
      <h1 class="cd-h">The portfolio is the <span class="grn">product</span></h1>
      <p class="cd-sub">{"// \"I BUILD WHAT I DESIGN\" IS A CLAIM. A CLAIM NEEDS A SHIPPED ARTIFACT. THIS SITE IS IT."}</p>
    </Operator>

    <Operator id="cdStack" name="stack_data" type="data" area="stack">
      <div class="cd-meter">
        <span>CONCEPT</span><div class="bar"><i style="width:100%"></i></div>
        <span>DESIGN</span><div class="bar"><i style="width:100%"></i></div>
        <span>FRONTEND</span><div class="bar"><i style="width:100%"></i></div>
        <span class="cd-meternote">SOLO. {project.facts.stack.toUpperCase()}. STATIC OUTPUT, DEPLOYED TO GITHUB PAGES.</span>
      </div>
    </Operator>

    <Operator id="cdView" name="carlton_dev_view · you_are_here" type="view" area="view" maxw={640}>
      <p class="cs-p"><b>There's no demo embed on this one.</b> You're inside it. Things worth trying:</p>
      <!-- input-aware: keyboard/hover instructions only exist where they're true -->
      <ul class="cd-try cap-fine">
        <li><b>P</b> toggles PATCH / READ · the same content, two renderings</li>
        <li><b>DRAG</b> any node by its header · the cables follow</li>
        <li><b>TAB</b> opens operator search in patch mode · <b>⌘K</b> works anywhere</li>
        <li><b>BG CHAIN</b> right here on this page · noise, dither and palette for the whole site</li>
        <li><b>HOME INDEX</b> select a project · the signal pulses index → post_fx → viewer, and hovering dims the cycle_clock</li>
      </ul>
      <ul class="cd-try cap-coarse">
        <li><b>TAP ▸ OPS</b> in the top bar · operator search without a keyboard, every node on the site</li>
        <li><b>TAP</b> a row in the work index · first tap previews it in the viewer, second tap opens</li>
        <li><b>BG CHAIN</b> right here on this page · tap the chips, drag the sliders, the whole site re-cooks</li>
        <li><b>TOUCH</b> paints the dither field · FDBK sets how long the trail burns</li>
        <li><b>PATCH MODE</b> is the desktop instrument · on a big screen this page becomes a draggable node network</li>
      </ul>
    </Operator>

    <!-- the background generator, patched into the page it is described on:
         the same controls as the homepage chain, and the state is kept site-wide -->
    <Operator id="cdBgNoise" name="bg_01 · noise_src" type="sys" area="bgn" maxw={182} ports="out">
      <button class="chip chipbtn" data-cycle="noise" data-prefix="TYPE">TYPE ▸ RIDGE</button>
      <div class="prow">
        <span class="plab">SPEED</span>
        <input class="prange" type="range" data-param="speed" data-div="100" min="0" max="300" value="100" aria-label="Noise drift speed" />
        <b class="pval" data-out="speed">1.00</b>
      </div>
    </Operator>

    <Operator id="cdBgFdbk" name="bg_02 · feedback" type="sys" area="bgf" maxw={182}>
      <div class="prow">
        <span class="plab">FDBK</span>
        <input class="prange" type="range" data-param="feedback" data-div="100" min="0" max="95" value="78" aria-label="Feedback amount, higher leaves longer cursor trails" />
        <b class="pval" data-out="feedback">0.78</b>
      </div>
      <div class="genhint">CURSOR PAINTS THE FIELD ▚</div>
    </Operator>

    <Operator id="cdBgDith" name="bg_03 · dither" type="sys" area="bgd" maxw={182}>
      <button class="chip chipbtn" data-cycle="dither" data-prefix="TYPE">TYPE ▸ BAYER2</button>
      <div class="prow">
        <span class="plab">DENS</span>
        <input class="prange" type="range" data-param="density" data-div="100" min="5" max="95" value="30" aria-label="Dither density" />
        <b class="pval" data-out="density">0.30</b>
      </div>
      <div class="prow">
        <span class="plab">SCALE</span>
        <input class="prange" type="range" data-param="scale" min="2" max="8" value="3" aria-label="Dither cell scale" />
        <b class="pval" data-out="scale">3</b>
      </div>
    </Operator>

    <Operator id="cdBgOut" name="bg_04 · out" type="sys" area="bgo" maxw={182} ports="in">
      <button class="chip chipbtn" data-cycle="palette" data-prefix="PAL">PAL ▸ GRN</button>
      <div class="genhint">RENDERS THE PAGE ▚</div>
    </Operator>

    <Operator id="cdGrammar" name="process · the_grammar" type="txt" area="gram">
      <h3 class="cd-h3">One grammar, everywhere</h3>
      <p class="cs-p">
        Every block on this site is an operator. The chip in its header
        says what it holds. PATCH lays them out as a network. READ stacks
        the same content as a document.
      </p>
      <div class="cd-parts">
        <div class="cd-part">
          <span class="cd-plab">OPERATOR TYPES</span>
          <div class="cd-line"><span class="cd-typ t-view">VIEW</span><span class="cd-typ t-txt">TXT</span><span class="cd-typ t-data">DATA</span><span class="cd-typ t-sys">SYS</span></div>
        </div>
        <div class="cd-part">
          <span class="cd-plab">CHIPS</span>
          <div class="cd-line"><span class="chip">STATIC</span><button type="button" class="chip chipbtn" id="cdCyc">CYCLE ▸ 1 OF 3</button><button type="button" class="chip chipbtn" id="cdTog" aria-pressed="true">TOGGLE</button></div>
        </div>
        <div class="cd-part cd-wide">
          <span class="cd-plab">CABLE AND PORTS <i>A CABLE IS A REAL CONNECTION</i></span>
          <div class="cd-cable">
            <span class="cd-port"></span>
            <svg viewBox="0 0 380 30" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 0 8 C 150 8, 230 22, 380 22" fill="none" stroke="var(--signal)" stroke-opacity=".28" stroke-width="1.4" vector-effect="non-scaling-stroke" />
              <path class="cd-pulse" d="M 0 8 C 150 8, 230 22, 380 22" pathLength="100" fill="none" stroke="var(--signal)" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="3 200" vector-effect="non-scaling-stroke" />
            </svg>
            <span class="cd-port"></span>
          </div>
        </div>
        <div class="cd-part">
          <span class="cd-plab">SLIDER</span>
          <div class="prow">
            <span class="plab">VALUE</span>
            <input class="prange" id="cdVal" type="range" min="0" max="100" value="77" aria-label="Example slider. It changes the meter beside it." />
            <b class="pval" id="cdValOut">0.77</b>
          </div>
        </div>
        <div class="cd-part">
          <span class="cd-plab">METER</span>
          <div class="cd-meter"><div class="bar"><i id="cdValBar" style="width:77%"></i></div></div>
        </div>
        <div class="cd-part cd-wide">
          <span class="cd-plab">PALETTE <i>ONE CHOICE RECOLOURS THE WHOLE SITE</i></span>
          <div class="cd-sw">
            <button type="button" data-pick="palette" data-v="0" aria-pressed="true" style="--b:#233b2c;--h:#3dff88"><i></i>GRN</button>
            <button type="button" data-pick="palette" data-v="1" aria-pressed="false" style="--b:#3a2c14;--h:#e8a317"><i></i>AMB</button>
            <button type="button" data-pick="palette" data-v="2" aria-pressed="false" style="--b:#15303d;--h:#56b4e9"><i></i>CYN</button>
            <button type="button" data-pick="palette" data-v="3" aria-pressed="false" style="--b:#26262a;--h:#9f9f98"><i></i>MONO</button>
          </div>
        </div>
      </div>
      <SourceButton file="src/styles/tokens.css" label="READ THE TOKENS" block class="cd-src" />
      <!-- The cycle chip, the toggle chip and the slider are specimens. They change nothing but themselves. -->
      <script is:inline data-astro-rerun>
        (function () {
          var cyc = document.getElementById('cdCyc'), tog = document.getElementById('cdTog');
          var val = document.getElementById('cdVal'), out = document.getElementById('cdValOut'), bar = document.getElementById('cdValBar');
          if (!cyc || !tog || !val) return;
          var n = 0;
          cyc.addEventListener('click', function () { n = (n + 1) % 3; cyc.textContent = 'CYCLE ▸ ' + (n + 1) + ' OF 3'; });
          tog.addEventListener('click', function () { tog.setAttribute('aria-pressed', String(tog.getAttribute('aria-pressed') !== 'true')); });
          function show() { val.style.setProperty('--p', val.value + '%'); if (out) out.textContent = (val.value / 100).toFixed(2); if (bar) bar.style.width = val.value + '%'; }
          val.addEventListener('input', show); show();
        })();
      </script>
    </Operator>

    <Operator id="cdDither" name="process · how_it_cooks" type="txt" area="dith">
      <h3 class="cd-h3">Two colours, one comparison</h3>
      <p class="cs-p">
        The background is a grid of cells. On every cook each cell gets a
        level from the noise. The level is mixed with what the cell held
        last time (78% old and 22% new by default), so the pointer leaves
        a trail.
      </p>
      <div class="cd-stages">
        <div><canvas id="cdCvL" width="72" height="48" role="img" aria-label="The level in each cell, shown as grey"></canvas><span class="cd-cap">THE LEVEL IN EACH CELL</span></div>
        <div><canvas id="cdCvO" width="72" height="48" role="img" aria-label="The same cells after the comparison, in two colours"></canvas><span class="cd-cap">AFTER THE COMPARISON</span></div>
      </div>
      <div class="cd-thr">
        <table aria-label="The 2 by 2 threshold grid, BAYER2">
          <tr><td>0.125</td><td>0.625</td></tr>
          <tr><td>0.875</td><td>0.375</td></tr>
        </table>
        <p>BAYER2, the default. Each cell is compared with one of these four numbers. Above it, the cell lights. More than 0.55 above it, the cell lights in the bright colour.</p>
      </div>
      <p class="cs-p">
        The field is drawn into a buffer at one pixel per cell and scaled
        up once. The gaps between cells are cut out with one pattern fill.
        These two views follow the bg chain above.
      </p>
      <ul class="cd-facts">
        <li><b>3px</b><span>per cell by default</span></li>
        <li><b>1 in 2</b><span>frames cook, 1 in 4 while scrolling</span></li>
        <li><b>140,000</b><span>cells at most</span></li>
      </ul>
      <!-- The cook from src/lib/patch-field.js on a 72 by 48 field. It reads the visitor's saved
           background settings, so it follows the bg chain on this page. Draws only while on screen. -->
      <script is:inline data-astro-rerun>
        (function () {
          var cL = document.getElementById('cdCvL'), cO = document.getElementById('cdCvO'), host = document.getElementById('cdNet');
          if (!cL || !cO || !host) return;
          var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var PAL = [[[35, 59, 44], [61, 255, 136]], [[58, 44, 20], [232, 163, 23]], [[21, 48, 61], [86, 180, 233]], [[38, 38, 42], [159, 159, 152]]]; // PALETTES in patch-field.js
          var P = { density: parseFloat(host.dataset.density || '0.77'), speed: 1, feedback: 0.78, pal: 0, noiseT: 1, ditherT: 1 };
          function readP() {
            try {
              var o = JSON.parse(localStorage.getItem('patch-bg') || '{}') || {};
              Object.keys(P).forEach(function (k) { if (typeof o[k] === 'number' && isFinite(o[k])) P[k] = o[k]; });
            } catch (e) {}
          }
          readP();
          var FW = 72, FH = 48, field = new Float32Array(FW * FH);
          var perm = new Uint8Array(512);
          (function () { var p = [], s = 7, i, j, x; for (i = 0; i < 256; i++) p[i] = i; for (i = 255; i > 0; i--) { s = (s * 16807) % 2147483647; j = s % (i + 1); x = p[i]; p[i] = p[j]; p[j] = x; } for (i = 0; i < 512; i++) perm[i] = p[i & 255]; })();
          function h(a, b) { return perm[(perm[a & 255] + b) & 255] / 255; }
          function vn(x, y) { var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi; xf = xf * xf * (3 - 2 * xf); yf = yf * yf * (3 - 2 * yf); var a = h(xi, yi), b = h(xi + 1, yi), c = h(xi, yi + 1), d = h(xi + 1, yi + 1); return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf; }
          var xL = cL.getContext('2d'), xO = cO.getContext('2d');
          if (!xL || !xO) return;
          var iL = xL.createImageData(FW, FH), iO = xO.createImageData(FW, FH);
          var B4 = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]], B2 = [[0, 2], [3, 1]];
          var t = 0, mx = -99, my = -99, heat = 0, seen = true, fc = 0;
          function cook() {
            if (!REDUCED) t += 0.016 * P.speed;
            heat *= 0.9;
            var fb = Math.min(0.95, Math.max(0, P.feedback)), pal = PAL[((P.pal | 0) % 4 + 4) % 4], nt = P.noiseT | 0, dt = P.ditherT | 0;
            for (var gy = 0; gy < FH; gy++) for (var gx = 0; gx < FW; gx++) {
              var n;
              if (nt === 2) { n = 0.5 + (Math.sin(gx * 0.19 + t * 1.2) + Math.sin(gy * 0.24 - t * 0.8) + Math.sin((gx + gy) * 0.12 + t * 0.5)) / 6; n = Math.max(0, (n - 0.35) * 1.6); }
              else {
                var n1 = vn(gx * 0.085 + t * 0.55, gy * 0.085 + t * 0.18), n2 = vn(gx * 0.19 - t * 0.35 + 40.7, gy * 0.19 + 11.3);
                if (nt === 1) { n1 = 1 - Math.abs(2 * n1 - 1); n2 = 1 - Math.abs(2 * n2 - 1); n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.45) * 1.7); }
                else n = Math.max(0, (0.62 * n1 + 0.38 * n2 - 0.32) * 1.55);
              }
              if (heat > 0.02) { var dx = gx - mx, dy = gy - my; n += heat * Math.exp(-(dx * dx + dy * dy) / 40); }
              var i = gy * FW + gx, v = (field[i] = n * (1 - fb) + field[i] * fb), L = v * P.density * 1.2, th, o = i * 4;
              if (dt === 1) th = (B2[gy & 1][gx & 1] + 0.5) / 4;
              else if (dt === 2) th = ((gy & 3) + 0.5) / 4.4;
              else if (dt === 3) { var q = ((gx * 73856093) ^ (gy * 19349663)) >>> 0; th = ((q >>> 8) & 1023) / 1024; }
              else th = (B4[gy & 3][gx & 3] + 0.5) / 16;
              var g = Math.min(255, L * 255);
              iL.data[o] = iL.data[o + 1] = iL.data[o + 2] = g; iL.data[o + 3] = 255;
              var c = L > th ? pal[L - 0.55 > th ? 1 : 0] : null;
              iO.data[o] = c ? c[0] : 0; iO.data[o + 1] = c ? c[1] : 0; iO.data[o + 2] = c ? c[2] : 0; iO.data[o + 3] = 255;
            }
            xL.putImageData(iL, 0, 0); xO.putImageData(iO, 0, 0);
          }
          function still() { for (var i = 0; i < 24; i++) cook(); }
          // the bg chain saves its settings on every change: read them back just after
          function changed() { setTimeout(function () { readP(); if (REDUCED) still(); }, 0); }
          host.addEventListener('input', changed);
          host.addEventListener('click', changed);
          if (REDUCED) { still(); return; }
          [cL, cO].forEach(function (c) {
            c.addEventListener('pointermove', function (e) { var r = c.getBoundingClientRect(); mx = ((e.clientX - r.left) / r.width) * FW; my = ((e.clientY - r.top) / r.height) * FH; heat = 1.4; });
          });
          if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { seen = es[0].isIntersecting; }).observe(cL);
          (function frame() {
            if (!cL.isConnected) return;
            if (seen && (fc++ & 1) === 0) cook();
            requestAnimationFrame(frame);
          })();
        })();
      </script>
    </Operator>

    <Operator id="cdRuntime" name="process · patch_runtime" type="txt" area="rt">
      <h3 class="cd-h3">The cables are real</h3>
      <p class="cs-p">
        The wires aren't decoration. Each link is a subscription on a small
        vanilla-JS message bus. On the homepage the work index emits a
        selection, a post_fx node transforms it in transit (that's the INVERT
        chip), and the viewer renders whatever arrives. Every delivery sends
        a pulse down the cable that carried it. What you see drawn is what
        actually ran.
      </p>
      <p class="cs-p">
        The same runtime owns every timer, listener and observer behind a
        page, and tears them all down between navigations. Even the
        homepage's auto-cycle is a visible node: a cycle_clock operator ticks
        the index, and hovering the index dims it.
      </p>
    </Operator>

    <Operator id="cdClock" name="process · one_clock" type="txt" area="clock">
      <h3 class="cd-h3">Three animations, one clock</h3>
      <p class="cs-p">
        A page change has three parts. The new page wipes in, the old one
        dims, and a front crosses the dither. They used to run on their own
        timers and drift apart on a busy frame.
      </p>
      <p class="cs-p">
        Now the two CSS animations stay paused and one loop moves all three
        by hand. A late frame moves the clock 34ms at most, so a slow browser
        plays the start slowly. It never skips it.
      </p>
      <CodeExcerpt code={clockExcerpt} file="src/lib/page-clock.js" note="the wipe, the dim and the front all read nav.f" />
      <SourceButton file="src/lib/page-clock.js" block class="cd-src" />
    </Operator>

    <Operator id="cdSpeed" name="data · click_to_start" type="data" area="speed">
      <h3 class="cd-h3">The click answers first</h3>
      <p class="cs-p">
        A click used to do nothing for up to a second. The animation was
        waiting for the next page. Lighthouse scored it 97, because
        Lighthouse never clicks a link.
      </p>
      <p class="cs-p">
        Heat now holds at the click. The next page and its stylesheets are
        fetched on hover. Every link ends in a slash, because GitHub Pages
        answers /about with a redirect first.
      </p>
      <ul class="cd-ba">
        <li><span class="what">Home page HTML</span><span><s>55KB</s><b>16KB</b></span></li>
        <li><span class="what">Nav click to start, 300ms latency</span><span><s>380ms</s><b>79ms</b></span></li>
        <li><span class="what">Redirects per new page</span><span><s>1</s><b>0</b></span></li>
      </ul>
      <SourceButton file="src/lib/warm.js" block class="cd-src" />
    </Operator>

    <Operator id="cdOut" name="out · next_cook" type="txt" area="out" ports="in">
      <p class="cs-p">
        Next on the bench: container operators, one lazy-boot path for every
        embedded demo, and a signal monitor that live-prints the message bus.
        You'll be able to watch this site think.
      </p>
      <LinkButton href={`/projects/${next.slug}/`} label={`NEXT · ${next.slug.replace(/-/g, '_').toUpperCase()}`} sub={next.teaser} block class="cd-next">
        <svg slot="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h10.2M8.6 3.6 13 8l-4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
      </LinkButton>
    </Operator>
  </PatchField>
</Base>

<style>
  .cd-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .cd-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .cd-h .grn { color: var(--signal); }
  .cd-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 44ch;
  }
  .cd-h3 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 16px;
    margin-bottom: 10px;
  }

