---
/**
 * carlton.dev — the site as its own case study.
 *
 * INPUT (the claim) → PROCESS (grammar, layout resolver, patch runtime) →
 * VIEW (you're inside it: there is no demo embed, the page IS the demo) →
 * OUT (next: containers + signal monitor). Placed by the layout resolver
 * it describes; wired through the runtime it describes.
 *
 * Copy rules: facts only (stack, budgets, modes are all verifiable in the
 * repo); no embellished roles or numbers. Solo project, so 100% meters are
 * honest.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'carlton-dev');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects' },
      { name: 'carlton.dev' },
    ]),
  ],
};

const links: [string, string][] = [
  ['cdTitle', 'cdGrammar'],
  ['cdTitle', 'cdStack'],
  ['cdGrammar', 'cdLayout'],
  ['cdLayout', 'cdRuntime'],
  ['cdRuntime', 'cdView'],
  ['cdView', 'cdOut'],
];

const layout = {
  mode: 'content',
  padTop: 48,
  tiers: [{
    min: 0,
    cols: 12,
    areas: `
      title title title title title .     .     .     .     stack stack stack
      .     gram  gram  gram  gram  .     .     lay   lay   lay   lay   .
      .     .     .     rt    rt    rt    rt    rt    .     .     .     .
      .     .     view  view  view  view  view  view  .     .     .     .
      .     .     .     .     out   out   out   out   .     .     .     .
    `,
  }],
};
---

<Base
  title="carlton.dev — This Site Is a Patch | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="cdNet" links={links} density={0.3} height="1750px" layout={layout} label="carlton.dev case-study network — press P for reading mode">
    <Operator id="cdTitle" name="input · the_claim" type="txt" area="title" ports="out">
      <p class="cd-meta">{project.meta}</p>
      <h1 class="cd-h">The portfolio is the <span class="grn">product</span></h1>
      <p class="cd-sub">// "I BUILD WHAT I DESIGN" IS A CLAIM. A CLAIM NEEDS A SHIPPED ARTIFACT. THIS SITE IS IT.</p>
    </Operator>

    <Operator id="cdStack" name="stack_data" type="data" area="stack">
      <div class="cd-meter">
        <span>CONCEPT</span><div class="bar"><i style="width:100%"></i></div>
        <span>DESIGN</span><div class="bar"><i style="width:100%"></i></div>
        <span>FRONTEND</span><div class="bar"><i style="width:100%"></i></div>
        <span class="cd-meternote">SOLO. {project.facts.stack.toUpperCase()}. STATIC OUTPUT, DEPLOYED TO GITHUB PAGES.</span>
      </div>
    </Operator>

    <Operator id="cdGrammar" name="process · the_grammar" type="txt" area="gram">
      <h3 class="cd-h3">One grammar, everywhere</h3>
      <p class="cd-p">
        Every content block on the site is an operator with a typed header:
        VIEW for live things, TXT for prose, DATA for facts, SYS for
        instruments. Cables connect them, and the dither field behind
        everything is generated by a visible chain of four SYS nodes you can
        actually tweak. Settings persist between visits.
      </p>
      <p class="cd-p">
        There are two modes. PATCH is the spatial view you're probably in
        now. READ strips the boxes away and stacks everything as a clean
        document. Small screens and reduced-motion visitors get READ by
        default; nobody is forced to fight the metaphor.
      </p>
    </Operator>

    <Operator id="cdLayout" name="process · layout_resolver" type="txt" area="lay" nudge="0 40">
      <h3 class="cd-h3">Layouts are ASCII pictures</h3>
      <p class="cd-p">
        Node placement isn't hand-tuned pixel positions. Each page declares
        its network as an ASCII grid-areas sketch; a small resolver turns
        that into positions at runtime, snaps everything to the background
        dot grid, and pushes overlapping nodes apart when copy grows.
      </p>
      <p class="cd-p">
        This page is placed by the system it's describing. Resize the window
        and watch it re-cook.
      </p>
    </Operator>

    <Operator id="cdRuntime" name="process · patch_runtime" type="txt" area="rt" nudge="0 24">
      <h3 class="cd-h3">The cables are real</h3>
      <p class="cd-p">
        The wires aren't decoration anymore. Each link is a subscription on a
        small vanilla-JS message bus: on the homepage, the work index emits a
        selection, a post_fx node transforms it in transit (that's the INVERT
        chip), and the viewer renders whatever arrives. Every delivery sends
        a pulse down the cable that carried it — what you see drawn is what
        actually ran.
      </p>
      <p class="cd-p">
        The same runtime owns every timer, listener and observer behind a
        page and tears them all down between navigations. Even the homepage's
        auto-cycle is a visible node now: a cycle_clock operator ticks the
        index, and hovering the index dims it.
      </p>
    </Operator>

    <Operator id="cdView" name="carlton_dev_view · you_are_here" type="view" area="view" maxw={640}>
      <p class="cd-p"><b>There's no demo embed on this one.</b> You're inside it. Things worth trying:</p>
      <ul class="cd-try">
        <li><b>P</b> toggles PATCH / READ · the same content, two renderings</li>
        <li><b>DRAG</b> any node by its header · the cables follow</li>
        <li><b>TAB</b> opens operator search in patch mode · <b>⌘K</b> works anywhere</li>
        <li><b>BG CHAIN</b> on the homepage sets noise, dither and palette for the whole site</li>
        <li><b>HOME INDEX</b> select a project · the signal pulses index → post_fx → viewer, and hovering dims the cycle_clock</li>
      </ul>
    </Operator>

    <Operator id="cdOut" name="out · next_cook" type="txt" area="out" ports="in">
      <p class="cd-p">
        Next on the bench: container operators — one lazy-boot path for every
        embedded demo — and a signal monitor that live-prints the message bus,
        so you can watch this site think.
      </p>
      <p class="cd-out">
        <a href="/projects/futurescaper">NEXT ▸ futurescaper</a><br />
        <span class="cd-outsub">the flagship case study</span>
      </p>
    </Operator>
  </PatchField>
</Base>

<style>
  .cd-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .cd-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .cd-h .grn { color: var(--signal); }
  .cd-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 44ch;
  }
  .cd-h3 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 16px;
    margin-bottom: 10px;
  }
  .cd-p { font-size: 13px; color: var(--text); line-height: 1.68; margin-bottom: 8px; }
  .cd-p:last-child { margin-bottom: 0; }
  .cd-p b { color: var(--text); font-weight: 600; }

  .cd-meter { font-family: var(--font-mono); font-size: 9.5px; color: var(--text-muted); }
  .cd-meter .bar {
    height: 6px;
    background: var(--bg-surface);
    border: 1px solid #26262a;
    margin: 4px 0 8px;
    position: relative;
  }
  .cd-meter .bar i {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--signal) 0 4px, transparent 4px 6px);
  }
  .cd-meternote { color: var(--text-dim); display: block; margin-top: 4px; line-height: 1.6; }

  .cd-try {
    list-style: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--text-muted);
    margin-top: 10px;
  }
  .cd-try li { padding-left: 14px; position: relative; margin-bottom: 7px; }
  .cd-try li:last-child { margin-bottom: 0; }
  .cd-try li::before { content: '▸'; position: absolute; left: 0; color: var(--signal); }
  .cd-try b { color: var(--text); font-weight: 600; }

  .cd-out { font-family: var(--font-mono); font-size: 11px; line-height: 1.7; margin-top: 12px; }
  .cd-out a { color: var(--signal); text-decoration: none; }
  .cd-out a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .cd-outsub { color: var(--text-dim); }
</style>
