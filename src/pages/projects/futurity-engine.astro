---
/**
 * Futurity Engine: case-study network built on the trust triangle
 * (docs/prototypes/engine-case-study-restructure.html rev 3, shape A; the
 * triangle as two cards per docs/prototypes/trust-triangle-layout.html C).
 *
 * INPUT (title + ownership) → VIEW (hero, placeholder: the workflow building
 * over time) → what it is → triangle + three corners →
 * 01 OBSERVABILITY (how it works, decisions 01-03) →
 * 02 TRACEABILITY (the first workflow view, placeholder; the redesign,
 * decisions 04-06, the workflow demo) →
 * 03 STEERABILITY (what you can change, decisions 07-08) → OUT.
 *
 * Every demo is a RECREATION on made-up data: the Engine is recreation-only,
 * so no product source ships here. Prose comes from src/data/content.js;
 * fact-checked, don't embellish.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import DecisionCard from '../../components/case/DecisionCard.astro';
import NextCase from '../../components/case/NextCase.astro';
import OwnershipMeter from '../../components/case/OwnershipMeter.astro';
import SectionBreak from '../../components/case/SectionBreak.astro';
import PatchField from '../../components/PatchField.astro';
import ViewSlot from '../../components/ViewSlot.astro';
import EngineWorkflowView from '../../components/react/demos/engine/EngineWorkflowView.jsx';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'futurity-engine');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects/' },
      { name: 'Futurity Engine' },
    ]),
  ],
};

// The three corners, shared by the notes card. Copy verbatim from the accepted prototype.
const corners = [
  ['OBSERVABILITY', 'You can see what it is doing right now: which step is running, what it is reading, and how long it has been quiet.', '→ SECTION 01: LIVE RUN, LIVENESS'],
  ['TRACEABILITY', 'You can ask where any part came from and what was done with it. Dumping every detail on screen buries the answer, so it comes one layer at a time, as deep as you ask.', '→ SECTION 02: THE WORKFLOW REDESIGN'],
  ['STEERABILITY', 'You can change exactly the part you meant. Ask an image model to make the dog blue and it used to redraw the whole picture, sometimes with a blue giraffe in it. Steering means the dog turns blue and nothing else moves.', '→ SECTION 03: WHAT YOU CAN CHANGE'],
];

const links: [string, string][] = [
  ['engTitle', 'engOwn'],
  ['engTitle', 'engHero'],
  ['engHero', 'engWhat'],
  ['engWhat', 'engTri'],
  ['engTri', 'engCorners'],
  ['engCorners', 'engBreak1'],
  ['engBreak1', 'engHow'],
  ['engHow', 'engD1'],
  ['engD1', 'engD2'],
  ['engD2', 'engD3'],
  ['engD3', 'engBreak2'],
  ['engBreak2', 'engTrSect'],
  ['engTrSect', 'engBeforeTxt'],
  ['engBeforeTxt', 'engBefore'],
  ['engBefore', 'engRedesign'],
  ['engRedesign', 'engD4'],
  ['engD4', 'engD5'],
  ['engD5', 'engD6'],
  ['engD6', 'engTry'],
  ['engTry', 'engWorkflow'],
  ['engWorkflow', 'engBreak3'],
  ['engBreak3', 'engStSect'],
  ['engStSect', 'engStTxt'],
  ['engStTxt', 'engD7'],
  ['engD7', 'engD8'],
  ['engD8', 'engTrySteer'],
  ['engTrySteer', 'engOutcome'],
  ['engOutcome', 'engOut'],
];

// Flex layout: the page is a column of rows. Words: flexLayout in src/lib/patch-field.js.
// 'area:w' is a card w twelfths wide. inset is side padding in columns. gap and mt are grid units (26px).
const layout = {
  mode: 'flex',
  padTop: 48,
  gap: 2,
  rows: [
    { row: ['title:5', 'own:3'], justify: 'between' },
    { row: ['hero:10'], justify: 'center' },
    { row: ['what:5'], justify: 'center' },
    { row: ['tri:4', 'corners:5'], justify: 'center', gap: 4, align: 'center' },
    { row: ['br1:8'], justify: 'center', mt: 1 },
    { row: ['how:6'], justify: 'center', mt: 1 },
    { row: ['d1:3', { op: 'd2', w: 3, mt: 1.5 }, { op: 'd3', w: 3, mt: 3 }], justify: 'between', inset: 1 },
    { row: ['br2:8'], justify: 'center', mt: 1 },
    { row: ['trsect:4', 'beforetxt:4'], justify: 'center', gap: 8, mt: 1 },
    { row: ['before:6'], justify: 'center' },
    { row: ['redesign:5'], justify: 'center' },
    { row: ['d4:3', { op: 'd5', w: 3, mt: 1.5 }, { op: 'd6', w: 3, mt: 3 }], justify: 'between', inset: 1 },
    { row: ['try:4'], justify: 'center' },
    { row: ['wf:10'], justify: 'center' },
    { row: ['br3:8'], justify: 'center', mt: 1 },
    { row: ['stsect:4', 'sttxt:5'], justify: 'center', gap: 8, mt: 1 },
    { row: ['d7:3', 'd8:3'], justify: 'center', gap: 8 },
    { row: ['trysteer:5'], justify: 'center' },
    { row: ['outc:5', 'out:4'], justify: 'between' },
  ],
};
---

<Base
  title="Futurity Engine — Watch the Machine Think | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="engNet" links={links} height="6000px" layout={layout} label="Futurity Engine case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="engTitle" name="input · the_problem" type="txt" area="title" ports="out">
      <p class="eng-meta">{project.meta}</p>
      <h1 class="eng-h">Watch the machine <span class="sig">think</span></h1>
      <p class="eng-sub">{"// A MULTI-AGENT PIPELINE RUNS FOR MINUTES TO HOURS. THIS INTERFACE SHOWS WHAT IT IS DOING, WHERE EACH ANSWER CAME FROM, AND WHAT YOU CAN CHANGE."}</p>
    </Operator>
    <!-- OWNERSHIP -->
    <OwnershipMeter
      id="engOwn"
      rows={[['UI CONCEPT', 100], ['VISUAL SYSTEM', 85], ['WORKFLOW REDESIGN', 100], ['PIPELINE / BACKEND', 15]]}
      note="TEAM BUILD. CONCEPT PROTOTYPE, VISUAL SYSTEM, STREAMING AND LIVENESS DESIGNS, AND THE WORKFLOW REDESIGN ARE MINE. THE PIPELINE IS NOT."
    />
    <!-- VIEW: hero. Placeholder until the workflow-building-over-time animation (second pass). -->
    <Operator id="engHero" name="futurity_engine_view · the_workflow" type="view" area="hero" maxw={900}>
      <div class="eng-slot" style="height:280px">
        <b>WORKFLOW, BUILDING OVER TIME</b>
        <span>PLACEHOLDER</span>
      </div>
    </Operator>
    <Operator id="engWhat" name="txt · what_it_is" type="txt" area="what">
      {cs['What it is'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <!-- The trust triangle: one card for the shape, one for the three corners (layout C). -->
    <Operator id="engTri" name="txt · trust_triangle" type="txt" area="tri">
      <svg class="eng-tri" viewBox="0 0 170 150" role="img" aria-label="Observe, trace, steer">
        <path class="e" d="M85 22 L18 128 L152 128 Z" />
        <path class="sec" d="M85,92.7 L51.5,75 M85,92.7 L118.5,75 M85,92.7 L85,128" />
        <g class="ico" transform="translate(85 64) scale(1.05)"><path d="M-11,0 Q0,-9 11,0 Q0,9 -11,0 Z" /><circle cx="0" cy="0" r="3.4" /><circle class="solid" cx="0" cy="0" r="1.3" /></g>
        <g class="ico" transform="translate(60 106) scale(1.05)"><circle cx="-2" cy="-2" r="6.5" /><path d="M2.8,2.8 L8.5,8.5" /><path d="M-5,-2 L1,-2 M-5,1 L-1,1" /></g>
        <g class="ico" transform="translate(110 106) scale(1.05)"><rect x="-9" y="4" width="18" height="5" rx="1.6" /><path d="M0,4 L0,-4" /><circle cx="0" cy="-7" r="3.4" /><path d="M-5,4 L-5,2.5" /></g>
        <circle class="c" cx="85" cy="22" r="5" /><circle class="c" cx="18" cy="128" r="5" /><circle class="c" cx="152" cy="128" r="5" />
        <text x="85" y="10" text-anchor="middle">OBSERVE</text><text x="18" y="146" text-anchor="middle">TRACE</text><text x="152" y="146" text-anchor="middle">STEER</text>
      </svg>
    </Operator>
    <Operator id="engCorners" name="txt · three_corners" type="txt" area="corners">
      <dl class="eng-corners">
        {corners.map(([dt, dd, pt]) => (
          <div><dt>{dt}</dt><dd>{dd}<span class="pt">{pt}</span></dd></div>
        ))}
      </dl>
    </Operator>

    <!-- 01 OBSERVABILITY -->
    <SectionBreak id="engBreak1" area="br1" num={1} label="OBSERVABILITY" />
    <Operator id="engHow" name="process · how_it_works" type="txt" area="how" maxw={600}>
      {cs['How it works'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <DecisionCard id="engD1" area="d1" num={1} slug="every_step_says" title="Every step says where it is" corner="observability">
      <p class="cs-p">Not started, running, paused, done, failed or skipped, on every step and rolled up on every workstream: "12 of 30 done · 2 running". A step that searches says what it is still waiting for.</p>
    </DecisionCard>
    <DecisionCard id="engD2" area="d2" num={2} slug="report_fills" title="Watch the report fill" corner="observability">
      <p class="cs-p">The report shows in reading order from the start. Each section says whether it is waiting its turn, being written or done, and the knowledgebase has its own tab where you can watch it grow.</p>
    </DecisionCard>
    <DecisionCard id="engD3" area="d3" num={3} slug="honest_liveness" title="Honest liveness" corner="observability">
      <p class="cs-p">Some steps run ten minutes without an event. The status says which of three states it is in: events flowing, quiet but alive, or stalled. I wrote the heartbeat contract before the backend emitted it.</p>
    </DecisionCard>
    <!-- 02 TRACEABILITY -->
    <SectionBreak id="engBreak2" area="br2" num={2} label="TRACEABILITY" />
    <Operator id="engTrSect" name="process · traceability" type="txt" area="trsect">
      <p class="eng-meta">PROCESS · THE WORKFLOW, REDESIGNED</p>
      <h2 class="eng-h2">Ask where anything <span class="sig">came from</span></h2>
      <p class="eng-sub">The same run, folded into layers you open one at a time.</p>
    </Operator>
    <Operator id="engBeforeTxt" name="txt · first_view" type="txt" area="beforetxt">
      <h3 class="cs-dh">The first workflow view</h3>
      {cs['The first workflow view'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <!-- VIEW: the "before". Placeholder until it is recreated with made-up names. -->
    <Operator id="engBefore" name="before · first_workflow_view" type="view" area="before" maxw={540}>
      <div class="eng-slot" style="height:230px">
        <b>BEFORE · THE FIRST WORKFLOW VIEW</b>
        <span>PLACEHOLDER, RECREATED LATER WITH MADE-UP NAMES</span>
      </div>
    </Operator>
    <Operator id="engRedesign" name="txt · the_redesign" type="txt" area="redesign">
      {cs['The redesign'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <DecisionCard id="engD4" area="d4" num={4} slug="layers" title="One layer at a time" corner="traceability">
      <p class="cs-p">Workstreams, then blocks, then steps. Each layer says where its inputs come from and what it hands on, so you can stop as soon as you have your answer.</p>
    </DecisionCard>
    <DecisionCard id="engD5" area="d5" num={5} slug="prompt_parts" title="Every prompt, part by part" corner="traceability">
      <p class="cs-p">Select an AI step to read the prompt it sent, split by where each part came from: your settings, the wiring, or the engine's rules. Every answer the engine rejected is there too, with the check it failed.</p>
    </DecisionCard>
    <DecisionCard id="engD6" area="d6" num={6} slug="fact_tokens" title="Numbers come from data" corner="traceability">
      <p class="cs-p">A writer can't type a number. It cites a fact token, and the assembly step puts in the recorded value. A sentence that can't be traced is removed before the report is published.</p>
    </DecisionCard>
    <Operator id="engTry" name="txt · try_it" type="txt" area="try">
      <h3 class="cs-dh">Try it</h3>
      <p class="cs-p">A recreation of the workflow view on a 70-step made-up run. Everything is clickable: open a workstream, select a step, read its prompt, or scrub the run and watch it fill.</p>
    </Operator>
    <!-- VIEW: the workflow demo, the ported Engine Blocks prototype in its own document (ProductFrame). -->
    <Operator id="engWorkflow" demo="engWorkflow" name="futurity_engine_view · workflow" type="view" area="wf" maxw={900}>
      <div class="eng-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · THE WORKFLOW VIEW · EVERYTHING IS CLICKABLE…" wait="event">
          <EngineWorkflowView client:settled={{ rootMargin: '600px' }} />
        </ViewSlot>
      </div>
    </Operator>

    <!-- 03 STEERABILITY -->
    <SectionBreak id="engBreak3" area="br3" num={3} label="STEERABILITY" />
    <Operator id="engStSect" name="process · steerability" type="txt" area="stsect">
      <p class="eng-meta">PROCESS · WHAT YOU CAN CHANGE</p>
      <h2 class="eng-h2">Change exactly the <span class="sig">part you meant</span></h2>
      <p class="eng-sub">Before, during and after a run.</p>
    </Operator>
    <Operator id="engStTxt" name="txt · steer" type="txt" area="sttxt">
      {cs['What you can change'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <DecisionCard id="engD7" area="d7" num={7} slug="pause_dependents" title="Pause only what needs it" corner="steerability">
      <p class="cs-p">When a research job fails, only the steps that search for it wait. Everything else keeps going, and the run asks: retry it, or go on without it. Go on, and every section written without it is flagged in the report.</p>
    </DecisionCard>
    <DecisionCard id="engD8" area="d8" num={8} slug="rerun_one" title="Rerun one block" corner="steerability">
      <p class="cs-p">Change a block's settings, or add an instruction, and rerun just that block. What depends on it reruns with it. Everything else keeps the result it already had.</p>
    </DecisionCard>
    <Operator id="engTrySteer" name="txt · try_steer" type="txt" area="trysteer">
      <p class="cs-p">Press play. Three minutes in, a research job fails and the demo waits for you: retry it, or go on without it. When the run finishes, open Science, then Emerging papers, to rerun one block.</p>
    </Operator>

    <!-- OUT -->
    <Operator id="engOutcome" name="out · outcome" type="txt" area="outc" ports="in">
      {cs['Outcome'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>
    <NextCase id="engOut" from="futurity-engine" tagline="TRUST IS EARNED IN THE TRANSCRIPT." />
  </PatchField>
</Base>

<style>
  /* ---- shared case-study grammar (matches futurescaper.astro) ---- */
  .eng-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .eng-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .eng-h .sig, .eng-h2 .sig { color: var(--signal); }
  .eng-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 42ch;
  }
  .eng-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 0.98;
    margin-bottom: 8px;
  }

  /* placeholders: a later piece, dashed grey at its final size so nothing moves when it lands */
  .eng-slot {
    display: grid; place-content: center; text-align: center; gap: 6px;
    border: 1px dashed var(--border-color); border-radius: 3px;
    font-family: var(--font-mono); font-size: 10px; line-height: 1.6; letter-spacing: 0.1em;
    color: var(--text-dim);
  }
  .eng-slot b { color: var(--text-muted); font-weight: 400; }

  /* the trust triangle (layout C): the shape in one card, the three corners in the next */
  .eng-tri { display: block; width: 100%; height: auto; max-width: 300px; margin: 0 auto; }
  .eng-tri .e { fill: none; stroke: #3a3a3a; stroke-width: 1.2; }
  .eng-tri .sec { fill: none; stroke: #2c2c2c; stroke-width: 1; }
  .eng-tri .c { fill: var(--signal); }
  .eng-tri text { fill: var(--text-muted); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; }
  .eng-tri .ico * { fill: none; stroke: var(--signal); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .eng-tri .ico .solid { fill: var(--signal); stroke: none; }
  .eng-corners { display: grid; gap: 12px; }
  .eng-corners dt { font-family: var(--font-mono); font-size: 10px; line-height: 1; letter-spacing: 0.14em; color: var(--signal); margin-bottom: 4px; }
  .eng-corners dd { font-size: 13px; line-height: 1.55; color: var(--text); }
  .eng-corners .pt { display: block; font-family: var(--font-mono); font-size: 9.5px; line-height: 1.5; letter-spacing: 0.06em; color: var(--text-dim); margin-top: 3px; }

  /* ---- viewer interiors: the Engine's own visual language, scoped ---- */
  .eng-viewerwrap { margin: -12px -14px; background: #111111; }
</style>
