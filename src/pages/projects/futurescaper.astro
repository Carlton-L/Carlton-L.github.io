---
/**
 * Futurescaper — flagship case-study network.
 *
 * INPUT (problem) → PROCESS (decision nodes) → VIEW (radial consequence
 * map in the REAL product language) → OUT (outcome + next).
 *
 * Viewer fidelity is verified against the futurescaper repo's
 * CLAUDE-DESIGN-SYSTEM.md: paper #F4F1EA, amber #E8A317 seed (dark ink
 * text on amber), Wong STEEPLE palette (Ethical base #F0E442), radial
 * order bands named Direct/Ripple/Cascade/Systemic/Emergent.
 * Prose comes from src/data/content.js — fact-checked, don't embellish.
 * Ownership numbers (35/100/100/100) are honest and verified.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'futurescaper');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects' },
      { name: 'Futurescaper' },
    ]),
  ],
};

const links: [string, string][] = [
  ['fsTitle', 'fsWhat'],
  ['fsTitle', 'fsCraft'],
  ['fsWhat', 'fsOwn'],
  ['fsOwn', 'fsRole'],
  ['fsCraft', 'fsD1'],
  ['fsD1', 'fsD2'],
  ['fsD2', 'fsD3'],
  ['fsD2', 'fsView'],
  ['fsRole', 'fsView'],
  ['fsView', 'fsOut'],
];
---

<Base
  title="Futurescaper — A Map Room for Possible Futures | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="fsNet" links={links} density={0.3} height="1680px" label="Futurescaper case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="fsTitle" name="input · the_problem" type="txt" pos="left:4%; top:44px; width:min(400px,88vw);" ports="out">
      <p class="fs-meta">{project.meta}</p>
      <h1 class="fs-h">A map room for <span class="amb">possible futures</span></h1>
      <p class="fs-sub">// FORESIGHT DATA DEFEATS GENERIC GRAPH TOOLS. FORCE LAYOUTS COLLAPSE INTO HAIRBALLS EXACTLY WHEN THE PICTURE MATTERS. THIS ONE DOESN'T.</p>
    </Operator>

    <Operator id="fsWhat" name="txt · what_it_is" type="txt" pos="left:38%; top:60px; width:min(300px,86vw);">
      {cs['What it is'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <!-- OWNERSHIP (honest numbers, verified) -->
    <Operator id="fsOwn" name="ownership_data" type="data" pos="right:4%; top:44px; width:min(260px,86vw);">
      <div class="fs-meter">
        <span>CONCEPT</span><div class="bar"><i style="width:35%"></i></div>
        <span>DESIGN</span><div class="bar"><i style="width:100%"></i></div>
        <span>FRONTEND</span><div class="bar"><i style="width:100%"></i></div>
        <span>BACKEND</span><div class="bar"><i style="width:100%"></i></div>
        <span class="fs-meternote">SOLO REBUILD FROM A COLLEAGUE'S POC — UI, LAYOUT SYSTEM, AND A REAL BACKEND, FROM ZERO.</span>
      </div>
    </Operator>

    <Operator id="fsRole" name="txt · my_role" type="txt" pos="right:4%; top:390px; width:min(340px,86vw);">
      {cs['My role'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <!-- PROCESS: decisions -->
    <Operator id="fsCraft" name="process · craft_notes" type="txt" pos="left:4%; top:390px; width:min(340px,86vw);">
      {cs['Craft notes'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <Operator id="fsD1" name="decision_01 · spatial_memory" type="txt" pos="left:4%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">When new AI-generated scenarios arrive, existing nodes barely move. Users keep their mental map; stability beats elegance.</p>
    </Operator>

    <Operator id="fsD2" name="decision_02 · provenance" type="txt" pos="left:36%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">Machine-generated content renders visually distinct until a human promotes it. Trust needs a visible seam.</p>
    </Operator>

    <Operator id="fsD3" name="decision_03 · off_thread" type="txt" pos="right:4%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">Layouts recompute off the main thread. Interaction latency stays imperceptible even as the scenario space grows.</p>
    </Operator>

    <!-- VIEW: the real product language -->
    <Operator id="fsView" name="futurescaper_view — seed → 5 orders of consequence" type="view" pos="left:50%; top:1000px; transform:translateX(-50%); width:min(760px,92vw);">
      <div class="fs-viewerwrap">
        <div class="viewerpaper">
          <svg id="fsRadial" viewBox="0 0 780 430" role="img" aria-label="Radial consequence map — synthetic demo of Futurescaper's seed-to-consequences view"></svg>
          <div class="fs-chips" id="fsChips" role="group" aria-label="STEEPLE category filters"></div>
          <form class="fs-seedbox" id="fsSeedForm">
            <input id="fsSeedInput" value="Ocean plastics ban, 2040" spellcheck="false" aria-label="Seed scenario" />
            <button type="submit">GENERATE ▸</button>
          </form>
        </div>
        <div class="fs-vfoot">
          <span>REAL PRODUCT LANGUAGE — PAPER / AMBER / WONG PALETTE</span>
          <span><b>LIVE</b> SYNTHETIC DATA</span>
        </div>
      </div>
    </Operator>

    <!-- OUT -->
    <Operator id="fsOut" name="out · next_network" type="data" pos="right:5%; bottom:36px; width:min(250px,86vw);" ports="in">
      <p class="fs-out">
        THE LAYOUT IS THE ARGUMENT.<br /><br />
        <a href="/projects/futurity-engine">NEXT ▸ futurity_engine</a><br />
        <span class="fs-outsub">watch the machine think</span>
      </p>
    </Operator>
  </PatchField>
</Base>

<style>
  .fs-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .fs-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .fs-h .amb { color: var(--amber); }
  .fs-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 42ch;
  }

  .fs-p { font-size: 12.5px; color: var(--text-muted); line-height: 1.65; margin-bottom: 8px; }
  .fs-p:last-child { margin-bottom: 0; }

  .fs-meter { font-family: var(--font-mono); font-size: 9.5px; color: var(--text-muted); }
  .fs-meter .bar {
    height: 6px;
    background: var(--bg-surface);
    border: 1px solid #26262a;
    margin: 4px 0 8px;
    position: relative;
  }
  .fs-meter .bar i {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--signal) 0 4px, transparent 4px 6px);
  }
  .fs-meternote { color: var(--text-dim); display: block; margin-top: 4px; line-height: 1.6; }

  .fs-viewerwrap { margin: -12px -14px; }
  .viewerpaper { background: var(--paper); position: relative; }
  .viewerpaper svg { display: block; width: 100%; height: auto; }
  .fs-chips {
    position: absolute;
    top: 10px;
    left: 12px;
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    max-width: 72%;
  }
  .fs-chips :global(button) {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 99px;
    border: 1px solid var(--paper-line);
    color: var(--ink-muted);
    background: rgba(251, 250, 247, 0.8);
    cursor: pointer;
  }
  .fs-chips :global(button[aria-pressed='false']) { opacity: 0.35; }
  .fs-seedbox {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 8px;
  }
  .fs-seedbox input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--paper-card);
    border: 1px solid var(--paper-line);
    border-radius: 6px;
    padding: 8px 12px;
    color: var(--ink);
  }
  .fs-seedbox button {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    background: var(--amber);
    color: var(--amber-ink);
    border: 0;
    border-radius: 6px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .fs-seedbox button:active { transform: scale(0.98); }
  .fs-vfoot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 10px;
    border-top: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-dim);
  }
  .fs-vfoot b { color: var(--signal); font-weight: 400; }

  .fs-out { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); line-height: 1.7; }
  .fs-out a { color: var(--signal); text-decoration: none; }
  .fs-out a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .fs-outsub { color: var(--text-dim); }

  /* PERFORM: viewer keeps working as a full-width block */
  :global(body.perform) .fs-chips { max-width: 60%; }
</style>

<script is:inline data-astro-rerun>
(function () {
  const svg = document.getElementById('fsRadial');
  if (!svg || svg.dataset.init) return;
  svg.dataset.init = '1';

  /* Wong STEEPLE palette — exact data encodings from the product
     (CLAUDE-DESIGN-SYSTEM.md §3.1). Ethical gets its manual light-mode
     text override (#8a7d00) because yellow reads too dim on paper. */
  const STEEP = [
    { k: 'SOCIAL', c: '#CC79A7' },
    { k: 'TECH', c: '#56B4E9' },
    { k: 'ECON', c: '#E69F00' },
    { k: 'ENV', c: '#009E73' },
    { k: 'POLITICAL', c: '#D55E00' },
    { k: 'LEGAL', c: '#007CBF' },
    { k: 'ETHICAL', c: '#F0E442', t: '#8a7d00' },
  ];
  const AMBER = '#E8A317', INK = '#15140F', LINE = '#D2CABA', MUTED = '#8A8576';
  const ORDERS = ['DIRECT', 'RIPPLE', 'CASCADE', 'SYSTEMIC', 'EMERGENT'];
  const W = 780, H = 430, cx = W / 2, cy = H / 2 + 10, R = H * 0.44;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* deterministic nodes from a string seed */
  function hash(str) {
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); }
    return (h >>> 0) || 1;
  }
  function makeNodes(seedStr) {
    let s = hash(seedStr);
    const r = () => (s = (s * 16807) % 2147483647) / 2147483647;
    return Array.from({ length: 220 }, () => ({
      order: 1 + Math.floor(r() * 5),
      a: r() * Math.PI * 2,
      cat: Math.floor(r() * 7),
      sz: 2 + r() * 2.5,
      j: r() * 0.5 + 0.75,
    }));
  }

  let nodes = makeNodes(document.getElementById('fsSeedInput').value);
  let t = reduced ? 1 : 0;
  const active = new Set([0, 1, 2, 3, 4, 5, 6]);

  /* STEEPLE filter chips */
  const chipHost = document.getElementById('fsChips');
  STEEP.forEach((sc, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = sc.k;
    b.setAttribute('aria-pressed', 'true');
    b.style.borderColor = sc.c;
    b.style.color = sc.t || INK;
    b.addEventListener('click', () => {
      active.has(i) ? active.delete(i) : active.add(i);
      b.setAttribute('aria-pressed', String(active.has(i)));
      if (reduced) draw();
    });
    chipHost.appendChild(b);
  });

  /* GENERATE */
  document.getElementById('fsSeedForm').addEventListener('submit', (e) => {
    e.preventDefault();
    nodes = makeNodes(document.getElementById('fsSeedInput').value + '·' + Date.now());
    t = 0;
    if (reduced) { t = 1; draw(); }
  });

  function draw() {
    let o = '';
    for (let k = 1; k <= 5; k++) {
      const rr = (R * k) / 5;
      o += `<ellipse cx="${cx}" cy="${cy}" rx="${rr * 1.55}" ry="${rr * 0.86}" fill="none" stroke="${LINE}" stroke-width="1" stroke-dasharray="3 5" opacity="${0.9 - k * 0.1}"/>`;
      o += `<text x="${cx + rr * 1.55 - 4}" y="${cy - 6}" font-family="JetBrains Mono, monospace" font-size="8" fill="${MUTED}" text-anchor="end">${k}° ${ORDERS[k - 1]}</text>`;
    }
    for (const p of nodes) {
      const prog = Math.min(1, Math.max(0, t * 5 - (p.order - 1)));
      if (prog <= 0) continue;
      const rr = ((R * p.order) / 5) * p.j * prog + R * 0.08;
      const x = cx + Math.cos(p.a) * rr * 1.55, y = cy + Math.sin(p.a) * rr * 0.82;
      const on = active.has(p.cat);
      o += `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="${STEEP[p.cat].c}" stroke-opacity="${on ? 0.1 : 0.02}"/>`;
      o += `<circle cx="${x}" cy="${y}" r="${p.sz * prog}" fill="${STEEP[p.cat].c}" fill-opacity="${on ? 0.85 : 0.12}"/>`;
    }
    const pulse = reduced ? 0 : 3 * Math.sin(performance.now() / 180);
    o += `<circle cx="${cx}" cy="${cy}" r="${13 + pulse}" fill="${AMBER}"/>`;
    o += `<circle cx="${cx}" cy="${cy}" r="20" fill="none" stroke="${AMBER}" stroke-opacity=".5"/>`;
    o += `<text x="${cx}" y="${cy + 38}" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="2" fill="${INK}" text-anchor="middle">SEED</text>`;
    svg.innerHTML = o;
  }

  if (reduced) {
    draw();
  } else {
    (function frame() {
      if (!svg.isConnected) return;
      t = Math.min(1, t + 0.006);
      draw();
      requestAnimationFrame(frame);
    })();
  }
})();
</script>
