---
/**
 * Futurescaper — flagship case-study network.
 *
 * INPUT (problem) → PROCESS (decision nodes) → VIEW (the real product,
 * live: extracted layout code + synthetic data) → OUT (outcome + next).
 *
 * The VIEW op hosts FuturescaperDemo (React island, client:only) — the
 * product's REAL radial layout algorithm (layout.js, extraction allowed:
 * Futurescaper is public per Futurity ruling) rendered with @xyflow/react,
 * on a hand-authored synthetic ocean-plastics futurescape. Interior uses
 * the product language per futurescaper/CLAUDE-DESIGN-SYSTEM.md: paper
 * #F4F1EA, amber #E8A317 (dark ink on amber), Wong STEEPLE palette.
 * Prose comes from src/data/content.js — fact-checked, don't embellish.
 * Ownership numbers (35/100/100/100) are honest and verified.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import PatchField from '../../components/PatchField.astro';
import FuturescaperDemo from '../../components/react/demos/futurescaper/FuturescaperDemo.jsx';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'futurescaper');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects' },
      { name: 'Futurescaper' },
    ]),
  ],
};

const links: [string, string][] = [
  ['fsTitle', 'fsWhat'],
  ['fsTitle', 'fsCraft'],
  ['fsWhat', 'fsOwn'],
  ['fsOwn', 'fsRole'],
  ['fsCraft', 'fsD1'],
  ['fsD1', 'fsD2'],
  ['fsD2', 'fsD3'],
  ['fsD2', 'fsView'],
  ['fsRole', 'fsView'],
  ['fsView', 'fsOut'],
];
---

<Base
  title="Futurescaper — A Map Room for Possible Futures | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="fsNet" links={links} density={0.3} height="1780px" label="Futurescaper case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="fsTitle" name="input · the_problem" type="txt" pos="left:4%; top:44px; width:min(400px,88vw);" ports="out">
      <p class="fs-meta">{project.meta}</p>
      <h1 class="fs-h">A map room for <span class="amb">possible futures</span></h1>
      <p class="fs-sub">// FORESIGHT DATA DEFEATS GENERIC GRAPH TOOLS. FORCE LAYOUTS COLLAPSE INTO HAIRBALLS EXACTLY WHEN THE PICTURE MATTERS. THIS ONE DOESN'T.</p>
    </Operator>

    <Operator id="fsWhat" name="txt · what_it_is" type="txt" pos="left:38%; top:60px; width:min(300px,86vw);">
      {cs['What it is'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <!-- OWNERSHIP (honest numbers, verified) -->
    <Operator id="fsOwn" name="ownership_data" type="data" pos="right:4%; top:44px; width:min(260px,86vw);">
      <div class="fs-meter">
        <span>CONCEPT</span><div class="bar"><i style="width:35%"></i></div>
        <span>DESIGN</span><div class="bar"><i style="width:100%"></i></div>
        <span>FRONTEND</span><div class="bar"><i style="width:100%"></i></div>
        <span>BACKEND</span><div class="bar"><i style="width:100%"></i></div>
        <span class="fs-meternote">SOLO REBUILD FROM A COLLEAGUE'S POC — UI, LAYOUT SYSTEM, AND A REAL BACKEND, FROM ZERO.</span>
      </div>
    </Operator>

    <Operator id="fsRole" name="txt · my_role" type="txt" pos="right:4%; top:390px; width:min(340px,86vw);">
      {cs['My role'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <!-- PROCESS: decisions -->
    <Operator id="fsCraft" name="process · craft_notes" type="txt" pos="left:4%; top:390px; width:min(340px,86vw);">
      {cs['Craft notes'].map((p) => <p class="fs-p">{p}</p>)}
    </Operator>

    <Operator id="fsD1" name="decision_01 · spatial_memory" type="txt" pos="left:4%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">When new AI-generated scenarios arrive, existing nodes barely move. Users keep their mental map; stability beats elegance.</p>
    </Operator>

    <Operator id="fsD2" name="decision_02 · provenance" type="txt" pos="left:36%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">Machine-generated content renders visually distinct until a human promotes it. Trust needs a visible seam.</p>
    </Operator>

    <Operator id="fsD3" name="decision_03 · off_thread" type="txt" pos="right:4%; top:760px; width:min(270px,86vw);">
      <p class="fs-p">Layouts recompute off the main thread. Interaction latency stays imperceptible even as the scenario space grows.</p>
    </Operator>

    <!-- VIEW: the real product, live — real layout code, synthetic data -->
    <Operator id="fsView" name="futurescaper_view · OCEAN.scn" type="view" pos="left:50%; top:1000px; transform:translateX(-50%); width:min(880px,94vw);">
      <div class="fs-viewerwrap">
        <FuturescaperDemo client:only="react">
          <div class="fs-poster" slot="fallback" aria-hidden="true">COOKING VIEWER — REAL LAYOUT CODE, SYNTHETIC DATA…</div>
        </FuturescaperDemo>
      </div>
    </Operator>

    <!-- OUT -->
    <Operator id="fsOut" name="out · next_network" type="data" pos="right:5%; bottom:36px; width:min(250px,86vw);" ports="in">
      <p class="fs-out">
        THE LAYOUT IS THE ARGUMENT.<br /><br />
        <a href="/projects/futurity-engine">NEXT ▸ futurity_engine</a><br />
        <span class="fs-outsub">watch the machine think</span>
      </p>
    </Operator>
  </PatchField>
</Base>

<style>
  .fs-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .fs-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .fs-h .amb { color: var(--amber); }
  .fs-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 42ch;
  }

  .fs-p { font-size: 12.5px; color: var(--text-muted); line-height: 1.65; margin-bottom: 8px; }
  .fs-p:last-child { margin-bottom: 0; }

  .fs-meter { font-family: var(--font-mono); font-size: 9.5px; color: var(--text-muted); }
  .fs-meter .bar {
    height: 6px;
    background: var(--bg-surface);
    border: 1px solid #26262a;
    margin: 4px 0 8px;
    position: relative;
  }
  .fs-meter .bar i {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--signal) 0 4px, transparent 4px 6px);
  }
  .fs-meternote { color: var(--text-dim); display: block; margin-top: 4px; line-height: 1.6; }

  .fs-viewerwrap { margin: -12px -14px; }
  .fs-poster {
    display: grid;
    place-items: center;
    height: 586px;
    background: var(--paper);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .fs-out { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); line-height: 1.7; }
  .fs-out a { color: var(--signal); text-decoration: none; }
  .fs-out a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .fs-outsub { color: var(--text-dim); }
</style>
