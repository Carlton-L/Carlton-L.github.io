---
/**
 * Futurescaper — flagship case-study network.
 *
 * INPUT (problem) → VIEW (hero: the product's self-generating landing map,
 * opens the story) → PROCESS (what/ownership/role/decisions) → VIEW (the real
 * product, live: interactive AGENTS.scn map) → OUT (outcome + next).
 *
 * Two VIEW ops. fsHero hosts HeroMap (React island, client:only) — the
 * product's landing hero ported nearly verbatim (framer-motion, scripted
 * synthetic scenarios): a consequence map that draws itself on loop.
 *
 * The main VIEW op hosts FuturescaperDemo (React island, client:only) — the
 * product's REAL radial layout algorithm (layout.js, extraction allowed:
 * Futurescaper is public per Futurity ruling) rendered with @xyflow/react,
 * on a hand-authored synthetic "AI agents in knowledge work" futurescape,
 * in the product's own interactive-map visual language (metro cards, dark
 * radial seed, octilinear edges, STEEPLE coverage radar; lifted from
 * futurescaper/demos/interactive-map/preview.html). Paper #F4F1EA, amber
 * #E8A317 (dark ink on amber), Wong STEEPLE palette.
 * Prose comes from src/data/content.js — fact-checked, don't embellish.
 * Ownership numbers (35/100/100/100) are honest and verified.
 */
import Base from '../../layouts/Base.astro';
import Operator from '../../components/Operator.astro';
import DecisionCard from '../../components/case/DecisionCard.astro';
import NextCase from '../../components/case/NextCase.astro';
import OwnershipMeter from '../../components/case/OwnershipMeter.astro';
import ViewSlot from '../../components/ViewSlot.astro';
import PatchField from '../../components/PatchField.astro';
import FuturescaperDemo from '../../components/react/demos/futurescaper/FuturescaperDemo.jsx';
import HeroMap from '../../components/react/demos/futurescaper/HeroMap.jsx';
import { projects } from '../../data/content.js';
import { getCreativeWorkJsonLd, getBreadcrumbJsonLd } from '../../lib/seo.js';

const project = projects.find((p) => p.slug === 'futurescaper');
const cs = Object.fromEntries(project.caseStudy.map((s) => [s.heading, s.body]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    getCreativeWorkJsonLd(project),
    getBreadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: 'Projects', url: '/projects/' },
      { name: 'Futurescaper' },
    ]),
  ],
};

const links: [string, string][] = [
  ['fsTitle', 'fsHero'],
  ['fsHero', 'fsSect'],
  ['fsSect', 'fsWhat'],
  ['fsSect', 'fsBefore'],
  ['fsWhat', 'fsOwn'],
  ['fsWhat', 'fsRole'],
  ['fsRole', 'fsCraft'],
  ['fsCraft', 'fsD1'],
  ['fsD1', 'fsD2'],
  ['fsD2', 'fsD3'],
  ['fsD3', 'fsLayout'],
  ['fsLayout', 'fsView'],
  ['fsView', 'fsOutcome'],
  ['fsOutcome', 'fsOut'],
];

// Flex layout: the page is a column of rows. Words: flexLayout in src/lib/patch-field.js.
// 'area:w' is a card w twelfths wide. inset is side padding in columns. gap and mt are grid units (26px).
const layout = {
  mode: 'flex',
  padTop: 48,
  gap: 2,
  rows: [
    { row: ['title:5', 'own:3'], justify: 'between' },
    { row: ['hero:10'], justify: 'center' },
    { row: ['sect:6', 'bfr:4'], justify: 'center', gap: 8 },
    { row: ['what:4', 'role:4'], justify: 'center', gap: 8 },
    { row: ['craft:4'], justify: 'center' },
    { row: ['d1:3', { op: 'd2', w: 3, mt: 1.5 }, { op: 'd3', w: 3, mt: 3 }], justify: 'between', inset: 1 },
    { row: ['lay:6'], justify: 'center' },
    { row: ['view:10'], justify: 'center' },
    { row: ['outc:5', 'out:4'], justify: 'between' },
  ],
};
---

<Base
  title="Futurescaper — A Metro Map for Possible Futures | Carlton Lindsay"
  description={project.description}
  jsonLd={jsonLd}
>
  <PatchField id="fsNet" links={links} height="3800px" layout={layout} label="Futurescaper case-study network — press P for reading mode">
    <!-- INPUT -->
    <Operator id="fsTitle" name="input · the_problem" type="txt" area="title" ports="out">
      <p class="fs-meta">{project.meta}</p>
      <h1 class="fs-h">A metro map for <span class="amb">possible futures</span></h1>
      <p class="fs-sub">{"// FORESIGHT DATA DEFEATS GENERIC GRAPH TOOLS. FORCE LAYOUTS COLLAPSE INTO HAIRBALLS EXACTLY WHEN THE PICTURE MATTERS. THIS ONE DOESN'T."}</p>
      <a class="fs-live" href={project.liveUrl} target="_blank" rel="noopener">▸ LIVE · futurescape.futurity.science ↗</a>
    </Operator>

    <!-- OWNERSHIP (honest numbers, verified) — sits with the title up top -->
    <OwnershipMeter id="fsOwn" rows={[['CONCEPT', 35], ['DESIGN', 100], ['FRONTEND', 100], ['BACKEND', 100]]} note="SOLO REBUILD FROM A COLLEAGUE'S POC: UI, LAYOUT SYSTEM, AND A REAL BACKEND, FROM ZERO." />

    <!-- VIEW (opener): the product's landing hero — a map generating itself -->
    <Operator id="fsHero" name="futurescaper_view · live_map" type="view" area="hero" maxw={900}>
      <div class="fs-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · SELF-GENERATING MAP…" bg="var(--paper)" ink="var(--ink-muted)">
          <HeroMap client:settled />
        </ViewSlot>
      </div>
    </Operator>

    <Operator id="fsSect" name="process · the_build" type="txt" area="sect">
      <p class="fs-meta">PROCESS · WHAT IT IS / MY ROLE / THREE DECISIONS</p>
      <h2 class="fs-h2">From <span class="amb">hairball</span> to metro map</h2>
      <p class="fs-sub">What it is, where I fit, and the three decisions that shaped the build. Then the product itself, running live below.</p>
    </Operator>

    <!-- reserved slot: screenshot of the original POC, once it's dug up -->
    <Operator id="fsBefore" name="before · original_poc" type="view" area="bfr" maxw={360} ports="in">
      <figure class="fs-photoslot has-img">
        <!-- a lens follows the mouse, and a click or tap expands the picture to fill the window -->
        <button type="button" class="fs-shot" id="fsShot" data-noverb data-full="/images/projects/futurescaper/before-poc.webp" aria-label="Expand the screenshot">
          <img
            src="/images/projects/futurescaper/before-poc.webp"
            width="1600" height="806"
            alt="The original Futurescaper proof of concept. A sidebar with a summary and filters sits beside a canvas of about 85 small red and green consequence cards, scattered around one central event and joined to it by straight lines."
            loading="lazy"
          />
          <span class="fs-lens" aria-hidden="true"></span>
        </button>
        <figcaption class="fs-photosub"><span>THE ORIGINAL PROOF OF CONCEPT</span><i class="cap-fine">HOVER · CLICK</i><i class="cap-coarse">TAP TO EXPAND</i></figcaption>
      </figure>
      <script is:inline data-astro-rerun>
        (function () {
          var btn = document.getElementById('fsShot');
          if (!btn) return;
          var img = btn.querySelector('img'), lens = btn.querySelector('.fs-lens'), SRC = btn.dataset.full;
          var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var RATIO = 1600 / 806, ZOOM = 4, R = 75, close = null;

          // expand: the picture flies from its card to the middle of the window
          btn.addEventListener('click', function () {
            if (close) return;
            lens.classList.remove('on');
            var r = img.getBoundingClientRect();
            var veil = document.createElement('div'), fly = document.createElement('img'), hint = document.createElement('div');
            veil.className = 'fs-veil'; fly.className = 'fs-fly'; hint.className = 'fs-flyhint';
            fly.src = SRC; fly.alt = ''; hint.textContent = 'ESC OR CLICK TO CLOSE';
            var W = Math.min(window.innerWidth - 32, 1600, (window.innerHeight - 96) * RATIO), H = W / RATIO;
            fly.style.width = W + 'px'; fly.style.height = H + 'px';
            fly.style.transform = 'translate(' + r.left + 'px,' + r.top + 'px) scale(' + r.width / W + ')';
            document.body.append(veil, fly, hint);
            img.style.visibility = 'hidden';
            void fly.offsetWidth;
            veil.classList.add('on');
            fly.style.transform = 'translate(' + (window.innerWidth - W) / 2 + 'px,' + (window.innerHeight - H) / 2 + 'px) scale(1)';
            function key(e) { if (e.key === 'Escape') close(); }
            close = function (now) {
              if (!close) return;
              close = null;
              window.removeEventListener('keydown', key); window.removeEventListener('scroll', shut); window.removeEventListener('resize', shut);
              document.removeEventListener('astro:before-swap', cut);
              hint.remove(); veil.classList.remove('on');
              function done() { fly.remove(); veil.remove(); img.style.visibility = ''; }
              if (now === true || REDUCED || !img.isConnected) { done(); return; }
              var b = img.getBoundingClientRect();
              fly.style.transform = 'translate(' + b.left + 'px,' + b.top + 'px) scale(' + b.width / W + ')';
              setTimeout(done, 340);
              btn.focus({ preventScroll: true });
            };
            function shut() { if (close) close(); }
            function cut() { if (close) close(true); } // a page change: no animation
            veil.addEventListener('click', shut); fly.addEventListener('click', shut);
            window.addEventListener('keydown', key); window.addEventListener('scroll', shut, { passive: true }); window.addEventListener('resize', shut);
            document.addEventListener('astro:before-swap', cut);
          });

          // lens: four times the size, centred on the pointer. Mouse and pen only.
          lens.style.backgroundImage = 'url(' + SRC + ')';
          btn.addEventListener('pointermove', function (e) {
            if (e.pointerType === 'touch' || close) return;
            var r = img.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
            if (x < 0 || y < 0 || x > r.width || y > r.height) { lens.classList.remove('on'); return; }
            lens.style.left = x - R + 'px'; lens.style.top = y - R + 'px';
            lens.style.backgroundSize = r.width * ZOOM + 'px ' + r.height * ZOOM + 'px';
            lens.style.backgroundPosition = (R - x * ZOOM) + 'px ' + (R - y * ZOOM) + 'px';
            lens.classList.add('on');
          });
          btn.addEventListener('pointerleave', function () { lens.classList.remove('on'); });
        })();
      </script>
    </Operator>

    <Operator id="fsWhat" name="txt · what_it_is" type="txt" area="what">
      {cs['What it is'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>


    <Operator id="fsRole" name="txt · my_role" type="txt" area="role">
      {cs['My role'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <Operator id="fsCraft" name="process · craft_notes" type="txt" area="craft">
      {cs['Craft notes'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <!-- PROCESS: the three design-engineering decisions -->
    <DecisionCard id="fsD1" area="d1" num={1} slug="spatial_memory" title="Spatial memory">
      <p class="cs-p">When new AI-generated scenarios arrive, existing nodes barely move. Users keep their mental map; stability beats elegance.</p>
    </DecisionCard>

    <DecisionCard id="fsD2" area="d2" num={2} slug="provenance" title="Visible provenance">
      <p class="cs-p">Machine-generated content renders visually distinct until a human promotes it. Trust needs a visible seam.</p>
    </DecisionCard>

    <DecisionCard id="fsD3" area="d3" num={3} slug="off_thread" title="Off the main thread">
      <p class="cs-p">Layouts recompute off the main thread. Interaction latency stays imperceptible even as the scenario space grows.</p>
    </DecisionCard>

    <!-- PROCESS: the core argument, set up right before the live demo -->
    <Operator id="fsLayout" name="process · the_layout_problem" type="txt" area="lay" maxw={600}>
      {cs['The layout problem'].map((p) => <p class="cs-p">{p}</p>)}
    </Operator>

    <!-- VIEW: the real product, live — real layout code, synthetic data -->
    <Operator id="fsView" name="futurescaper_view · AGENTS.scn" type="view" area="view" maxw={900}>
      <div class="fs-viewerwrap">
        <ViewSlot poster="COOKING VIEWER · REAL LAYOUT CODE, SYNTHETIC DATA…" bg="var(--paper)" ink="var(--ink-muted)">
          <FuturescaperDemo client:settled={{ rootMargin: '600px' }} />
        </ViewSlot>
      </div>
    </Operator>

    <!-- OUT -->
    <Operator id="fsOutcome" name="out · outcome" type="txt" area="outc" ports="in">
      {cs['Outcome'].map((p) => <p class="cs-p">{p}</p>)}
      <a class="fs-live" href={project.liveUrl} target="_blank" rel="noopener">▸ VISIT LIVE · futurescape.futurity.science ↗</a>
    </Operator>

    <NextCase id="fsOut" from="futurescaper" tagline="THE LAYOUT IS THE ARGUMENT." />
  </PatchField>
</Base>

<style>
  .fs-meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .fs-h {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(24px, 2.8vw, 38px);
    line-height: 0.98;
    max-width: 14ch;
  }
  .fs-h .amb { color: var(--signal); }
  .fs-sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    margin-top: 10px;
    line-height: 1.7;
    max-width: 42ch;
  }

  .fs-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 0.98;
    margin-bottom: 8px;
  }
  .fs-h2 .amb { color: var(--signal); }



  .fs-live {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--signal);
    text-decoration: none;
    border: 1px solid var(--border-color);
    padding: 5px 10px;
    border-radius: 4px;
    transition: border-color var(--duration-normal), background var(--duration-normal);
  }
  .fs-live:hover { border-color: var(--signal); background: rgba(61, 255, 136, 0.06); }


  .fs-photoslot {
    aspect-ratio: 4 / 3;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    padding: 10px;
  }
  .fs-photoslot .fs-photosub { font-size: 8.5px; color: var(--text-dim); opacity: 0.7; }
  .fs-photoslot.has-img { aspect-ratio: auto; display: block; margin: 0; padding: 0; border: 1px solid var(--border-color); }
  .fs-photoslot.has-img img { display: block; width: 100%; height: auto; border-radius: 3px 3px 0 0; }
  .fs-photoslot.has-img .fs-photosub { display: flex; justify-content: space-between; gap: 10px; padding: 6px 8px; text-align: left; opacity: 1; }
  .fs-photosub i { font-style: normal; color: var(--signal); white-space: nowrap; }
  .fs-photosub .cap-coarse { display: none; }
  @media (hover: none) and (pointer: coarse) { .fs-photosub .cap-fine { display: none; } .fs-photosub .cap-coarse { display: inline; } }
  .fs-shot { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .fs-shot:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .fs-shot { cursor: none; } }
  /* the lens: a round window onto the same picture, four times the size */
  .fs-lens {
    position: absolute; width: 150px; height: 150px; border-radius: 50%; z-index: 5; pointer-events: none;
    border: 1px solid var(--signal); box-shadow: 0 10px 34px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(10, 10, 11, 0.9);
    background-repeat: no-repeat; background-color: #fff;
    opacity: 0; transform: scale(0.6); transition: opacity 0.14s, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fs-lens:global(.on) { opacity: 1; transform: scale(1); }
  /* the expanded picture and the dim behind it are made by the script, so they are global */
  :global(.fs-veil) { position: fixed; inset: 0; z-index: 1000; background: rgba(5, 5, 6, 0.86); opacity: 0; transition: opacity 0.28s ease; cursor: zoom-out; }
  :global(.fs-veil.on) { opacity: 1; }
  :global(.fs-fly) {
    position: fixed; z-index: 1001; left: 0; top: 0; max-width: none; transform-origin: 0 0; cursor: zoom-out;
    border: 1px solid #2a2a2e; border-radius: 4px; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7);
    transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1); will-change: transform;
  }
  :global(.fs-flyhint) {
    position: fixed; z-index: 1002; left: 50%; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--text-muted);
    background: rgba(10, 10, 11, 0.85); border: 1px solid #2a2a2e; border-radius: 3px; padding: 5px 9px; pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .fs-lens, :global(.fs-veil), :global(.fs-fly) { transition: none; } }

  .fs-viewerwrap { margin: -12px -14px; }

</style>
