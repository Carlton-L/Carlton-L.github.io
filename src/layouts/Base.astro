---
/**
 * Base Layout
 *
 * Wraps every page with <html>, <head> (SEO, fonts, OG), nav, footer.
 * Props control per-page metadata. View Transitions enabled for smooth
 * page-to-page animation without JS.
 */
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { patchSrc, clockJs } from '../lib/bundles.js';
import '../styles/fonts.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  /** false on pages with no PatchField, so the network script is not preloaded for nothing */
  patch?: boolean;
}

const {
  title,
  description,
  ogImage = '/images/og-default.png',
  canonicalUrl,
  jsonLd,
  patch = true,
} = Astro.props;

const siteUrl = 'https://carlton.dev';
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Palette accent: apply the visitor's chosen bg palette to the UI accent
         (--signal) before first paint, so the whole site re-themes with the
         bg_generator's OUT palette and there's no green→other flash. -->
    <script is:inline>
      (function () {
        var PAL = [
          ['#3dff88', 'rgba(61,255,136,0.28)'],
          ['#e8a317', 'rgba(232,163,23,0.30)'],
          ['#56b4e9', 'rgba(86,180,233,0.30)'],
          ['#9f9f98', 'rgba(159,159,152,0.30)'],
        ];
        function applyPal() {
          var i = 0;
          try { var s = JSON.parse(localStorage.getItem('patch-bg') || '{}'); if (s && typeof s.pal === 'number') i = ((s.pal % 4) + 4) % 4; } catch (e) {}
          var p = PAL[i], r = document.documentElement.style;
          r.setProperty('--signal', p[0]);
          r.setProperty('--signal-dim', p[1]);
          r.setProperty('--border-hover', p[0] + '66');
        }
        applyPal();
        document.addEventListener('astro:after-swap', applyPal);
      })();
    </script>

    <!-- Page-change clock (src/lib/page-clock.js): remembers the last click, opens the wipe as a
         ring from it, and drives the wipe, the dim and the dither front on one clock. -->
    <script is:inline set:html={clockJs}></script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Carlton Lindsay" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Fonts are all self-hosted (src/styles/fonts.css, public/fonts/): Red Hat Display for
         display and sans, Sometype Mono for mono, Inter as the fallback, and IBM Plex Mono and
         JetBrains Mono for the DomainClaim and Futurescaper interiors. The two faces on every first screen are preloaded. -->
    <link rel="preload" href="/fonts/red-hat-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sometype-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {patch && <link rel="preload" href={patchSrc} as="script" />}
    <!-- Favicon (patch mark) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- View Transitions (browser-native page animations) -->
    <ClientRouter />
    <script>
      import '../lib/scroll-hold.js';
      // Fetch the next page and its stylesheets before the click.
      import '../lib/warm.js';
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Navigation />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
