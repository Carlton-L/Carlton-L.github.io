---
/**
 * Base Layout
 *
 * Wraps every page with <html>, <head> (SEO, fonts, OG), nav, footer.
 * Props control per-page metadata. View Transitions enabled for smooth
 * page-to-page animation without JS.
 */
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
}

const {
  title,
  description,
  ogImage = '/images/og-default.png',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://carlton.dev';
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Palette accent: apply the visitor's chosen bg palette to the UI accent
         (--signal) before first paint, so the whole site re-themes with the
         bg_generator's OUT palette and there's no green→other flash. -->
    <script is:inline>
      (function () {
        var PAL = [
          ['#3dff88', 'rgba(61,255,136,0.28)'],
          ['#e8a317', 'rgba(232,163,23,0.30)'],
          ['#56b4e9', 'rgba(86,180,233,0.30)'],
          ['#9f9f98', 'rgba(159,159,152,0.30)'],
        ];
        function applyPal() {
          var i = 0;
          try { var s = JSON.parse(localStorage.getItem('patch-bg') || '{}'); if (s && typeof s.pal === 'number') i = ((s.pal % 4) + 4) % 4; } catch (e) {}
          var p = PAL[i], r = document.documentElement.style;
          r.setProperty('--signal', p[0]);
          r.setProperty('--signal-dim', p[1]);
          r.setProperty('--border-hover', p[0] + '66');
        }
        applyPal();
        document.addEventListener('astro:after-swap', applyPal);
      })();
    </script>

    <!-- Page-change front: remember where the last click was. A navigation that follows a click
         starts its front there: the wipe opens as a ring from that point (global.css) and the
         dither front and operator handoff follow it (PatchField reads window.__pfNav). Keyboard,
         back and forward have no click, so they keep the top-to-bottom band. Root attributes and
         inline styles are replaced on swap, so they are set again after it. -->
    <script is:inline>
      (function () {
        var click = null, up = -1e4;
        /* A click counts as a pointer click only if a pointer was released just before it.
           detail === 0 marks a keyboard click in Chrome and Safari but not in Firefox. */
        document.addEventListener('pointerup', function () { up = performance.now(); }, true);
        document.addEventListener('click', function (e) {
          var now = performance.now();
          click = e.detail === 0 || now - up > 400 ? null : { x: e.clientX, y: e.clientY, t: now };
        }, true);
        function apply() {
          var d = document.documentElement, n = window.__pfNav;
          if (n && n.ring) {
            d.setAttribute('data-pf', 'ring');
            d.style.setProperty('--pf-cx', n.ring.x + 'px');
            d.style.setProperty('--pf-cy', n.ring.y + 'px');
            d.style.setProperty('--pf-max', n.ring.max + 'px');
          } else d.removeAttribute('data-pf');
        }
        document.addEventListener('astro:before-preparation', function (e) {
          var c = click, w = window.innerWidth, h = window.innerHeight;
          click = null;
          cancelAnimationFrame(raf);
          window.__pfNav = { ring: null, f: 0, started: false };
          if (c && e.navigationType !== 'traverse' && performance.now() - c.t < 1000) {
            var far = Math.max(Math.hypot(c.x, c.y), Math.hypot(w - c.x, c.y), Math.hypot(c.x, h - c.y), Math.hypot(w - c.x, h - c.y));
            window.__pfNav.ring = { x: c.x, y: c.y, max: Math.round(far + 160) };
          }
          apply();
        });
        /* One clock for the whole page change. The wipe and the dim are CSS animations that stay
           paused (global.css); this loop moves them by hand, and PatchField reads the same
           progress (__pfNav.f) for the dither front. A late frame only advances the clock by two
           frames' worth, so a busy browser plays the start slowly instead of skipping it, and the
           three parts can never drift apart. It starts once the new page's scripts have run. */
        var MS = 580, goT = 0, raf = 0;
        function go() {
          clearTimeout(goT); cancelAnimationFrame(raf);
          var nav = window.__pfNav || (window.__pfNav = { ring: null });
          if (nav.started) return;
          nav.started = true; nav.f = 0;
          // looked up every frame: the page images may not exist yet on the first one
          var find = function () {
            return (document.getAnimations ? document.getAnimations() : []).filter(function (a) {
              return /^pf-(ring|wipe|dim)$/.test(a.animationName || '');
            });
          };
          var finish = function () { find().forEach(function (a) { try { a.finish(); } catch (e) {} }); };
          var last = performance.now(), el = 0;
          document.dispatchEvent(new Event('pf:go'));
          (function tick() {
            var now = performance.now();
            el += Math.min(34, now - last); last = now;
            nav.f = Math.min(1, el / MS);
            if (nav.f < 1) {
              find().forEach(function (a) { try { a.currentTime = nav.f * MS; } catch (e) {} });
              raf = requestAnimationFrame(tick);
            } else {
              finish();
              setTimeout(finish, 250); // and again, in case a page image turned up late
            }
          })();
        }
        document.addEventListener('astro:after-swap', function () {
          apply();
          clearTimeout(goT);
          goT = setTimeout(go, 700); // never leave the page waiting
        });
        document.addEventListener('astro:page-load', function () { requestAnimationFrame(go); });
      })();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Carlton Lindsay" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Fonts are all self-hosted (src/styles/fonts.css, public/fonts/): Red Hat Display for
         display and sans, Sometype Mono for mono, Inter as the fallback, and IBM Plex Mono and
         JetBrains Mono for the DomainClaim and Futurescaper interiors. The two faces on every first screen are preloaded. -->
    <link rel="preload" href="/fonts/red-hat-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sometype-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Favicon (patch mark) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- View Transitions (browser-native page animations) -->
    <ClientRouter />
    <script>
      import '../lib/scroll-hold.js';
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Navigation />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
