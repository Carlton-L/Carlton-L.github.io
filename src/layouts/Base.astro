---
/**
 * Base Layout
 *
 * Wraps every page with <html>, <head> (SEO, fonts, OG), nav, footer.
 * Props control per-page metadata. View Transitions enabled for smooth
 * page-to-page animation without JS.
 */
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
}

const {
  title,
  description,
  ogImage = '/images/og-default.png',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://carlton.dev';
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Palette accent: apply the visitor's chosen bg palette to the UI accent
         (--signal) before first paint, so the whole site re-themes with the
         bg_generator's OUT palette and there's no green→other flash. -->
    <script is:inline>
      (function () {
        var PAL = [
          ['#3dff88', 'rgba(61,255,136,0.28)'],
          ['#e8a317', 'rgba(232,163,23,0.30)'],
          ['#56b4e9', 'rgba(86,180,233,0.30)'],
          ['#9f9f98', 'rgba(159,159,152,0.30)'],
        ];
        function applyPal() {
          var i = 0;
          try { var s = JSON.parse(localStorage.getItem('patch-bg') || '{}'); if (s && typeof s.pal === 'number') i = ((s.pal % 4) + 4) % 4; } catch (e) {}
          var p = PAL[i], r = document.documentElement.style;
          r.setProperty('--signal', p[0]);
          r.setProperty('--signal-dim', p[1]);
          r.setProperty('--border-hover', p[0] + '66');
        }
        applyPal();
        document.addEventListener('astro:after-swap', applyPal);
      })();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Carlton Lindsay" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Fonts. Gotham (display) is self-hosted — see global.css.
         Mono trial: Courier Prime (ACTIVE) + IBM Plex Mono + Fira Code;
         prune once a winner is picked. JetBrains Mono @400 kept for
         Futurescaper viewer interiors. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Fira+Code:wght@300..700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/fonts/gothamblack-webfont.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon (patch mark) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- View Transitions (browser-native page animations) -->
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    <Navigation />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
